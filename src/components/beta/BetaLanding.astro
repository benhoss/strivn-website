---
/**
 * The generated website (plan 2026-11-01-001): a fixed hero, the assistant's
 * question, then a page composed for this visitor, turn by turn.
 *
 * Nothing here is a new component. The shell is SubLanding's (header,
 * SubHero, footer); the question area uses the `st-*` primitives; every
 * composed band arrives as HTML rendered on the server by SubSections, an
 * existing page band or SubClosing (/beta/turn). Those components are imported
 * below so their styles are bundled with this page before any band arrives.
 *
 * Not indexed: live answers are one visitor's page. The indexable layer is the
 * existing pages and, once approved, the answer pages (/questions/).
 */
import { NAV } from '../../data/nav';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SubHero from '../sub/SubHero.astro';
import SubSections from '../sub/SubSections.astro';
import SubClosing from '../sub/SubClosing.astro';
import HomeFooter from '../home/HomeFooter.astro';
import { homeContent } from '../../data/homeContent';
import { betaContent, type BetaLocale } from '../../data/betaContent';
import { BANDS } from '../../lib/compose/bands';
import { SKIP_LABEL } from '../../lib/skipLabel';
import { appStartUrl } from '../../lib/appUrl';

interface Props {
  locale: BetaLocale;
}

const { locale } = Astro.props;
const c = betaContent[locale];
const shared = homeContent[locale];
const path = (l: BetaLocale) => `/${l}/beta/`;

// Every band the composer may place, so their styles ship with the page.
const bandComponents = Object.values(BANDS).map((b) => b.component);

const client = {
  locale,
  live: c.live,
  personaNames: c.personaNames,
  signupUrl: appStartUrl(locale),
};
---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={`/${locale}/`}
  robots="noindex, follow"
>
  <a href="#s-main" class="s-skip">{SKIP_LABEL[locale]}</a>

  <SiteHeader locale={locale} links={NAV[locale].links} cta={NAV[locale].cta} switchHrefs={{ fr: path('fr'), en: path('en') }} />

  <main id="s-main" class="bg-void font-sans text-ink antialiased" data-beta={JSON.stringify(client)}>
    <SubHero locale={locale} hero={c.hero} crumbs={{ label: c.crumbs.label, href: `/${locale}/`, page: c.crumbs.page }} />

    <section class="st-sec beta-ask" aria-labelledby="beta-q" data-beta-intro>
      <div class="st-wrap">
        <p class="st-label st-eyebrow">STRIVN</p>
        <h2 id="beta-q" class="st-h2">{c.ask.question}</h2>
        <div class="beta-dock-home" data-dock-home>
          <div class="beta-dock" data-dock>
            <div class="beta-dock__meta">
              <div class="beta-chips" data-followups></div>
              <p class="st-tag beta-profile" data-profile hidden></p>
            </div>
            <form class="st-panel beta-form" data-form autocomplete="off">
              <label class="beta-sr" for="beta-input">{c.ask.label}</label>
              <input id="beta-input" name="message" maxlength="600" placeholder={c.ask.placeholder} data-input />
              <button class="st-btn st-btn--primary" type="submit" data-send>{c.ask.send}</button>
            </form>
            <p class="st-fine beta-note">{c.ask.note}</p>
          </div>
        </div>
        <p class="st-label beta-label">{c.ask.personas}</p>
        <div class="beta-chips">
          {c.personas.map((s) => <button type="button" class="st-btn st-btn--ghost st-btn--sm" data-prompt={s.prompt}>{s.label}</button>)}
        </div>
        <p class="st-label beta-label">{c.ask.topics}</p>
        <div class="beta-chips">
          {c.topics.map((s) => <button type="button" class="st-btn st-btn--ghost st-btn--sm" data-prompt={s.prompt}>{s.label}</button>)}
        </div>
      </div>
    </section>

    <div class="beta-page" data-page aria-live="polite"></div>

    <section class="st-sec" data-fallback hidden aria-labelledby="beta-fallback">
      <div class="st-wrap">
        <h2 id="beta-fallback" class="st-h2">{c.fallback.title}</h2>
        <p class="st-lede">{c.fallback.body}</p>
        <div class="beta-chips">
          {c.fallback.links.map((l) => <a class="st-btn st-btn--ghost st-btn--sm" href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </section>

    {/* Never rendered: keeps these components' styles in this page's bundle. */}
    {false && <SubSections sections={[]} locale={locale} />}
    {false && <SubClosing locale={locale} />}
    {false && bandComponents.map((Band) => <Band />)}
  </main>

  <HomeFooter locale={locale} footer={shared.footer} />
</BaseLayout>

<style>
  .beta-ask :global(.st-h2) { margin-bottom: 28px; }
  .beta-label { display: block; margin: 28px 0 12px; }
  .beta-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .beta-form { display: flex; gap: 8px; padding: 6px; align-items: center; }
  .beta-form:focus-within { border-color: var(--color-electric); }
  .beta-form input {
    flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
    padding: 10px 12px; font: inherit; font-size: 16px; color: var(--color-ink);
  }
  .beta-form input::placeholder { color: var(--color-ink-3); }
  .beta-note { margin-top: 10px; }
  .beta-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .beta-dock__meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .beta-dock__meta:empty, [data-dock-home] .beta-dock__meta { display: none; }
  .beta-profile { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .beta-page { padding-bottom: 200px; }

  /* Once the page composes, the question docks to the bottom of the screen. */
  :global(body.is-composing) [data-beta-intro] { display: none; }
  :global(body.is-composing) .beta-dock {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px;
    padding: 14px var(--st-gutter) max(14px, env(safe-area-inset-bottom));
    background: linear-gradient(180deg, transparent, var(--color-void) 32%);
  }
  :global(body.is-composing) .beta-dock > * { width: 100%; max-width: calc(var(--st-max) - 2 * var(--st-gutter)); margin-inline: auto; }
  :global(body.is-composing) .beta-form { box-shadow: var(--shadow-float-lg); }
  .beta-dock__meta .beta-chips { min-width: 0; flex: 1 1 auto; }
  @media (max-width: 640px) {
    :global(body.is-composing) .beta-note { display: none; }
    :global(body.is-composing) .beta-dock__meta .beta-chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    :global(body.is-composing) .beta-dock__meta .st-btn { flex: none; }
  }

  /* The visitor's question above each composed band, in the stamp register. */
  .beta-page :global(.beta-turn__ask) { padding-top: 56px; margin-bottom: -40px; }
  .beta-page :global(.beta-status) { display: grid; gap: 4px; padding: 32px 0; }
  .beta-page :global(.beta-status span::before) { content: '› '; color: var(--color-electric-500); }
  .beta-page :global(.beta-ask-item) { padding-block: 40px; }
  .beta-page :global(.beta-ask-item .st-h3) { margin-bottom: 16px; }
  /* Built by the script below, so outside this component's scoped styles. */
  .beta-page :global(.beta-chips) { display: flex; flex-wrap: wrap; gap: 8px; }
  .beta-page :global(.beta-note) { margin-top: 12px; }
  .beta-page :global(.beta-turn__error) { padding-block: 32px; display: grid; gap: 16px; justify-items: start; }
  .beta-page :global(.beta-ask-item.is-answered) { opacity: 0.55; pointer-events: none; }
</style>

<script>
  type Copy = { locale: string; live: Record<string, string>; personaNames: Record<string, string>; signupUrl: string };

  const main = document.querySelector<HTMLElement>('[data-beta]')!;
  const copy = JSON.parse(main.dataset.beta!) as Copy;
  const page = document.querySelector<HTMLElement>('[data-page]')!;
  const dock = document.querySelector<HTMLElement>('[data-dock]')!;
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const input = document.querySelector<HTMLInputElement>('[data-input]')!;
  const sendButton = document.querySelector<HTMLButtonElement>('[data-send]')!;
  const followups = document.querySelector<HTMLElement>('[data-followups]')!;
  const profileTag = document.querySelector<HTMLElement>('[data-profile]')!;
  const fallback = document.querySelector<HTMLElement>('[data-fallback]')!;

  const STORAGE = 'strivn-beta-session';
  let token: string | null = null;
  let handoffUrl = copy.signupUrl;
  let profile: Record<string, string> = {};
  let busy = false;
  let turn = 0;

  const store = {
    get: () => { try { return localStorage.getItem(STORAGE); } catch { return null; } },
    set: (v: string) => { try { localStorage.setItem(STORAGE, v); } catch { /* private window */ } },
  };

  const el = (tag: string, cls = '', text = '') => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };

  // Bands injected after load miss SiteMotion's observer: give them the
  // in-view flag their loops pause on.
  const inview = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => entries.forEach((e) => e.target.classList.toggle('is-inview', e.isIntersecting)), { rootMargin: '0px 0px -10% 0px' })
    : null;
  const adopt = (root: Element) => root.querySelectorAll('[data-st-inview]').forEach((n) => inview?.observe(n));

  function renderProfile(): void {
    const parts: string[] = [];
    if (profile.persona) parts.push(copy.personaNames[profile.persona] ?? profile.persona);
    for (const key of ['sport', 'level', 'gps_vendor', 'squad_size', 'club']) if (profile[key]) parts.push(profile[key]);
    profileTag.hidden = parts.length === 0;
    profileTag.textContent = `${copy.live.profile} · ${parts.join(' · ')}`;
  }

  function chip(label: string, onClick: () => void): HTMLButtonElement {
    const b = el('button', 'st-btn st-btn--ghost st-btn--sm', label) as HTMLButtonElement;
    b.type = 'button';
    b.addEventListener('click', onClick);
    return b;
  }

  function renderFollowups(items: string[]): void {
    followups.replaceChildren(...items.slice(0, 4).map((s) => chip(s, () => ask(s))));
  }

  function startComposing(): void {
    document.body.classList.add('is-composing');
    document.body.append(dock);
  }

  function openTurn(prompt: string): HTMLElement {
    const wrap = el('article', 'beta-turn');
    const head = el('div', 'st-wrap beta-turn__ask');
    const stamp = el('p', 'st-label');
    stamp.append(el('span', 'st-label--accent', `${copy.live.you} · `), document.createTextNode(prompt));
    head.append(stamp);
    wrap.append(head);
    page.append(wrap);
    return wrap;
  }

  function appendHtml(target: HTMLElement, html: string): void {
    const tpl = document.createElement('template');
    tpl.innerHTML = html;
    const nodes = [...tpl.content.children];
    target.append(tpl.content);
    nodes.forEach(adopt);
  }

  function askBlock(target: HTMLElement, data: { question: string; options?: string[] }): void {
    const box = el('section', 'st-sec beta-ask-item');
    const wrap = el('div', 'st-wrap');
    wrap.append(el('h3', 'st-h3', data.question));
    const row = el('div', 'beta-chips');
    (data.options ?? []).forEach((o) => row.append(chip(o, () => { box.classList.add('is-answered'); ask(o); })));
    wrap.append(row, el('p', 'st-fine beta-note', copy.live.answerOr));
    box.append(wrap);
    target.append(box);
  }

  function showFallback(): void {
    fallback.hidden = false;
    document.querySelector<HTMLElement>('[data-beta-intro]')!.hidden = true;
    dock.hidden = true;
  }

  async function session(): Promise<boolean> {
    if (token) return true;
    const res = await fetch('/beta/session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ locale: copy.locale, token: store.get(), referrer: document.referrer || null, pageUrl: location.href }),
    }).catch(() => null);
    const data = res?.ok ? await res.json() : null;
    if (!data || data.available === false) {
      showFallback();
      return false;
    }
    token = data.token;
    handoffUrl = data.handoff_url ?? handoffUrl;
    profile = data.profile ?? {};
    if (!data.mock) store.set(data.token);
    renderProfile();
    if (data.page?.length && data.locale === copy.locale) {
      startComposing();
      for (const t of data.page) {
        const wrap = openTurn(t.prompt);
        t.html.forEach((h: string) => appendHtml(wrap, h));
      }
      turn = data.turns ?? data.page.length;
      renderFollowups(data.suggestions ?? []);
    }
    return true;
  }

  async function ask(message: string): Promise<void> {
    message = message.trim();
    if (!message || busy) return;
    busy = true;
    sendButton.disabled = true;
    if (!(await session())) { busy = false; return; }

    input.value = '';
    followups.replaceChildren();
    page.querySelectorAll('.beta-ask-item').forEach((n) => n.classList.add('is-answered'));
    startComposing();
    turn += 1;

    const wrap = openTurn(message);
    const status = el('div', 'st-wrap st-label beta-status');
    status.append(el('span', '', copy.live.composing));
    wrap.append(status);
    requestAnimationFrame(() => wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }));

    let got = false;
    try {
      const res = await fetch('/beta/turn', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, message, locale: copy.locale, pageUrl: location.href, handoffUrl, turn }),
      });
      const reader = res.body!.pipeThrough(new TextDecoderStream()).getReader();
      let buffer = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += value;
        let cut: number;
        while ((cut = buffer.indexOf('\n\n')) !== -1) {
          const frame = buffer.slice(0, cut);
          buffer = buffer.slice(cut + 2);
          const event = /^event: (.*)$/m.exec(frame)?.[1] ?? '';
          const data = JSON.parse(/^data: (.*)$/m.exec(frame)?.[1] ?? 'null');
          if (event === 'status') status.append(el('span', '', `${copy.live.reading} : ${data.label}`));
          else if (event === 'html') { if (!got) status.remove(); got = true; appendHtml(wrap, data.html); }
          else if (event === 'ask') askBlock(wrap, data);
          else if (event === 'suggestions') renderFollowups(data.items ?? []);
          else if (event === 'profile') { profile = data.profile ?? {}; renderProfile(); }
          else if (event === 'done') handoffUrl = data.handoff_url ?? handoffUrl;
          else if (event === 'error') {
            status.remove();
            if (data.code === 'unavailable') { showFallback(); break; }
            const text = data.code === 'exhausted' ? copy.live.exhausted : data.code === 'rate' ? copy.live.rate : (data.message ?? copy.live.failed);
            const box = el('div', 'st-wrap beta-turn__error');
            box.append(el('p', 'st-lede', text));
            if (data.code === 'exhausted') {
              const a = el('a', 'st-btn st-btn--primary', copy.live.signup) as HTMLAnchorElement;
              a.href = data.handoff_url ?? handoffUrl;
              box.append(a);
            }
            wrap.append(box);
          }
        }
      }
    } catch {
      status.remove();
      const box = el('div', 'st-wrap beta-turn__error');
      box.append(el('p', 'st-lede', copy.live.failed));
      wrap.append(box);
    }

    status.remove();
    busy = false;
    sendButton.disabled = false;
    input.focus({ preventScroll: true });
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); void ask(input.value); });
  document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach((b) => b.addEventListener('click', () => ask(b.dataset.prompt!)));

  // Restore a visit, then honour ?q= (a campaign or an answer page can open on a question).
  const initial = new URLSearchParams(location.search).get('q');
  if (store.get() || initial) {
    session().then((ok) => { if (ok && initial) void ask(initial); });
  }
</script>
