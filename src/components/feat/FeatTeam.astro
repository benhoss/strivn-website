---
import type { FeaturesIndexContent } from '../../data/featuresIndexContent';
import type { Locale } from '../../data/landingContent';
import { SECTION_ICONS, SECTION_SLUGS, RSVP_ROWS } from '../../data/featuresIndexContent';
import HomeIcon from '../home/HomeIcon.astro';
import FeatHead from './FeatHead.astro';
import FeatModules from './FeatModules.astro';

interface Props {
  team: FeaturesIndexContent['team'];
  locale: Locale;
}

const { team: c, locale } = Astro.props;
const v = c.visual;

/** Each RSVP state carries its own icon and colour. */
const stateStyle: Record<string, { icon: string; tone: string }> = {
  yes: { icon: 'check', tone: 'text-[#8CE99A]' },
  no: { icon: 'x', tone: 'text-[#FF7A6B]' },
  maybe: { icon: 'bell', tone: 'text-[#FF8400]' },
  none: { icon: 'clock', tone: 'text-[#68779A]' },
};
---

<section id="equipe" class="scroll-mt-20 bg-[#070A14] py-20 md:py-24" aria-labelledby="feat-team-title">
  <div class="hl-wrap">
    <FeatHead kicker={c.kicker} title={c.title} body={c.body} id="feat-team-title" accent="text-[#FF8400]" />

    <div class="mt-11 grid items-start gap-12 lg:grid-cols-[minmax(0,600px)_minmax(0,1fr)] lg:gap-16">
      <!-- Call-up capture -->
      <div
        class="hl-reveal hl-reveal--card hl-parallax flex flex-col gap-3.5 overflow-hidden rounded-[18px] bg-[#0B1020] p-6 [background-image:radial-gradient(ellipse_50%_50%_at_80%_0%,rgba(45,127,249,0.15),transparent_70%)] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]"
      >
        <div class="rounded-[12px] bg-[#FFFFFF08] p-4 outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-[0.75rem] font-semibold text-[#F8FAFC]">{v.to}</p>
            <span class="font-mono text-[0.57rem] tracking-[0.09em] text-[#68779A]">{v.type}</span>
          </div>
          <p class="mt-2.5 text-[0.78rem] leading-[1.6] text-[#9AA8C4]">{v.body}</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="flex items-center gap-1.5 rounded-full bg-[#2D7FF9] px-3 py-1.5 text-[0.72rem] font-semibold text-white">
              <HomeIcon name="send" size={12} />
              {v.sent}
            </span>
            <span class="font-mono text-[0.6rem] text-[#68779A]">{v.auto}</span>
          </div>
        </div>

        <p class="font-mono text-[0.59rem] tracking-[0.1em] text-[#68779A]">{v.responsesLabel}</p>

        <ul class="flex flex-col gap-[7px]" data-stagger>
          {RSVP_ROWS.map((row) => (
            <li class="flex items-center gap-3 rounded-[9px] bg-[#FFFFFF06] px-3.5 py-2.5">
              <span class="grid size-[26px] shrink-0 place-items-center rounded-full bg-[#FFFFFF12] text-[0.69rem] font-semibold text-[#C3CDE0]">
                {row.name.charAt(0)}
              </span>
              <span class="min-w-0 flex-1 truncate text-[0.78rem] font-medium text-[#DCE4F2]">{row.name}</span>
              <span class={`flex shrink-0 items-center gap-1.5 text-[0.72rem] whitespace-nowrap ${stateStyle[row.state].tone}`}>
                <HomeIcon name={stateStyle[row.state].icon} size={12} />
                {v.states[row.state]}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <FeatModules modules={c.modules} icons={SECTION_ICONS.team} slugs={SECTION_SLUGS.team} locale={locale} accent="text-[#FF8400]" class="lg:pt-2" />
    </div>
  </div>
</section>
