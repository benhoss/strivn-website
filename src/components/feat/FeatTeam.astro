---
/**
 * Call-up screen: the message sent to the squad, then each player's answer.
 * The answer is the player's availability, so it wears a status chip.
 */
import type { FeaturesIndexContent } from '../../data/featuresIndexContent';
import { RSVP_ROWS } from '../../data/featuresIndexContent';

interface Props {
  visual: FeaturesIndexContent['teamVisual'];
}

const { visual: v } = Astro.props;

const chip: Record<(typeof RSVP_ROWS)[number]['state'], string> = {
  yes: 'st-chip--ready',
  no: 'st-chip--risk',
  maybe: 'st-chip--watch',
  none: 'st-chip--wait',
};
---

<figure class="st-panel fx-rsvp" aria-label={v.to}>
  <figcaption class="st-panel__bar fx-rsvp__bar">
    <span class="st-h4">{v.to}</span>
    <span class="st-tag">{v.type}</span>
  </figcaption>
  <div class="st-panel__body grid gap-4">
    <p class="st-small">{v.body}</p>
    <p class="st-fine fx-rsvp__sent"><span>{v.sent}</span><span>{v.auto}</span></p>
    <div>
      <p class="st-label fx-rsvp__label">{v.responsesLabel}</p>
      <ul class="fx-rsvp__list">
        {RSVP_ROWS.map((row) => (
          <li>
            <span class="fx-rsvp__name">{row.name}</span>
            <span class={`st-chip ${chip[row.state]}`}>{v.states[row.state]}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</figure>

<style>
  .fx-rsvp {
    margin: 0;
  }
  .fx-rsvp__bar {
    justify-content: space-between;
  }
  .fx-rsvp__sent {
    color: var(--color-ink-3);
  }
  .fx-rsvp__label {
    margin: 0 0 8px;
  }
  .fx-rsvp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .fx-rsvp__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .fx-rsvp__name {
    font-size: 14px;
    color: var(--color-ink);
  }
</style>
