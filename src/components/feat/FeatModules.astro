---
/**
 * A group's module list: one row per module, hairlines between. A row with a
 * sub-page is a link (name in `st-link`); a row without one stays plain text
 * rather than pointing somewhere that only half answers it.
 */
interface Props {
  rows: Array<{ name: string; desc: string; href: string | null }>;
  /** Optional mono label over the list. */
  label?: string;
}

const { rows, label } = Astro.props;
---

<div class="fx-mods">
  {label && <p class="st-label fx-mods__label">{label}</p>}
  <ul>
    {rows.map((r) => (
      <li class="st-hover-row">
        {r.href ? (
          <a href={r.href} class="fx-mods__row">
            <span class="st-link fx-mods__name">{r.name}</span>
            <span class="fx-mods__desc">{r.desc}</span>
          </a>
        ) : (
          <div class="fx-mods__row">
            <span class="fx-mods__name">{r.name}</span>
            <span class="fx-mods__desc">{r.desc}</span>
          </div>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .fx-mods ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .fx-mods__label {
    margin: 0 0 12px;
  }
  .fx-mods li {
    border-bottom: 1px solid var(--color-line);
  }
  .fx-mods__row {
    display: grid;
    gap: 3px;
    padding: 13px 0;
    text-decoration: none;
  }
  .fx-mods__name {
    font-size: 15.5px;
    line-height: 1.35;
    font-weight: 500;
    color: var(--color-ink);
  }
  .fx-mods__name.st-link {
    color: var(--color-electric-500);
  }
  .fx-mods__desc {
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-ink-3);
  }
  a.fx-mods__row:hover .st-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.fx-mods__row:hover .st-link::after {
    transform: translateX(3px);
  }
  a.fx-mods__row:focus-visible {
    outline: 2px solid var(--color-electric-500);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
