---
import type { FeaturesIndexContent } from '../../data/featuresIndexContent';
import type { Locale } from '../../data/landingContent';
import { SECTION_ICONS, SECTION_SLUGS, SESSION_BLOCKS } from '../../data/featuresIndexContent';
import HomeIcon from '../home/HomeIcon.astro';
import FeatHead from './FeatHead.astro';
import FeatModules from './FeatModules.astro';

interface Props {
  sessions: FeaturesIndexContent['sessions'];
  locale: Locale;
}

const { sessions: c, locale } = Astro.props;
const v = c.visual;
---

<section id="seances" class="scroll-mt-20 bg-[#05070F] py-20 md:py-24" aria-labelledby="feat-sessions-title">
  <div class="hl-wrap">
    <FeatHead kicker={c.kicker} title={c.title} body={c.body} id="feat-sessions-title" accent="text-[#8CE99A]" />

    <div class="mt-11 grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,600px)] lg:gap-16">
      <FeatModules
        modules={c.modules}
        icons={SECTION_ICONS.sessions}
        slugs={SECTION_SLUGS.sessions}
        locale={locale}
        accent="text-[#8CE99A]"
        class="order-2 lg:order-1 lg:pt-2"
      />

      <!-- Session builder capture -->
      <div
        class="hl-reveal hl-reveal--card hl-parallax order-1 flex flex-col gap-3.5 overflow-hidden rounded-[18px] bg-[#0B1020] p-6 [background-image:radial-gradient(ellipse_50%_50%_at_85%_0%,rgba(45,127,249,0.15),transparent_70%)] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px] lg:order-2"
        style="--d: 120ms;"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="text-[0.84rem] font-semibold text-[#F8FAFC]">{v.title}</p>
            <p class="mt-0.5 text-[0.72rem] text-[#9AA8C4]">{v.sub}</p>
          </div>
          <span class="flex items-center gap-1.5 rounded-full bg-[#8CE99A14] px-[11px] py-[5px] font-mono text-[0.53rem] tracking-[0.08em] text-[#8CE99A] outline-1 outline-[#8CE99A2E] -outline-offset-[0.5px]">
            <HomeIcon name="target" size={11} />
            {v.badge}
          </span>
        </div>

        <ul class="flex flex-col gap-[7px]" data-stagger>
          {v.blocks.map((name, i) => (
            <li class="flex items-center gap-3 rounded-[10px] bg-[#FFFFFF07] px-3.5 py-3 outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
              <HomeIcon name="table" size={13} class="shrink-0 text-[#3D4A68]" />
              <span class="min-w-0 flex-1 truncate text-[0.78rem] font-medium text-[#DCE4F2]">{name}</span>
              <span class="shrink-0 font-mono text-[0.66rem] whitespace-nowrap text-[#68779A]">{SESSION_BLOCKS[i].min}</span>
              <span class="shrink-0 rounded-full bg-[#2D7FF91C] px-2.5 py-[3px] font-mono text-[0.63rem] whitespace-nowrap text-[#7AB8FF]">
                {SESSION_BLOCKS[i].ua}
              </span>
            </li>
          ))}
        </ul>

        <div class="rounded-[12px] bg-[#2D7FF910] px-[15px] py-3.5 outline-1 outline-[#2D7FF947] -outline-offset-[0.5px]">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="flex items-center gap-2 text-[0.75rem] font-semibold text-[#F8FAFC]">
              <HomeIcon name="dumbbell" size={13} class="text-[#7AB8FF]" />
              {v.workoutTitle}
            </p>
            <p class="flex items-center gap-1.5 text-[0.66rem] text-[#8CE99A]">
              <HomeIcon name="smartphone" size={11} />
              {v.published}
            </p>
          </div>
          <p class="mt-2.5 text-[0.72rem] leading-[1.55] text-[#C3D4EE]">{v.workoutBody}</p>
        </div>
      </div>
    </div>
  </div>
</section>
