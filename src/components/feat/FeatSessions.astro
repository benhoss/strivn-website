---
/**
 * Session builder screen: four blocks with duration and estimated load, the
 * total against the target, and the individual workout sent to the player
 * app. Block figures are invariant (`SESSION_BLOCKS`).
 */
import type { FeaturesIndexContent } from '../../data/featuresIndexContent';
import { SESSION_BLOCKS } from '../../data/featuresIndexContent';

interface Props {
  visual: FeaturesIndexContent['sessionsVisual'];
}

const { visual: v } = Astro.props;
const total = SESSION_BLOCKS.reduce((s, b) => s + Number(b.ua), 0);
const TARGET = 460;
/** The locale's own load unit, as its subtitle writes it (UA or AU). */
const unit = /\bAU\b/.test(v.sub) ? 'AU' : 'UA';
---

<figure class="st-panel fx-sess" aria-label={v.title}>
  <figcaption class="st-panel__bar fx-sess__bar">
    <span class="grid gap-1">
      <span class="st-h4">{v.title}</span>
      <span class="st-label">{v.sub}</span>
    </span>
    <span class="st-tag st-tag--accent">{v.badge}</span>
  </figcaption>

  <div class="st-panel__body grid gap-5">
    <table class="fx-sess__table">
      <tbody>
        {v.blocks.map((name, i) => (
          <tr>
            <th scope="row">{name}</th>
            <td class="st-num">{SESSION_BLOCKS[i].min}</td>
            <td class="st-num fx-sess__ua">{SESSION_BLOCKS[i].ua} {unit}</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">
            <span class="st-meter" aria-hidden="true"><i style={`width: ${Math.round((total / TARGET) * 100)}%`}></i></span>
          </th>
          <td class="st-num">65 min</td>
          <td class="st-num fx-sess__ua">{total} / {TARGET}</td>
        </tr>
      </tfoot>
    </table>

    <div class="st-block fx-sess__workout">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <span class="st-h4">{v.workoutTitle}</span>
        <span class="st-label st-label--accent">{v.published}</span>
      </div>
      <p class="st-small">{v.workoutBody}</p>
    </div>
  </div>
</figure>

<style>
  .fx-sess {
    margin: 0;
  }
  .fx-sess__bar {
    justify-content: space-between;
  }
  .fx-sess__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .fx-sess__table th {
    text-align: left;
    font-weight: 500;
    color: var(--color-ink);
    padding: 11px 12px 11px 0;
  }
  .fx-sess__table td {
    text-align: right;
    white-space: nowrap;
    color: var(--color-ink-3);
    padding: 11px 0 11px 16px;
    font-size: 13px;
  }
  .fx-sess__table tbody tr {
    border-bottom: 1px solid var(--color-line);
  }
  .fx-sess__table tbody tr:first-child {
    border-top: 1px solid var(--color-line);
  }
  .fx-sess__table td.fx-sess__ua {
    color: var(--color-ink);
  }
  .fx-sess__table tfoot th {
    vertical-align: middle;
  }
  .fx-sess__table tfoot td.fx-sess__ua {
    color: var(--color-electric-500);
  }
  .fx-sess__workout {
    display: grid;
    gap: 8px;
    padding: 16px;
    border-radius: 8px;
  }
</style>
