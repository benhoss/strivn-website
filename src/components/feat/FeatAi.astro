---
import type { FeaturesIndexContent } from '../../data/featuresIndexContent';
import { SECTION_ICONS, AI_CHART, AI_ACTS_FROM } from '../../data/featuresIndexContent';
import HomeIcon from '../home/HomeIcon.astro';
import FeatHead from './FeatHead.astro';

interface Props {
  ai: FeaturesIndexContent['ai'];
}

const { ai: c } = Astro.props;
const v = c.visual;

/** The list is one array; the label rows split it into "reads" and "acts". */
const reads = c.moments.slice(0, AI_ACTS_FROM);
const acts = c.moments.slice(AI_ACTS_FROM);
const readIcons = SECTION_ICONS.ai.slice(0, AI_ACTS_FROM);
const actIcons = SECTION_ICONS.ai.slice(AI_ACTS_FROM);
---

<section
  id="ia"
  class="scroll-mt-20 border-y border-[#FFFFFF14] bg-[#060913] py-20 [background-image:radial-gradient(ellipse_50%_60%_at_30%_30%,rgba(45,127,249,0.16),transparent_72%)] md:py-24"
  aria-labelledby="feat-ai-title"
>
  <div class="hl-wrap">
    <FeatHead kicker={c.kicker} title={c.title} body={c.body} id="feat-ai-title" />

    <div class="mt-11 grid items-start gap-12 lg:grid-cols-[minmax(0,600px)_minmax(0,1fr)] lg:gap-16">
      <!-- Assistant capture -->
      <div
        class="hl-reveal hl-reveal--card hl-parallax flex flex-col gap-3 overflow-hidden rounded-[18px] p-6 [background-image:linear-gradient(90deg,#111A36_0%,#090D1B_100%)] outline-1 outline-[#7AB8FF4D] -outline-offset-[0.5px] [box-shadow:0_30px_70px_-16px_rgba(0,0,0,0.8),0_0_50px_-8px_rgba(45,127,249,0.2)]"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="flex items-center gap-2.5 text-[0.88rem] font-semibold text-[#F8FAFC]">
            <HomeIcon name="sparkles" size={16} class="text-[#7AB8FF]" />
            {v.assistant}
          </p>
          <span class="flex items-center gap-1.5 rounded-full bg-[#8CE99A14] px-2.5 py-1 font-mono text-[0.53rem] tracking-[0.08em] text-[#8CE99A]">
            <span class="hl-pulse size-[5px] rounded-full bg-[#8CE99A]"></span>
            {v.live}
          </span>
        </div>

        <p class="max-w-[85%] self-start rounded-[12px] rounded-bl-[4px] bg-[#FFFFFF0D] px-4 py-2.5 text-[0.81rem] leading-[1.5] text-[#DCE4F2] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
          {v.question}
        </p>

        <div class="rounded-[12px] rounded-br-[4px] bg-[#2D7FF91C] px-4 py-3.5 outline-1 outline-[#2D7FF947] -outline-offset-[0.5px]">
          <p class="text-[0.81rem] leading-[1.55] text-[#D6E6FF]">{v.answer}</p>
          <p class="mt-1.5 font-mono text-[0.5rem] tracking-[0.09em] text-[#7FA8DD]">{v.sources}</p>

          <div class="mt-2.5 rounded-[10px] bg-[#0A0F1FCC] px-3.5 py-3 outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-[0.72rem] font-semibold text-[#F8FAFC]">{v.vizTitle}</p>
              <p class="flex items-center gap-3 font-mono text-[0.53rem] text-[#68779A]">
                <span class="flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-[#FFFFFF3D]"></span>{v.legendA}</span>
                <span class="flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-[#2D7FF9]"></span>{v.legendB}</span>
              </p>
            </div>

            <div class="mt-3 grid grid-cols-4 gap-3" style="height: 7.4rem;">
              {AI_CHART.map(([a, b], i) => (
                <div class="flex h-full flex-col justify-end gap-1.5">
                  <div class="flex h-full items-end justify-center gap-[5px]">
                    <span class="hl-bar w-[18px] rounded-t-[4px] bg-[#FFFFFF29]" style={`height: ${a}%; --bd: ${i * 80}ms;`}></span>
                    <span
                      class="hl-bar w-[18px] rounded-t-[4px] [background-image:linear-gradient(90deg,#7AB8FF,#2D7FF9)]"
                      style={`height: ${b}%; --bd: ${i * 80 + 40}ms;`}
                    ></span>
                  </div>
                  <p class="text-center font-mono text-[0.5rem] tracking-[0.07em] text-[#68779A]">{v.metrics[i]}</p>
                </div>
              ))}
            </div>

            <p class="mt-3 text-[0.72rem] leading-[1.5] text-[#C3D4EE]">{v.insight}</p>
          </div>

          <div class="mt-2.5 flex flex-wrap gap-2">
            <span class="flex items-center gap-1.5 rounded-full bg-[#2D7FF9] px-3.5 py-[7px] text-[0.69rem] font-semibold text-white">
              <HomeIcon name="target" size={11} />
              {v.pin}
            </span>
            <span class="rounded-full bg-[#FFFFFF0D] px-3.5 py-[7px] text-[0.69rem] text-[#C3D4EE] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
              {v.refine}
            </span>
          </div>
        </div>

        <div class="flex items-center gap-3 rounded-[12px] bg-[#FF84001A] px-[15px] py-3 outline-1 outline-[#FF840038] -outline-offset-[0.5px]">
          <HomeIcon name="radar" size={15} class="shrink-0 text-[#FF8400]" />
          <div class="min-w-0 flex-1">
            <p class="text-[0.75rem] font-semibold text-[#F0D8B8]">{v.signalTitle}</p>
            <p class="mt-0.5 text-[0.72rem] leading-[1.5] text-[#C9B592]">{v.signalBody}</p>
          </div>
          <span class="shrink-0 rounded-full bg-[#FFFFFF0D] px-3 py-1.5 text-[0.69rem] font-medium whitespace-nowrap text-[#F0D8B8] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
            {v.examine}
          </span>
        </div>
      </div>

      <!-- Moments, in two labelled groups -->
      <div class="hl-reveal hl-reveal--right" style="--d: 120ms;">
        {[
          { label: c.readsLabel, items: reads, icons: readIcons },
          { label: c.actsLabel, items: acts, icons: actIcons },
        ].map((group) => (
          <div class="mt-7 first:mt-0">
            <p class="flex items-center gap-3 font-mono text-[0.59rem] tracking-[0.13em] text-[#7AB8FF]">
              {group.label}
              <span class="h-px flex-1 bg-[#FFFFFF14]"></span>
            </p>
            <ul class="mt-1" data-stagger>
              {group.items.map((m, i) => (
                <li class="hl-row flex items-start gap-3.5 border-t border-[#FFFFFF14] py-3 first:border-t-0 text-[#7AB8FF]">
                  <HomeIcon name={group.icons[i] ?? 'sparkles'} size={15} class="hl-row__icon mt-1 shrink-0 text-[#68779A]" />
                  <div class="min-w-0">
                    <p class="text-[0.84rem] font-semibold text-[#F8FAFC]">{m.name}</p>
                    <p class="mt-1 text-[0.75rem] leading-[1.5] text-[#9AA8C4]">{m.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <p
      class="hl-reveal mt-11 flex items-center gap-3 rounded-[12px] bg-[#FFFFFF06] px-[18px] py-3.5 text-[0.81rem] leading-[1.55] text-[#C9EED2] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]"
    >
      <HomeIcon name="shield" size={15} class="shrink-0 text-[#8CE99A]" />
      {c.note}
    </p>
  </div>
</section>
