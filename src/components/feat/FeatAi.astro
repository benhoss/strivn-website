---
/**
 * Assistant screen after the match: the staff's question, the answer with its
 * sources and chart, the two follow-ups, then a signal the assistant raised on
 * its own. Chart heights are invariant (`AI_CHART`).
 */
import type { FeaturesIndexContent } from '../../data/featuresIndexContent';
import { AI_CHART } from '../../data/featuresIndexContent';

interface Props {
  visual: FeaturesIndexContent['ai']['visual'];
}

const { visual: v } = Astro.props;
---

<figure class="st-panel fx-ai" aria-label={v.assistant}>
  <figcaption class="st-panel__bar fx-ai__bar">
    <span class="st-h4">{v.assistant}</span>
    <span class="st-tag st-tag--accent">{v.live}</span>
  </figcaption>

  <div class="st-panel__body grid gap-4">
    <p class="fx-ai__q">{v.question}</p>

    <div class="fx-ai__a">
      <p class="st-small fx-ai__ink" data-st-type>{v.answer}</p>
      <p class="st-label">{v.sources}</p>

      <div class="fx-ai__chart">
        <div class="fx-ai__chart-head">
          <span class="fx-ai__ink fx-ai__chart-title">{v.vizTitle}</span>
          <span class="fx-ai__legend st-num">
            <span><i class="fx-ai__a-sw"></i>{v.legendA}</span>
            <span><i class="fx-ai__b-sw"></i>{v.legendB}</span>
          </span>
        </div>
        <div class="fx-ai__bars" role="img" aria-label={`${v.vizTitle}: ${v.insight}`}>
          {AI_CHART.map(([a, b], i) => (
            <div class="fx-ai__pair">
              <div class="fx-ai__cols">
                <span class="fx-ai__col fx-ai__col--a" style={`height: ${a}%`}></span>
                <span class="fx-ai__col fx-ai__col--b" style={`height: ${b}%`}></span>
              </div>
              <span class="st-num fx-ai__metric">{v.metrics[i]}</span>
            </div>
          ))}
        </div>
        <p class="st-small">{v.insight}</p>
      </div>

      <div class="flex flex-wrap gap-2">
        <span class="st-btn st-btn--primary st-btn--sm">{v.pin}</span>
        <span class="st-btn st-btn--ghost st-btn--sm">{v.refine}</span>
      </div>
    </div>

    <div class="st-block fx-ai__signal">
      <div class="min-w-0">
        <p class="fx-ai__ink fx-ai__signal-title">{v.signalTitle}</p>
        <p class="st-small">{v.signalBody}</p>
      </div>
      <span class="st-btn st-btn--ghost st-btn--sm">{v.examine}</span>
    </div>
  </div>
</figure>

<style>
  .fx-ai {
    margin: 0;
  }
  .fx-ai__bar {
    justify-content: space-between;
  }
  .fx-ai__ink {
    color: var(--color-ink);
  }
  .fx-ai__q {
    justify-self: end;
    max-width: 88%;
    margin: 0;
    padding: 10px 14px;
    border-radius: 10px 10px 2px 10px;
    background: var(--color-navy-850);
    border: 1px solid var(--color-line);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .fx-ai__a {
    display: grid;
    gap: 12px;
    padding: 14px;
    border-radius: 10px 10px 10px 2px;
    border: 1px solid rgba(45, 127, 249, 0.35);
    background: rgba(45, 127, 249, 0.06);
  }
  .fx-ai__chart {
    display: grid;
    gap: 12px;
    padding: 14px;
    border-radius: 8px;
    background: var(--color-navy-950);
    border: 1px solid var(--color-line);
  }
  .fx-ai__chart-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
  .fx-ai__chart-title {
    font-size: 13px;
    font-weight: 500;
  }
  .fx-ai__legend {
    display: flex;
    gap: 12px;
    font-size: 10.5px;
    color: var(--color-ink-3);
  }
  .fx-ai__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .fx-ai__legend i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .fx-ai__a-sw,
  .fx-ai__col--a {
    background: var(--color-navy-600);
  }
  .fx-ai__b-sw,
  .fx-ai__col--b {
    background: var(--color-electric);
  }
  .fx-ai__bars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    height: 118px;
    border-bottom: 1px solid var(--color-line-strong);
  }
  .fx-ai__pair {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 6px;
    min-height: 0;
  }
  .fx-ai__cols {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    min-height: 0;
  }
  .fx-ai__col {
    width: 18px;
    border-radius: 3px 3px 0 0;
  }
  .fx-ai__metric {
    text-align: center;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    padding-bottom: 6px;
  }
  .fx-ai__signal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 8px;
  }
  .fx-ai__signal-title {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 500;
  }
</style>
