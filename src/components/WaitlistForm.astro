---
import type { Locale } from '../data/landingContent';
import { clubsContent, CLUBS_FORM_ENDPOINT } from '../data/clubsContent';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const form = clubsContent[locale].form;
---

<div class="wf" data-waitlist-wrap aria-live="polite">
  <form class="wf__form" method="POST" action={CLUBS_FORM_ENDPOINT} data-waitlist>
    <!-- Honeypot: Formspree drops submissions where _gotcha is filled. -->
    <input
      type="text"
      name="_gotcha"
      class="wf__gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="_subject" value="STRIVN Club waitlist" />
    <!-- Filled in when the visitor arrived from a plan card on the pricing
         page, so a submission says which tier prompted it. Empty otherwise. -->
    <input type="hidden" name="plan" value="" data-plan-field />

    <div class="wf__grid">
      <label class="wf__field">
        <span class="wf__label">{form.fields.name.label}</span>
        <input type="text" name="name" required placeholder={form.fields.name.placeholder} autocomplete="name" />
      </label>
      <label class="wf__field">
        <span class="wf__label">{form.fields.email.label}</span>
        <input type="email" name="email" required placeholder={form.fields.email.placeholder} autocomplete="email" />
      </label>
      <label class="wf__field">
        <span class="wf__label">{form.fields.club.label}</span>
        <input type="text" name="club" required placeholder={form.fields.club.placeholder} autocomplete="organization" />
      </label>
      <label class="wf__field">
        <span class="wf__label">{form.fields.teams.label}</span>
        <input type="number" name="teams" min="1" inputmode="numeric" placeholder={form.fields.teams.placeholder} />
      </label>
      <label class="wf__field wf__field--wide">
        <span class="wf__label">{form.fields.role.label}</span>
        <input type="text" name="role" placeholder={form.fields.role.placeholder} autocomplete="organization-title" />
      </label>
    </div>

    <p class="wf__error" data-error role="alert" hidden>{form.error}</p>

    <div class="wf__actions">
      <button type="submit" class="st-btn st-btn--primary" data-sending={form.sending}>{form.submit}</button>
      <p class="wf__privacy">
        {form.privacyNote}
        <a href={form.privacyLink.href}>{form.privacyLink.label}</a>
      </p>
    </div>
  </form>

  <div class="wf__success" data-success hidden>
    <h3>{form.success.title}</h3>
    <p>{form.success.body}</p>
  </div>
</div>

<script>
  /* The pricing page stores the tier a visitor clicked just before navigating
     here. Read it once, then clear it: a stale value on a later visit would
     attribute the lead to a plan the visitor never clicked. */
  try {
    const plan = sessionStorage.getItem('strivn:plan');
    if (plan) {
      document.querySelectorAll<HTMLInputElement>('[data-plan-field]').forEach((field) => {
        field.value = plan;
      });
      sessionStorage.removeItem('strivn:plan');
    }
  } catch {
    /* Storage blocked: the form still submits, without attribution. */
  }

  document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const error = form.querySelector<HTMLElement>('[data-error]');
      const success = form.closest('[data-waitlist-wrap]')?.querySelector<HTMLElement>('[data-success]');
      if (!button) return;

      error?.setAttribute('hidden', '');
      const idleLabel = button.textContent;
      button.disabled = true;
      button.textContent = button.dataset.sending ?? idleLabel;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`Formspree responded ${res.status}`);
        form.setAttribute('hidden', '');
        success?.removeAttribute('hidden');
      } catch {
        // Field values are preserved so the visitor can simply retry.
        error?.removeAttribute('hidden');
        button.disabled = false;
        button.textContent = idleLabel;
      }
    });
  });
</script>

<style>
  .wf__gotcha {
    display: none;
  }

  .wf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 16px;
    margin-bottom: 20px;
  }

  .wf__field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  /* Role spans the full row so the placeholder has room to breathe. */
  .wf__field--wide {
    grid-column: 1 / -1;
  }

  .wf__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .wf__field input {
    width: 100%;
    min-height: 46px;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    color: var(--color-ink);
    font: 400 15px/1.3 var(--font-sans);
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .wf__field input::placeholder {
    color: var(--color-ink-4);
  }

  .wf__field input:hover {
    border-color: var(--color-navy-500);
  }

  .wf__field input:focus,
  .wf__field input:focus-visible {
    outline: none;
    border-color: var(--color-electric);
    box-shadow: 0 0 0 3px rgba(45, 127, 249, 0.28);
  }

  /* A failed send is not a player at risk: the message stays neutral. */
  .wf__error {
    margin: 0 0 20px;
    padding: 12px 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: var(--color-navy-900);
    color: var(--color-ink-2);
    font-size: 14px;
  }

  .wf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .wf__actions .st-btn {
    white-space: normal;
    text-align: center;
  }

  .wf__actions .st-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .wf__privacy {
    margin: 0;
    max-width: 44ch;
    color: var(--color-ink-3);
    font-size: 13px;
    line-height: 1.5;
  }

  .wf__privacy a {
    color: var(--color-ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-navy-500);
  }

  .wf__privacy a:hover {
    color: var(--color-ink);
  }

  .wf__success {
    display: grid;
    gap: 10px;
    padding: 24px;
    border: 1px solid rgba(45, 127, 249, 0.35);
    border-radius: 12px;
    background: rgba(45, 127, 249, 0.08);
  }

  /* `display: grid` above would otherwise override the hidden attribute. */
  .wf [hidden] {
    display: none;
  }

  .wf__success h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-variation-settings: 'wdth' 90;
    font-size: 21px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .wf__success p {
    margin: 0;
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  @media (max-width: 560px) {
    .wf__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .wf__actions .st-btn {
      width: 100%;
    }
  }
</style>
