---
import { type Locale } from '../data/landingContent';
import { appStartUrl } from '../lib/appUrl';

type NavLink =
  | { label: string; href: string }
  | { label: string; children: Array<{ label: string; href: string }> };

interface Props {
  locale: Locale;
  links: NavLink[];
  cta: string;
  /** Where the brand logo links to ('#s-main' on the homepage, locale root on subpages). */
  brandHref?: string;
  /**
   * Language-switcher targets, so subpages can point to their own
   * counterpart. Every locale is optional: a section that exists in one
   * language only omits the others and they fall back to their home page,
   * rather than being handed a URL that was never built.
   */
  switchHrefs?: { en?: string; fr?: string; nl?: string; de?: string; pt?: string; es?: string };
}

const { locale, links, cta, brandHref, switchHrefs = {} } = Astro.props;

/**
 * The logo goes to the homepage of the language being read. The default used
 * to be `#s-main`, which only ever scrolled to the top of the page you were
 * already on — fine on a homepage, a dead end on every other landing page.
 *
 * On the homepage itself a link to its own URL would reload the page, so it
 * keeps the scroll-to-top behaviour a logo is expected to have there.
 */
const home = `/${locale}/`;
const brand = brandHref ?? (Astro.url.pathname === home ? '#s-main' : home);

const navAriaByLocale: Record<Locale, string> = {
  fr: 'Navigation principale',
  nl: 'Hoofdnavigatie',
  de: 'Hauptnavigation',
  pt: 'Navegação principal',
  es: 'Navegación principal',
  en: 'Primary navigation',
};
const langAriaByLocale: Record<Locale, string> = {
  fr: 'Changer la langue',
  nl: 'Taal wisselen',
  de: 'Sprache wechseln',
  pt: 'Mudar de idioma',
  es: 'Cambiar de idioma',
  en: 'Switch language',
};
const navAria = navAriaByLocale[locale];
const langAria = langAriaByLocale[locale];
const menuLabel = 'Menu';

/** Language switcher entries — a locale falls back to its homepage when a page has no counterpart. */
const langs = [
  { code: 'fr' as const, label: 'FR', href: switchHrefs.fr ?? '/fr/' },
  { code: 'en' as const, label: 'EN', href: switchHrefs.en ?? '/en/' },
  { code: 'nl' as const, label: 'NL', href: switchHrefs.nl ?? '/nl/' },
  { code: 'de' as const, label: 'DE', href: switchHrefs.de ?? '/de/' },
  { code: 'pt' as const, label: 'PT', href: switchHrefs.pt ?? '/pt/' },
  { code: 'es' as const, label: 'ES', href: switchHrefs.es ?? '/es/' },
];
---

<!-- Header · full-width bar, sticky, hairline under it (redesign 2026-09) -->
<header class="st-nav" data-st-nav>
  <nav class="st-wrap st-nav__bar" aria-label={navAria}>
    <a href={brand} class="st-nav__brand" aria-label="STRIVN">
      <img src="/strivn-logo-full-white-web.png" alt="STRIVN" width="1130" height="369" />
    </a>

    <ul class="st-nav__links">
      {links.map((link) => (
        'children' in link ? (
          <li class="st-nav__group" data-nav-group>
            <button type="button" class="st-nav__link st-nav__trigger" aria-haspopup="true" aria-expanded="false">
              {link.label}
              <svg class="st-nav__caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <ul class="st-nav__menu">
              {link.children.map((child) => (
                <li><a href={child.href} class="st-nav__menu-link">{child.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={link.href} class="st-nav__link" aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a></li>
        )
      ))}
    </ul>

    <div class="st-nav__end">
      {/* Only the current language shows; the rest are one click away. */}
      <div class="st-nav__group st-nav__lang" data-nav-group>
        <button type="button" class="st-nav__trigger st-nav__lang-trigger" aria-haspopup="true" aria-expanded="false" aria-label={langAria}>
          {langs.find((l) => l.code === locale)?.label ?? locale.toUpperCase()}
          <svg class="st-nav__caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <ul class="st-nav__menu st-nav__menu--lang">
          {langs.map((l) => (
            <li>
              <a href={l.href} class="st-nav__menu-link" aria-current={locale === l.code ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <a href={appStartUrl(locale)} target="_blank" rel="noopener" class="st-btn st-btn--primary st-btn--sm st-nav__cta">{cta}</a>

      <button
        type="button"
        class="st-nav__burger"
        aria-label={menuLabel}
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="st-nav-mobile"
        data-nav-burger
      >
        <svg class="st-nav__burger-icon st-nav__burger-icon--open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg class="st-nav__burger-icon st-nav__burger-icon--close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </nav>

  {/* Optional second row under the bar (the homepage's week rail). */}
  <slot name="sub" />

  <!-- Mobile menu panel (under 1080px, where the inline links are hidden) -->
  <div class="st-nav__mobile" id="st-nav-mobile" hidden>
    <ul class="st-wrap st-nav__mobile-list">
      {links.map((link) => (
        'children' in link ? (
          <li class="st-nav__mobile-group">
            <span class="st-label">{link.label}</span>
            <ul>
              {link.children.map((child) => (
                <li><a href={child.href} class="st-nav__mobile-link">{child.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={link.href} class="st-nav__mobile-link">{link.label}</a></li>
        )
      ))}
      <li class="st-nav__mobile-lang" role="group" aria-label={langAria}>
        {langs.map((l) => (
          <a href={l.href} aria-current={locale === l.code ? 'page' : undefined}>{l.label}</a>
        ))}
      </li>
    </ul>
  </div>
</header>

<style>
  .st-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(7, 8, 15, 0.92);
    backdrop-filter: saturate(120%) blur(10px);
    -webkit-backdrop-filter: saturate(120%) blur(10px);
    border-bottom: 1px solid var(--color-line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .st-nav__bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--st-header);
  }
  .st-nav__brand {
    display: inline-flex;
    flex: none;
  }
  .st-nav__brand img {
    height: 22px;
    width: auto;
    flex: none;
  }
  .st-nav__links {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .st-nav__link {
    color: var(--color-ink-3);
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms ease;
  }
  .st-nav__link:hover,
  .st-nav__link[aria-current='page'] {
    color: var(--color-ink);
  }
  .st-nav__end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .st-nav__group {
    position: relative;
  }
  .st-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-size: 14px;
    color: var(--color-ink-3);
    cursor: pointer;
  }
  .st-nav__trigger:hover,
  .st-nav__group.is-open .st-nav__trigger {
    color: var(--color-ink);
  }
  .st-nav__lang-trigger {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .st-nav__caret {
    transition: transform 160ms ease;
  }
  .st-nav__group.is-open .st-nav__caret,
  .st-nav__group:hover .st-nav__caret {
    transform: rotate(180deg);
  }
  .st-nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 13rem;
    margin: 0;
    padding: 6px;
    list-style: none;
    display: grid;
    gap: 2px;
    background: var(--color-navy-950);
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    box-shadow: var(--shadow-float-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms;
  }
  .st-nav__group:hover .st-nav__menu,
  .st-nav__group:focus-within .st-nav__menu,
  .st-nav__group.is-open .st-nav__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .st-nav__menu--lang {
    min-width: 0;
    left: auto;
    right: 0;
  }
  .st-nav__menu-link {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--color-ink-2);
    font-size: 13.5px;
    text-decoration: none;
    white-space: nowrap;
  }
  .st-nav__menu-link:hover,
  .st-nav__menu-link[aria-current='page'] {
    background: var(--color-navy-900);
    color: var(--color-ink);
  }
  .st-nav__burger {
    display: none;
    position: relative;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: none;
    border: 1px solid var(--color-line-strong);
    border-radius: 6px;
    color: var(--color-ink);
    cursor: pointer;
  }
  .st-nav__burger-icon {
    position: absolute;
  }
  .st-nav__burger-icon--close,
  .st-nav__burger[aria-expanded='true'] .st-nav__burger-icon--open {
    display: none;
  }
  .st-nav__burger[aria-expanded='true'] .st-nav__burger-icon--close {
    display: block;
  }
  .st-nav__mobile {
    border-top: 1px solid var(--color-line);
    background: var(--color-void);
    max-height: calc(100dvh - var(--st-header));
    overflow-y: auto;
  }
  .st-nav__mobile-list {
    list-style: none;
    margin: 0;
    padding-block: 8px 20px;
    display: grid;
  }
  .st-nav__mobile-list ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 12px;
  }
  .st-nav__mobile-group {
    padding-top: 14px;
  }
  .st-nav__mobile-link {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: 17px;
    text-decoration: none;
  }
  .st-nav__mobile-lang {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .st-nav__mobile-lang a {
    color: var(--color-ink-3);
    text-decoration: none;
  }
  .st-nav__mobile-lang a[aria-current='page'] {
    color: var(--color-ink);
  }
  @media (max-width: 1080px) {
    .st-nav__links {
      display: none;
    }
    .st-nav__burger {
      display: inline-flex;
    }
  }
  @media (max-width: 480px) {
    .st-nav__lang {
      display: none;
    }
    .st-nav__end {
      gap: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-nav__menu,
    .st-nav__caret {
      transition: none;
    }
  }
</style>

<script>
  // ── Desktop dropdown: CSS handles hover/focus; JS adds click, Escape,
  //    outside-click and aria-expanded sync. ──
  document.querySelectorAll('[data-nav-group]').forEach((group) => {
    const trigger = group.querySelector('.st-nav__trigger');
    if (!trigger) return;
    const setOpen = (open) => {
      group.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      setOpen(!group.classList.contains('is-open'));
    });
    group.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { setOpen(false); trigger.focus(); }
    });
    group.addEventListener('focusin', () => trigger.setAttribute('aria-expanded', 'true'));
    group.addEventListener('focusout', (e) => {
      if (!group.contains(e.relatedTarget)) setOpen(false);
    });
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-nav-group].is-open').forEach((group) => {
      if (!group.contains(e.target)) {
        group.classList.remove('is-open');
        group.querySelector('.st-nav__trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ── Mobile menu: burger toggles the panel. ──
  document.querySelectorAll('[data-nav-burger]').forEach((burger) => {
    const panel = document.getElementById(burger.getAttribute('aria-controls'));
    if (!panel) return;
    const nav = burger.closest('[data-st-nav]');
    const setOpen = (open) => {
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
    };
    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });
    panel.addEventListener('click', (e) => {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (nav && !nav.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
  });
</script>
