---
import '../../styles/home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteMotion from '../SiteMotion.astro';
import HomeFooter from '../home/HomeFooter.astro';
import PricingHero from './PricingHero.astro';
import PricingPlans from './PricingPlans.astro';
import PricingCredits from './PricingCredits.astro';
import PricingMatrix from './PricingMatrix.astro';
import PricingDowngrade from './PricingDowngrade.astro';
import PricingFaq from './PricingFaq.astro';
import PricingCta from './PricingCta.astro';
import { NAV } from '../../data/nav';
import { homeContent } from '../../data/homeContent';
import { pricingContent, PRICING_LOCALES, PLAN_PRICES, type Locale } from '../../data/pricingContent';

interface Props {
  locale: Locale;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, canonicalPath, alternates } = Astro.props;
const c = pricingContent[locale];
/** The footer is shared with the homepage, as on every other landing page. */
const shared = homeContent[locale];

/** The page exists in all six, so hand the switcher the real counterparts
 *  rather than letting it fall back to the homepages. */
const switchHrefs = Object.fromEntries(PRICING_LOCALES.map((l) => [l, `/${l}/pricing/`])) as Record<Locale, string>;

const skipLabelByLocale: Record<Locale, string> = {
  fr: 'Aller au contenu',
  nl: 'Naar de inhoud',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  es: 'Ir al contenido',
  en: 'Skip to content',
};

/**
 * Structured-data amounts come from `PLAN_PRICES`, the same cents the cards
 * render, so a price can never be right on the page and stale in the markup.
 * A quoted tier emits no offer at all: an invented figure in structured data
 * is a lie a search engine will repeat.
 */
const euros = (cents: number) => cents / 100;

const pageUrl = `https://strivn.net${canonicalPath ?? `/${locale}/pricing/`}`;

const jsonLdExtra: Record<string, unknown>[] = [
  {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: c.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'STRIVN', item: `https://strivn.net/${locale}/` },
      { '@type': 'ListItem', position: 2, name: c.hero.kicker, item: pageUrl },
    ],
  },
  {
    '@type': 'Product',
    '@id': `${pageUrl}#product`,
    name: 'STRIVN',
    description: c.meta.description,
    offers: c.plans.items
      .filter((plan) => PLAN_PRICES[plan.code].monthly !== null)
      .map((plan) => {
        const { monthly, yearly } = PLAN_PRICES[plan.code];
        const offer: Record<string, unknown> = {
          '@type': 'Offer',
          name: plan.name,
          price: euros(monthly!),
          priceCurrency: 'EUR',
          url: pageUrl,
        };
        if (yearly) {
          offer.priceSpecification = [
            {
              '@type': 'UnitPriceSpecification',
              price: euros(monthly!),
              priceCurrency: 'EUR',
              billingDuration: 1,
              unitCode: 'MON',
            },
            {
              '@type': 'UnitPriceSpecification',
              price: euros(yearly),
              priceCurrency: 'EUR',
              billingDuration: 1,
              unitCode: 'ANN',
            },
          ];
        }
        return offer;
      }),
  },
];
---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={jsonLdExtra}
>
  <a href="#s-main" class="s-skip">{skipLabelByLocale[locale]}</a>

  <SiteHeader locale={locale} links={NAV[locale].links} cta={NAV[locale].cta} switchHrefs={switchHrefs} />

  <main id="s-main" class="bg-[#05070F] font-sans text-[#F8FAFC] antialiased">
    <PricingHero hero={c.hero} />
    <PricingPlans locale={locale} plans={c.plans} trial={c.trial} email={c.faq.email} />
    <PricingCredits credits={c.credits} />
    <PricingMatrix locale={locale} matrix={c.matrix} />
    <PricingDowngrade downgrade={c.downgrade} />
    <PricingFaq faq={c.faq} />
    <PricingCta locale={locale} cta={c.cta} email={c.faq.email} />
  </main>

  <HomeFooter locale={locale} footer={shared.footer} />

  <SiteMotion />
</BaseLayout>
