---
import type { PricingContent } from '../../data/pricingContent';
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  downgrade: PricingContent['downgrade'];
}

const { downgrade: c } = Astro.props;
---

<!-- "Lock creation, never reading" is the product rule for a downgraded team.
     It belongs on a pricing page because it answers the question a buyer asks
     silently: what happens to my season if I stop paying. -->
<section class="st-sec" aria-labelledby="downgrade-title">
  <div class="st-wrap st-split st-split--top">
    <div class="st-head pp-down__head">
      <span class="st-label st-eyebrow">{c.kicker}</span>
      <h2 id="downgrade-title" class="st-h2 st-h2--sm">{c.title}</h2>
      <p class="st-body">{c.body}</p>
    </div>

    <div class="pp-down__cols">
      <div>
        <h3 class="st-label">{c.closesTitle}</h3>
        <ul class="st-rules pp-down__list">
          {c.closes.map((item) => (
            <li>
              <span class="pp-down__dash" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="st-label st-label--accent">{c.staysTitle}</h3>
        <ul class="st-rules pp-down__list">
          {c.stays.map((item) => (
            <li class="is-open">
              <HomeIcon name="check" size={14} class="pp-down__mark" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pp-down__head {
    margin-bottom: 0;
  }

  .pp-down__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .pp-down__cols h3 {
    display: block;
    margin: 0 0 12px;
  }

  .pp-down__list li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    color: var(--color-ink-3);
  }

  .pp-down__list li.is-open {
    color: var(--color-ink);
  }

  .pp-down__dash {
    width: 12px;
    height: 1px;
    background: var(--color-ink-4);
    align-self: center;
  }

  .pp-down__list :global(.pp-down__mark) {
    align-self: center;
    color: var(--color-electric-500);
  }

  @media (max-width: 560px) {
    .pp-down__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
