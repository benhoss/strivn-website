---
import type { Locale, PricingContent, PricingPlan } from '../../data/pricingContent';
import HomeIcon from '../home/HomeIcon.astro';
import { planPrice } from '../../lib/planPrice';
import { appStartUrl } from '../../lib/appUrl';

interface Props {
  locale: Locale;
  plans: PricingContent['plans'];
  matrix: PricingContent['matrix'];
  email: string;
}

const { locale, plans: c, matrix, email } = Astro.props;

/**
 * Every tier that has a price leads to registration, and that is honest even
 * though none of them can be bought: a new account opens on a 30-day Semi-Pro
 * trial, so signing up genuinely delivers the tier. The quoted tier leads to a
 * person, because a tier without an amount opens no checkout at all.
 */
const ctaHref = (plan: PricingPlan): string =>
  plan.kind === 'app'
    ? appStartUrl(locale)
    : `mailto:${email}?subject=${encodeURIComponent(`STRIVN ${plan.name}`)}`;
---

<section id="plans" class="st-sec" aria-labelledby="plans-title">
  <div class="st-wrap">
    <div class="st-head">
      <span class="st-label st-eyebrow">{c.kicker}</span>
      <h2 id="plans-title" class="st-h2">{c.title}</h2>
    </div>

    {/* One bordered object, four columns. Each tier is a subgrid over the
        same six rows, so names, prices, promises and buttons line up across
        the strip however long a feature list runs. */}
    <div class="pp-tiers">
      {c.items.map((plan) => {
        const price = planPrice(plan.code, locale, c, plan.quotePrice);
        return (
          <article class:list={['pp-tier', { 'is-featured': plan.featured }]} aria-labelledby={`tier-${plan.code}`}>
            <div class="pp-tier__name">
              <h3 id={`tier-${plan.code}`}>{plan.name}</h3>
              <span class:list={['st-tag', { 'st-tag--accent': plan.featured }]}>{plan.badge}</span>
            </div>

            <p class="pp-price">
              <span class="pp-price__p">{price.headline}</span>
              {price.struck && (
                <s class="pp-price__s">
                  <span class="pp-sr">{c.fullMonthlyLabel} </span>
                  {price.struck}
                </s>
              )}
              {price.period && <span class="pp-price__per">{price.period}</span>}
            </p>

            <p class="pp-billed">
              {price.billed}
              {price.bonus && <> · {price.bonus}</>}
            </p>

            <div class="pp-tier__promise">
              <p class="st-h4">{plan.promise}.</p>
              <p class="st-small pp-tier__qual">{plan.qualifier}</p>
            </div>

            <ul class="pp-feats">
              {plan.inherits && <li class="pp-feats__inherits">{plan.inherits}</li>}
              {plan.features.map((f) => (
                <li>
                  <HomeIcon name="check" size={13} class="pp-feats__mark" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a
              href={ctaHref(plan)}
              target={plan.kind === 'app' ? '_blank' : undefined}
              rel={plan.kind === 'app' ? 'noopener' : undefined}
              class:list={['st-btn st-btn--sm pp-tier__cta', plan.featured ? 'st-btn--primary' : 'st-btn--ghost']}
            >
              {plan.cta}
            </a>
          </article>
        );
      })}
    </div>

    <div class="pp-line">
      <p class="pp-line__gps">
        <span>{c.gpsLine.semi}</span>
        <span>
          {c.gpsLine.pro}
          <span class="st-tag">{matrix.cells.upcoming}</span>
        </span>
      </p>
      <a href="#compare" class="st-link">{matrix.title.replace(/\.$/, '')}</a>
    </div>

    <p class="st-small pp-note">{c.note}</p>
  </div>
</section>

<style>
  .pp-tiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: auto;
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    overflow: hidden;
  }

  .pp-tier {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 14px;
    padding: 24px;
    min-width: 0;
  }

  .pp-tier + .pp-tier {
    border-left: 1px solid var(--color-line);
  }

  .pp-tier.is-featured {
    background: var(--color-navy-850);
  }

  .pp-tier__name {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .pp-tier__name h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    font-variation-settings: 'wdth' 85;
    color: var(--color-ink);
  }

  .pp-tier.is-featured .st-tag {
    white-space: normal;
  }

  .pp-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    margin: 4px 0 0;
  }

  .pp-price__p {
    font-weight: 600;
    font-variation-settings: 'wdth' 78;
    font-size: clamp(34px, 3vw, 40px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .pp-price__s {
    color: var(--color-ink-4);
    font-size: 14px;
  }

  .pp-price__per {
    color: var(--color-ink-3);
    font-size: 13.5px;
  }

  .pp-billed {
    margin: -6px 0 0;
    min-height: 1.4em;
    font-size: 12.5px;
    color: var(--color-ink-3);
  }

  .pp-tier__promise {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .pp-tier__qual {
    color: var(--color-ink-3);
  }

  .pp-feats {
    list-style: none;
    margin: 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--color-line);
    display: grid;
    gap: 9px;
    align-content: start;
  }

  .pp-feats li {
    display: grid;
    grid-template-columns: 13px minmax(0, 1fr);
    gap: 10px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  .pp-feats .pp-feats__inherits {
    display: block;
    padding-bottom: 2px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .pp-feats :global(.pp-feats__mark) {
    margin-top: 3px;
    color: var(--color-ink-4);
  }

  .pp-tier.is-featured :global(.pp-feats__mark) {
    color: var(--color-electric-500);
  }

  .pp-tier__cta {
    align-self: end;
    width: 100%;
    margin-top: 6px;
  }

  .pp-line {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    font-size: 14px;
    color: var(--color-ink-2);
  }

  .pp-line__gps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
  }

  .pp-line__gps .st-tag {
    margin-left: 6px;
    vertical-align: 1px;
  }

  .pp-note {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    max-width: 72ch;
    color: var(--color-ink-3);
  }

  /* The struck figure needs a name in the accessibility tree: read alone,
     "249 €" beside "207,50 €" is two prices with no relationship. */
  .pp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 1080px) {
    .pp-tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pp-tier:nth-child(3) {
      border-left: 0;
    }

    .pp-tier:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
  }

  @media (max-width: 620px) {
    .pp-tiers {
      grid-template-columns: minmax(0, 1fr);
    }

    .pp-tier + .pp-tier {
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }

    .pp-tier {
      padding: 22px 20px;
    }
  }
</style>
