---
import type { Cell, Locale, PlanCode, PricingContent } from '../../data/pricingContent';
import { MATRIX, formatCount } from '../../data/pricingContent';
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  locale: Locale;
  matrix: PricingContent['matrix'];
}

const { locale, matrix: c } = Astro.props;

const PLAN_ORDER: PlanCode[] = ['free', 'amateur', 'semi_pro', 'pro'];
/** Semi-Pro is the featured column; the tint runs the full height of the table. */
const FEATURED_INDEX = 2;

/**
 * A row where all four tiers agree carries no decision. It still belongs in the
 * table — a reader wants to know the player app is in every tier — but it is
 * not what they came to find, so it recedes. The rows that differ are the ones
 * that answer "which tier do I need", and they get the contrast.
 */
const isUniform = (cells: readonly Cell[]) => cells.every((cell) => cell === cells[0]);
---

<section id="compare" class="st-sec" aria-labelledby="matrix-title">
  <div class="st-wrap">
    <div class="st-head">
      <span class="st-label st-eyebrow">{c.kicker}</span>
      <h2 id="matrix-title" class="st-h2">{c.title}</h2>
      <p class="pm-hint st-label">{c.scrollHint}</p>
    </div>

    <div class="pm-scroll" role="region" tabindex="0" aria-labelledby="matrix-title">
      <table class="pm">
        <caption>{c.caption}</caption>
        <thead>
          <tr>
            <th scope="col" class="pm__corner"><span class="pm__sr">{c.caption}</span></th>
            {PLAN_ORDER.map((code, i) => (
              <th scope="col" class={i === FEATURED_INDEX ? 'pm__head is-featured' : 'pm__head'}>
                {c.planNames[code]}
              </th>
            ))}
          </tr>
        </thead>

        {MATRIX.map((group) => (
          <tbody>
            <tr class="pm__grouprow">
              <th scope="rowgroup" colspan={PLAN_ORDER.length + 1}>
                <span class="pm__grouplabel">{c.groups[group.key]}</span>
              </th>
            </tr>
            {group.rows.map((row) => (
              <tr data-uniform={isUniform(row.cells) ? '' : undefined}>
                <th scope="row">{c.rows[row.key]}</th>
                {row.cells.map((cell, i) => (
                  <td class={i === FEATURED_INDEX ? 'is-featured' : undefined}>
                    {cell === true && (
                      <>
                        <HomeIcon name="check" size={15} class="pm__mark" />
                        <span class="pm__sr">{c.yes}</span>
                      </>
                    )}
                    {cell === false && (
                      <>
                        <span class="pm__no" aria-hidden="true"></span>
                        <span class="pm__sr">{c.no}</span>
                      </>
                    )}
                    {typeof cell === 'number' && <span class="pm__word st-num">{formatCount(cell, locale)}</span>}
                    {typeof cell === 'string' && (
                      <span class={cell === 'upcoming' ? 'st-tag' : 'pm__word'}>{c.cells[cell]}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>
</section>

<style>
  .pm-hint {
    color: var(--color-ink-4);
  }

  @media (min-width: 52rem) {
    .pm-hint {
      display: none;
    }
  }

  /* The table lives in its own horizontal scroller so the page never
     scrolls sideways. Paint containment clips the sticky cells to it. */
  .pm-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    contain: paint;
    border-top: 1px solid var(--color-line-strong);
  }

  .pm-scroll:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 3px;
  }

  /* `overflow-x: auto` makes the box a scroll container in both axes, so a
     sticky header inside it would pin to a box that never scrolls
     vertically. Where the table fits, drop the scroller and let the header
     stick under the site header across all 31 rows. */
  @media (min-width: 52rem) {
    .pm-scroll {
      overflow: visible;
      contain: none;
    }
  }

  .pm {
    width: 100%;
    min-width: 46rem;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14.5px;
  }

  .pm caption,
  .pm__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .pm th,
  .pm td {
    border-bottom: 1px solid var(--color-line);
    padding: 12px 14px;
    vertical-align: middle;
  }

  /* Row labels stay put while the tiers scroll past on narrow screens. */
  .pm th[scope='row'],
  .pm__corner {
    position: sticky;
    left: 0;
    z-index: 1;
    width: 38%;
    background: var(--color-void);
    padding-left: 0;
    text-align: left;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  .pm__head,
  .pm__corner {
    position: sticky;
    top: var(--st-header);
    z-index: 2;
    background: var(--color-void);
    padding-block: 16px;
    text-align: center;
    font-family: var(--font-sans);
    font-variation-settings: 'wdth' 85;
    font-weight: 600;
    font-size: 17px;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .pm__corner {
    z-index: 3;
  }

  .pm td {
    text-align: center;
    color: var(--color-ink);
  }

  /* The featured tier reads as one continuous band through the whole table. */
  .pm .is-featured {
    background: var(--color-navy-900);
  }

  .pm thead .is-featured {
    background: var(--color-navy-850);
    box-shadow: inset 0 2px 0 var(--color-electric);
  }

  .pm :global(.pm__mark) {
    display: inline-block;
    vertical-align: middle;
    color: var(--color-ink-2);
  }

  .pm .is-featured :global(.pm__mark) {
    color: var(--color-electric-500);
  }

  /* "Not included" is drawn, not written: a dash reads as absence at a
     glance where an X reads as an error. Screen readers get the words. */
  .pm__no {
    display: inline-block;
    width: 12px;
    height: 1px;
    background: var(--color-ink-4);
    vertical-align: middle;
  }

  .pm__word {
    font-size: 13.5px;
    color: var(--color-ink);
  }

  /* Rows every tier shares recede; the rows that differ answer the
     question the reader came with. */
  .pm tr[data-uniform] th[scope='row'] {
    color: var(--color-ink-3);
  }

  .pm tr[data-uniform] :global(.pm__mark),
  .pm tr[data-uniform] .is-featured :global(.pm__mark) {
    color: var(--color-ink-4);
  }

  .pm tr[data-uniform] .pm__word {
    color: var(--color-ink-3);
  }

  .pm__grouprow th {
    padding: 32px 0 10px;
    background: var(--color-void);
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-line-strong);
  }

  /* The group cell spans the table, so pin its label instead: the section
     keeps naming itself however far right the reader has scrolled. */
  .pm__grouplabel {
    position: sticky;
    left: 0;
    display: inline-block;
  }

  /* Phone: narrow the pinned label so two tier columns clear the fold at
     once. The comparison only works when two columns sit side by side. */
  @media (max-width: 47.99rem) {
    .pm {
      min-width: 33rem;
      font-size: 13px;
    }

    .pm th[scope='row'],
    .pm__corner {
      width: auto;
      min-width: 9rem;
      max-width: 9rem;
      padding-right: 10px;
      box-shadow: 1px 0 0 var(--color-line-strong);
    }

    .pm th,
    .pm td {
      padding: 10px 8px;
    }

    .pm__head,
    .pm__corner {
      top: 0;
      padding-block: 12px;
      font-size: 15px;
    }

    .pm__word {
      font-size: 12.5px;
    }

    .pm__grouprow th {
      padding-top: 24px;
    }
  }
</style>
