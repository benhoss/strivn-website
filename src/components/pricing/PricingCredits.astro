---
import { MATRIX, formatCount, type Locale, type PlanCode, type PricingContent } from '../../data/pricingContent';

interface Props {
  locale: Locale;
  credits: PricingContent['credits'];
  matrix: PricingContent['matrix'];
}

const { locale, credits: c, matrix } = Astro.props;

const PLAN_ORDER: PlanCode[] = ['free', 'amateur', 'semi_pro', 'pro'];

/** The allowances come from the matrix row the pricing check validates, so
 *  this section can never quote a figure the table does not. */
const aiRow = MATRIX.flatMap((g) => g.rows).find((r) => r.key === 'aiCalls')!;
const rows = PLAN_ORDER.map((code, i) => {
  const cell = aiRow.cells[i];
  return {
    code,
    name: matrix.planNames[code],
    value: typeof cell === 'number' ? formatCount(cell, locale) : matrix.cells.unlimited,
  };
});
---

<section class="st-sec" aria-labelledby="credits-title">
  <div class="st-wrap st-split st-split--top">
    <div class="st-head pp-credits__head">
      <span class="st-label st-eyebrow">{c.kicker}</span>
      <h2 id="credits-title" class="st-h2 st-h2--sm">{c.title}</h2>
      <p class="st-body">{c.body}</p>
      <p class="st-small pp-credits__note">{c.note}</p>
    </div>

    <div class="st-panel">
      <div class="st-panel__bar">
        <span class="st-label">{matrix.rows.aiCalls}</span>
      </div>
      <ul class="pp-credits__rows">
        {rows.map((r) => (
          <li class:list={{ 'is-featured': r.code === 'semi_pro' }}>
            <span>{r.name}</span>
            <span class="st-num pp-credits__v">{r.value}</span>
          </li>
        ))}
      </ul>
      <p class="pp-credits__reset st-label">{c.reset}</p>
    </div>
  </div>
</section>

<style>
  .pp-credits__head {
    margin-bottom: 0;
  }

  .pp-credits__note {
    color: var(--color-ink-3);
    padding-top: 16px;
    border-top: 1px solid var(--color-line);
    max-width: 52ch;
  }

  .pp-credits__rows {
    list-style: none;
    margin: 0;
    padding: 0 20px;
  }

  .pp-credits__rows li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 15px;
    color: var(--color-ink-2);
  }

  .pp-credits__v {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .pp-credits__reset {
    margin: 0;
    padding: 14px 20px 16px;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 12px;
  }
</style>
