---
import type { Locale } from '../../data/pricingContent';
import HomeIcon from '../home/HomeIcon.astro';
import { appStartUrl } from '../../lib/appUrl';

/**
 * The closing band, after the homepage's final CTA: the statement on the
 * left, the sentence and the self-serve / human pair on the right. The
 * clubs and youth pages close with it too.
 */
interface Props {
  locale: Locale;
  title: string;
  sub: string;
  primary: string;
  /** Human CTA. Omitted where the page has only the self-serve action. */
  secondary?: string;
  email?: string;
  /** "Sans carte bancaire. Sans engagement." → one fine-print item per sentence. */
  trust?: string;
}

const { locale, title, sub, primary, secondary, email, trust } = Astro.props;

const fine = (trust ?? '')
  .split(/\.\s*/)
  .map((s) => s.trim())
  .filter(Boolean);
---

<section class="st-sec pp-final" aria-labelledby="final-cta-title">
  <div class="st-wrap pp-final__in">
    <h2 id="final-cta-title" class="st-display pp-final__title">{title}</h2>
    <div class="pp-final__side">
      <p class="st-lede">{sub}</p>
      <div class="st-ctas">
        <a href={appStartUrl(locale)} target="_blank" rel="noopener" class="st-btn st-btn--primary">
          {primary}
          <HomeIcon name="arrow-right" size={16} />
        </a>
        {secondary && email && (
          <a href={`mailto:${email}`} class="st-btn st-btn--ghost">{secondary}</a>
        )}
      </div>
      {fine.length > 0 && <p class="st-fine">{fine.map((f) => <span>{f}</span>)}</p>}
    </div>
  </div>
</section>

<style>
  .pp-final {
    padding-block: clamp(80px, 11vw, 144px);
  }

  .pp-final__in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
    align-items: end;
  }

  .pp-final__title {
    font-size: clamp(40px, 6vw, 80px);
  }

  .pp-final__side {
    display: grid;
    gap: 24px;
  }

  @media (max-width: 1000px) {
    .pp-final__in {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
