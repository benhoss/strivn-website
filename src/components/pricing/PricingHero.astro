---
import type { Locale, PricingContent } from '../../data/pricingContent';
import PricingTrial from './PricingTrial.astro';

interface Props {
  locale: Locale;
  hero: PricingContent['hero'];
  trial: PricingContent['trial'];
  cta: PricingContent['cta'];
}

const { locale, hero: c, trial, cta } = Astro.props;
---

<section class="st-grid-bg pp-hero" aria-labelledby="pricing-hero-title">
  <div class="st-wrap st-split st-split--wide-left">
    <div class="pp-hero__copy">
      <nav class="st-crumbs" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>STRIVN</a>
        <span aria-current="page">{c.kicker}</span>
      </nav>
      <h1 id="pricing-hero-title" class="st-h1">{c.title}</h1>
      <p class="st-lede">{c.sub}</p>
    </div>

    <PricingTrial locale={locale} trial={trial} cta={cta} />
  </div>
</section>

<style>
  .pp-hero {
    padding-block: clamp(56px, 8vw, 112px) clamp(56px, 7vw, 96px);
  }

  .pp-hero__copy {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .pp-hero__copy .st-h1 {
    max-width: 16ch;
  }
</style>
