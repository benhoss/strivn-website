---
import type { PricingContent } from '../../data/pricingContent';

interface Props {
  faq: PricingContent['faq'];
}

const { faq: c } = Astro.props;

/** French puts a space before « ? » ; keep it from wrapping alone. */
const nb = (t: string) => t.replace(/ ([?!:;»])/g, '\u00a0$1');

/** Two hairline columns, as on the homepage; the first column takes the odd
 *  item so the longer half sits on the left. */
const half = Math.ceil(c.items.length / 2);
const columns = [c.items.slice(0, half), c.items.slice(half)];
---

<section id="faq" class="st-sec" aria-labelledby="pricing-faq-title">
  <div class="st-wrap">
    <div class="st-head">
      <span class="st-label st-eyebrow">{c.kicker}</span>
      <h2 id="pricing-faq-title" class="st-h2">{c.title}</h2>
      <p class="st-body">{c.body}</p>
    </div>

    <div class="pp-faq">
      {columns.map((items, col) => (
        <div class="st-faq">
          {items.map((item, i) => (
            <details open={col === 0 && i === 0}>
              <summary>{nb(item.q)}</summary>
              <p>{nb(item.a)}</p>
            </details>
          ))}
        </div>
      ))}
    </div>

    <p class="pp-faq__contact">
      <span class="st-h4">{c.contactTitle}</span>
      <span class="st-small">{c.contactBody}</span>
      <a href={`mailto:${c.email}`} class="st-link st-num">{c.email}</a>
    </p>
  </div>
</section>

<style>
  .pp-faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
    align-items: start;
  }

  .pp-faq__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin: 32px 0 0;
  }

  @media (max-width: 860px) {
    .pp-faq {
      grid-template-columns: minmax(0, 1fr);
    }

    /* One column: the second list continues the first, one rule between. */
    .pp-faq > .st-faq + .st-faq {
      border-top: 0;
    }
  }
</style>
