---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import WaitlistForm from './WaitlistForm.astro';
import PricingCta from './pricing/PricingCta.astro';
import { type Locale } from '../data/landingContent';
import { clubsContent } from '../data/clubsContent';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = clubsContent[locale];

const base = `/${locale}`;
const canonicalPath = `${base}/clubs/`;
const switchHrefs = { en: '/en/clubs/', fr: '/fr/clubs/', nl: '/nl/clubs/', de: '/de/clubs/', pt: '/pt/clubs/', es: '/es/clubs/' };
const alternates = [
  { hreflang: 'en', href: switchHrefs.en },
  { hreflang: 'fr', href: switchHrefs.fr },
  { hreflang: 'nl', href: switchHrefs.nl },
  { hreflang: 'de', href: switchHrefs.de },
  { hreflang: 'pt', href: switchHrefs.pt },
  { hreflang: 'es', href: switchHrefs.es },
  { hreflang: 'x-default', href: switchHrefs.fr },
];

const site = 'https://strivn.net';
const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'STRIVN', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: c.eyebrow, item: `${site}${canonicalPath}` },
    ],
  },
];
---

<SubpageLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={jsonLdExtra}
  switchHrefs={switchHrefs}
>
  <section class="st-grid-bg cl-hero" aria-labelledby="clubs-title">
    <div class="st-wrap cl-hero__in">
      <nav class="st-crumbs" aria-label="Breadcrumb">
        <a href={`${base}/`}>STRIVN</a>
        <span aria-current="page">{c.crumb}</span>
      </nav>
      <h1 id="clubs-title" class="st-h1">{c.hero.title}</h1>
      <p class="st-lede">{c.hero.lede}</p>
      <div class="cl-hero__actions">
        <a href="#waitlist" class="st-btn st-btn--primary">{c.form.submit}</a>
        <span class="st-tag st-tag--accent">{c.hero.status}</span>
      </div>
    </div>
  </section>

  <!-- What the Club plan adds: five rows, one hairline each. Not a
       sequence, so no rail. -->
  <section class="st-sec" aria-labelledby="clubs-benefits">
    <div class="st-wrap">
      <div class="st-head">
        <h2 id="clubs-benefits" class="st-h2">{c.benefits.title}</h2>
      </div>
      <ol class="cl-list">
        {c.benefits.items.map((item, i) => (
          <li>
            <span class="st-label cl-list__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="st-h3">{item.title}</h3>
            <p class="st-body">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="st-sec" id="waitlist" aria-labelledby="clubs-waitlist">
    <div class="st-wrap st-split st-split--top cl-wait">
      <div class="st-head cl-wait__head">
        <h2 id="clubs-waitlist" class="st-h2 st-h2--sm">{c.form.title}</h2>
        <p class="st-body">{c.form.body}</p>
      </div>
      <div class="st-block cl-wait__form">
        <WaitlistForm locale={locale} />
      </div>
    </div>
  </section>

  <PricingCta locale={locale} title={c.finalCta.title} sub={c.finalCta.body} primary={c.finalCta.cta} />
</SubpageLayout>

<style>
  .cl-hero {
    padding-block: clamp(56px, 8vw, 112px) clamp(56px, 7vw, 96px);
  }

  .cl-hero__in {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .cl-hero__in .st-h1 {
    max-width: 18ch;
  }

  .cl-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 8px;
  }

  .cl-hero__actions .st-tag {
    white-space: normal;
  }

  .cl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .cl-list li {
    display: grid;
    grid-template-columns: 64px minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: 12px 32px;
    align-items: baseline;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .cl-list__n {
    color: var(--color-ink-4);
  }

  .cl-wait__head {
    margin-bottom: 0;
  }

  .cl-wait__form {
    padding: clamp(20px, 3vw, 32px);
  }

  @media (max-width: 820px) {
    .cl-list li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .cl-list li .st-body {
      grid-column: 2;
    }
  }
</style>
