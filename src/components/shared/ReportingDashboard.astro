---
/**
 * The composable "Load & availability" dashboard surface.
 *
 * Shared by the S&C reporting section and the features index. Chart data is
 * locale-invariant (`WEEKLY_BARS`, `HSR_BARS`); only labels come from the
 * caller's locale. Bars are drawn to scale in CSS and are complete at rest.
 */
import type { ScPageContent } from '../../data/scPageContent';
import { WEEKLY_BARS, HSR_BARS } from '../../data/scPageContent';
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  dashboard: ScPageContent['reports']['dashboard'];
  class?: string;
  style?: string;
}

const { dashboard: d, class: className = '', style } = Astro.props;

const toneClass: Record<string, string> = {
  green: 'text-ready',
  orange: 'text-watch',
  coral: 'text-risk',
  blue: 'text-ink',
  plain: 'text-ink',
};

const availabilityPct = Number.parseInt(d.availabilityValue, 10) || 0;
---

<div class={`rd st-panel st-panel--float ${className}`} style={style}>
  <div class="st-panel__bar">
    <span class="rd__title">
      <HomeIcon name="layout-dashboard" size={15} class="text-ink-3" />
      {d.title}
    </span>
    <span class="rd__tools" aria-hidden="true">
      <span class="st-tag">+ {d.widgetBtn}</span>
      <span class="st-tag st-tag--accent"><HomeIcon name="sparkles" size={11} />{d.aiBtn}</span>
    </span>
  </div>

  <dl class="rd__kpis">
    {d.kpis.map((kpi) => (
      <div class="st-kpi">
        <dt class="st-label">{kpi.label}</dt>
        <dd class={`st-kpi__v ${toneClass[kpi.tone] ?? 'text-ink'}`}>{kpi.value}</dd>
      </div>
    ))}
  </dl>

  <div class="rd__grid">
    <div class="rd__cell">
      <p class="rd__h">{d.weekly}</p>
      <div class="rd__weekly" aria-hidden="true">
        {WEEKLY_BARS.map((h, i) => (
          <span class:list={['rd__bar', { 'is-now': i === WEEKLY_BARS.length - 1 }]} style={`height: ${h}%;`}></span>
        ))}
      </div>
    </div>

    <div class="rd__cell">
      <p class="rd__h">{d.availability}</p>
      <p class="rd__avail st-num">{d.availabilityValue}</p>
      <span class="st-meter" aria-hidden="true">
        <i style={`width: ${availabilityPct}%; background: var(--color-ready);`}></i>
      </span>
    </div>

    <div class="rd__cell rd__cell--wide">
      <div class="rd__hsrhead">
        <p class="rd__h">{d.hsr}</p>
        <span class="st-tag st-tag--accent"><HomeIcon name="sparkles" size={10} />{d.aiTag}</span>
      </div>
      <div class="rd__hsr" aria-hidden="true">
        {HSR_BARS.map(([a, b]) => (
          <div class="rd__pair">
            <span class="rd__bar rd__bar--prev" style={`height: ${a * 2}%;`}></span>
            <span class="rd__bar is-now" style={`height: ${b * 2}%;`}></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .rd {
    container-type: inline-size;
    text-align: left;
  }
  .rd__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .rd__tools {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }
  .rd__kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin: 0;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-line);
  }
  .rd__kpis dd {
    margin: 0;
  }
  .rd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }
  .rd__cell {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-line);
    min-width: 0;
  }
  .rd__cell + .rd__cell {
    border-left: 1px solid var(--color-line);
  }
  .rd__cell--wide {
    grid-column: 1 / -1;
    border-left: 0 !important;
    border-bottom: 0;
  }
  .rd__h {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-2);
  }
  .rd__weekly,
  .rd__hsr {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 76px;
    border-bottom: 1px solid var(--color-line-strong);
  }
  .rd__hsr {
    gap: 14px;
    height: 64px;
  }
  .rd__bar {
    flex: 1;
    display: block;
    border-radius: 3px 3px 0 0;
    background: var(--color-navy-700);
  }
  .rd__bar.is-now {
    background: var(--color-electric);
  }
  .rd__bar--prev {
    background: var(--color-navy-500);
  }
  .rd__pair {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
  }
  .rd__pair .rd__bar {
    flex: 0 1 12px;
  }
  .rd__avail {
    margin: 0;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .rd__hsrhead {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }
  @container (max-width: 480px) {
    .rd__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .rd__cell + .rd__cell {
      border-left: 0;
    }
    .rd__kpis {
      padding: 16px;
      gap: 14px 24px;
    }
    .rd__cell {
      padding: 16px;
    }
    .rd__tools {
      margin-left: 0;
    }
  }
</style>
