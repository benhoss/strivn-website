---
/**
 * The "readiness of the day" product surface.
 *
 * Shared by the S&C hero and the features index: same screen, same numbers,
 * so it must not drift between the two pages. Row data is locale-invariant
 * (`BOARD_ROWS`, `WHY_VALUES`); only the labels come from the caller's locale.
 *
 * `why` adds the evidence panel for the flagged player (L. Moreau) beside the
 * roster. The panel sizes itself on the board's own width (container query),
 * so it works in a full-width hero and in a 600px column alike.
 *
 * Colour: ready / watch / risk only describe a player. Everything else is ink.
 */
import type { ScPageContent } from '../../data/scPageContent';
import { BOARD_ROWS, WHY_VALUES } from '../../data/scPageContent';

interface Props {
  board: ScPageContent['hero']['board'];
  /** Extra classes for the outer frame. */
  class?: string;
  /** Inline style for the outer frame. */
  style?: string;
  /** Kept for compatibility. The board renders its final numbers at rest. */
  countFrom?: number;
  /** Show the "why" evidence panel for the flagged player. */
  why?: boolean;
}

const { board, class: className = '', style, why = false } = Astro.props;

type Tone = 'green' | 'orange' | 'coral' | 'blue' | 'plain';
const toneClass: Record<Tone, string> = {
  green: 'text-ready',
  orange: 'text-watch',
  coral: 'text-risk',
  blue: 'text-ink',
  plain: 'text-ink',
};
const meterColor: Record<Tone, string> = {
  green: 'var(--color-ready)',
  orange: 'var(--color-watch)',
  coral: 'var(--color-risk)',
  blue: 'var(--color-ink-3)',
  plain: 'var(--color-ink-3)',
};
const chipClass = {
  ready: 'st-chip--ready',
  reduce: 'st-chip--risk',
  monitor: 'st-chip--watch',
  protocol: 'st-chip--wait',
} as const;

/** Old content objects (before the protocol row existed) still render. */
const statusLabel = (s: keyof typeof chipClass) => board.status[s] ?? board.status.monitor;
const flagged = 'L. Moreau';
const showWhy = why && !!board.why;
---

<div class={`rb st-panel st-panel--float ${className}`} style={style}>
  <div class="st-panel__bar">
    <span class="rb__title">{board.title}</span>
    <span class="st-label rb__stamp">{board.stamp}</span>
  </div>

  <dl class="rb__kpis">
    {board.kpis.map((kpi) => (
      <div class="st-kpi">
        <dt class="st-label">{kpi.label}</dt>
        <dd class={`st-kpi__v ${toneClass[kpi.tone as Tone]}`}>{kpi.value}</dd>
      </div>
    ))}
  </dl>

  <div class:list={['rb__cols', { 'rb__cols--why': showWhy }]}>
    <ul class="rb__roster">
      {BOARD_ROWS.map((row) => (
        <li class:list={['rb__row', { 'is-flagged': showWhy && row.name === flagged }]}>
          <span class="rb__name">{row.name}</span>
          <span class="st-meter rb__meter" aria-hidden="true">
            <i style={`width: ${row.bar}%; background: ${meterColor[row.tone as Tone]};`}></i>
          </span>
          <span class={`st-num rb__score ${row.status === 'protocol' ? 'text-ink-4' : toneClass[row.tone as Tone]}`}>{row.value}</span>
          <span class="st-num rb__acwr">{row.acwr}</span>
          <span class={`st-chip ${chipClass[row.status]} rb__chip`}>{statusLabel(row.status)}</span>
        </li>
      ))}
    </ul>

    {showWhy && board.why && (
      <aside class="rb__why" aria-label={board.why.title}>
        <div class="rb__whyhead">
          <h3 class="st-h4">{board.why.title}</h3>
          <span class="st-label">{board.why.score}</span>
        </div>
        <dl class="rb__evidence">
          {board.why.evidence.map((label, i) => (
            <div>
              <dt>{label}</dt>
              <dd class={`st-num ${toneClass[(WHY_VALUES[i]?.tone ?? 'plain') as Tone]}`}>{WHY_VALUES[i]?.value}</dd>
            </div>
          ))}
        </dl>
        <div class="st-proposal">
          <span class="st-tag st-tag--accent rb__tag">{board.why.tag}</span>
          <p class="rb__proposal">{board.why.proposal}</p>
          <div class="rb__actions" aria-hidden="true">
            <span class="rb__mini rb__mini--primary">{board.why.apply}</span>
            <span class="rb__mini">{board.why.edit}</span>
          </div>
        </div>
        <p class="st-label rb__sources">{board.why.sources}</p>
      </aside>
    )}
  </div>
</div>

<style>
  .rb {
    container-type: inline-size;
    text-align: left;
  }
  .rb__title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .rb__stamp {
    margin-left: auto;
  }
  .rb__kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin: 0;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-line);
  }
  .rb__kpis dd {
    margin: 0;
  }
  .rb__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .rb__roster {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }
  .rb__row {
    display: grid;
    grid-template-columns: minmax(96px, 128px) minmax(40px, 1fr) 28px 44px 108px;
    gap: 14px;
    align-items: center;
    padding: 11px 20px;
    border-bottom: 1px solid var(--color-line);
    font-size: 14px;
  }
  .rb__row:last-child {
    border-bottom: 0;
  }
  .rb__row.is-flagged {
    background: var(--color-navy-900);
  }
  .rb__name {
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rb__score,
  .rb__acwr {
    font-size: 12.5px;
    text-align: right;
  }
  .rb__acwr {
    color: var(--color-ink-3);
  }
  .rb__chip {
    justify-self: end;
  }
  .rb__why {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 20px;
    border-top: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .rb__whyhead {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: baseline;
    justify-content: space-between;
  }
  .rb__evidence {
    display: grid;
    margin: 0;
  }
  .rb__evidence > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 13.5px;
    color: var(--color-ink-2);
  }
  .rb__evidence dd {
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
  }
  .rb__tag {
    justify-self: start;
  }
  .rb__proposal {
    margin: 0;
    color: var(--color-ink);
  }
  .rb__actions {
    display: flex;
    gap: 8px;
  }
  .rb__mini {
    font: 500 12.5px/1 var(--font-sans);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
  }
  .rb__mini--primary {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }
  .rb__sources {
    margin: 0;
    font-size: 10px;
    color: var(--color-ink-4);
  }

  /* Wide board: evidence panel sits beside the roster. */
  @container (min-width: 880px) {
    .rb__cols--why {
      grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
    }
    .rb__cols--why .rb__why {
      border-top: 0;
      border-left: 1px solid var(--color-line);
      padding: 22px 24px;
    }
    .rb__row {
      padding-inline: 24px;
    }
    .rb__kpis {
      padding-inline: 24px;
    }
  }
  /* Narrow board (phone, small column): meter drops to its own line. */
  @container (max-width: 520px) {
    .rb__row {
      grid-template-columns: minmax(0, 1fr) 28px auto;
      gap: 8px 12px;
      padding: 12px 16px;
    }
    .rb__meter {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .rb__acwr {
      display: none;
    }
    .rb__kpis {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 16px;
      padding: 16px;
    }
    .rb__kpis .st-kpi__v {
      font-size: 20px;
    }
    .rb__why {
      padding: 16px;
    }
  }
</style>
