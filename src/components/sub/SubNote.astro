---
/**
 * Wide aside — a short label on the left, the explanation on the right.
 * Shared by the standalone `note` section and every section's trailing slot.
 */
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  label: string;
  desc: string;
  icon?: string;
  class?: string;
}

const { label, desc, icon, class: className = '' } = Astro.props;
---

<div
  class={`grid gap-x-7 gap-y-2.5 border-t border-[#FFFFFF14] pt-7 md:grid-cols-[minmax(0,300px)_minmax(0,1fr)] md:items-start ${className}`}
>
  <h3 class="flex items-center gap-2.5 text-[0.97rem] leading-[1.3] font-semibold text-[#F8FAFC]">
    {
      icon && (
        <span class="shrink-0 text-[#7AB8FF]">
          <HomeIcon name={icon} size={15} />
        </span>
      )
    }
    {label}
  </h3>
  <p class="max-w-[62ch] text-[0.84rem] leading-[1.63] text-[#68779A]">{desc}</p>
</div>
