---
/**
 * Wide aside: a short label on the left, the explanation on the right, under
 * one hairline. Shared by the standalone `note` section and every section's
 * trailing slot.
 */
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  label: string;
  desc: string;
  icon?: string;
  class?: string;
}

const { label, desc, icon, class: className = '' } = Astro.props;
---

<div class:list={['sub-note', className]}>
  <h3 class="st-h4 sub-note__label">
    {
      icon && (
        <span class="sub-note__ico">
          <HomeIcon name={icon} size={15} />
        </span>
      )
    }
    {label}
  </h3>
  <p class="sub-note__desc">{desc}</p>
</div>

<style>
  .sub-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 40px;
    padding-top: 22px;
    border-top: 1px solid var(--color-line-strong);
  }
  .sub-note__label {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sub-note__ico {
    flex: none;
    color: var(--color-ink-3);
    transform: translateY(2px);
  }
  .sub-note__desc {
    margin: 0;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  @media (min-width: 761px) {
    .sub-note {
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    }
  }
</style>
