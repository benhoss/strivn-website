---
/**
 * Load-unit conversion strip: what the coach types, what STRIVN stores, what
 * the staff reads, then the two settings that define the conversion.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].unit;

/** The third step is the one the staff actually reads: it is set in full ink. */
const stepInk = ['ink-2', 'ink-3', 'ink-1'];
---

<CaptureFrame>
  <div class="unit">
    <div class="unit__steps">
      {
        t.steps.map((st, i) => (
          <>
            {i > 0 && (
              <span class="unit__arrow" aria-hidden="true">
                <HomeIcon name="arrow-right" size={16} stroke={1.5} />
              </span>
            )}
            <div class="st-kpi">
              <span class="st-label">{st.k}</span>
              <span class={`st-kpi__v whitespace-nowrap ${stepInk[i]}`}>{st.v}</span>
            </div>
          </>
        ))
      }
    </div>

    <ul class="unit__fields">
      {
        t.fields.map((fl) => (
          <li>
            <p class="cap-k">{fl.k}</p>
            <p class="cap-field">{fl.v}</p>
          </li>
        ))
      }
    </ul>
  </div>
</CaptureFrame>

<style>
  .unit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: 8px 4px;
  }
  .unit__steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .unit__arrow {
    color: var(--color-ink-4);
  }
  .unit__fields {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .unit__fields li {
    min-width: 0;
  }
</style>
