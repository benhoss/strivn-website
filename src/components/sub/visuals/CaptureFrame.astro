---
/**
 * Shared shell for every sub-page product capture: an `st-panel` with an
 * optional title bar, a body and an optional footer. One place for the frame,
 * so a capture on the load page and one on the tests page cannot drift.
 * The inner vocabulary (`cap-*`) lives in SubVisual.astro.
 */
interface Props {
  /** Bar title, left. */
  title?: string;
  /** Bar meta, right, in mono caps. A `meta` slot overrides it. */
  meta?: string;
  /** Body without padding, for a table or rows that run edge to edge. */
  flush?: boolean;
  class?: string;
}

const { title, meta, flush = false, class: className = '' } = Astro.props;
const hasMeta = Boolean(meta) || Astro.slots.has('meta');
const hasBar = Boolean(title) || hasMeta;
---

<figure class:list={['st-panel cap', className]}>
  {
    hasBar && (
      <div class="st-panel__bar cap-bar">
        {title && <span class="cap-title">{title}</span>}
        {hasMeta && (
          <span class="cap-meta">
            <slot name="meta">{meta}</slot>
          </span>
        )}
      </div>
    )
  }
  <div class:list={['cap-body', flush && 'cap-body--flush']}>
    <slot />
  </div>
  {
    Astro.slots.has('foot') && (
      <div class="cap-foot">
        <slot name="foot" />
      </div>
    )
  }
</figure>
