---
/**
 * One prescription, a weight per player.
 *
 * The weights are the point of the page, so they are computed values held as
 * fixtures: 80 % of each max, rounded to the 2.5 kg plates named in the
 * settings row, scaled again for the player coming back from injury, and left
 * blank for the one with no max rather than loaded at a guess.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, PROGRAM_ROWS } from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].program;

/* 112.5 must read as "112,5" in French and "112.5" in English. */
const fmt = (n: number) => new Intl.NumberFormat(locale).format(n);
---

<CaptureFrame title={t.title} meta={t.meta}>
  <div class="lift">
    <p class="lift__name">{t.lift}</p>
    <p class="cap-sub">{t.detail}</p>
  </div>

  <ul class="cap-rows">
    {
      PROGRAM_ROWS.map((r) => (
        <li>
          <span class="cap-grow">
            <span class="cap-name">{r.name}</span>
            <span class="cap-sub">
              {r.max === null
                ? t.untested
                : `${t.maxLabel} ${r.max} kg${r.mod ? ` · ${t.modLabel} ${r.mod} %` : ''}`}
            </span>
          </span>
          <span class:list={['lift__kg', r.weight === null && 'is-empty']}>
            {r.weight === null ? '·' : `${fmt(r.weight)} kg`}
          </span>
        </li>
      ))
    }
  </ul>

  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
    {t.settings.map((setting) => <li class="st-tag">{setting}</li>)}
  </ul>
</CaptureFrame>

<style>
  .lift {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: var(--color-navy-900);
  }
  .lift__name {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .lift__kg {
    flex: none;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .lift__kg.is-empty {
    color: var(--color-ink-4);
  }
</style>
