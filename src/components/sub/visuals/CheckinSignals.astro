---
/**
 * "Signals" capture: the morning check-in table plus the red row's prompt.
 *
 * The missing-data row waits in a dashed chip rather than a green one: an
 * unanswered check-in must never read as "fine".
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, CHECKIN_ROWS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].checkin;

const chip: Record<string, string> = {
  green: 'st-chip st-chip--ready',
  amber: 'st-chip st-chip--watch',
  red: 'st-chip st-chip--risk',
  missing: 'st-chip st-chip--wait',
};
const empty = '·';
---

<CaptureFrame title={t.title} meta={t.meta} flush>
  <div class="cap-scroll">
    <table class="cap-table checkin-table">
      <thead>
        <tr>{t.cols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          CHECKIN_ROWS.map((r) => (
            <tr>
              <td class="cap-td-name">{r.name}</td>
              <td class:list={[r.ready === 'red' && 'ink-risk']}>{r.sleep ?? empty}</td>
              <td>{r.fatigue ?? empty}</td>
              <td class:list={[r.pain && 'ink-risk']}>
                {r.pain === null ? empty : r.pain ? t.yes : t.no}
              </td>
              <td>
                <span class={chip[r.ready]}>{t.ready[r.ready]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <Fragment slot="foot">
    <span class="text-risk"><HomeIcon name="triangle-alert" size={14} /></span>
    <p>{t.alert}</p>
  </Fragment>
</CaptureFrame>

<style>
  /* The readiness chip is the point of the table, so on a phone the table is
     tightened to fit rather than scrolled with the chip out of view. */
  .checkin-table {
    min-width: 340px;
  }
  @media (max-width: 480px) {
    .checkin-table th {
      font-size: 9px;
      letter-spacing: 0.03em;
    }
    .checkin-table th,
    .checkin-table td {
      padding-inline: 5px;
    }
    .checkin-table th:first-child,
    .checkin-table td:first-child {
      padding-left: 12px;
    }
    .checkin-table th:last-child,
    .checkin-table td:last-child {
      padding-right: 12px;
    }
    .checkin-table td:first-child {
      font-size: 13px;
    }
    .checkin-table .st-chip {
      gap: 4px;
      padding: 2px 6px;
      font-size: 9.5px;
    }
  }
</style>
