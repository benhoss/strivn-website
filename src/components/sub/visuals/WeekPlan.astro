---
/**
 * The planned week: seven days of load, then Thursday opened up.
 *
 * The two attached components add up to the session total in the header; the
 * pending one does not. That arithmetic is the page's argument (load can
 * belong to the week without belonging to a session), so the numbers are
 * fixtures rather than per-locale strings, and the sum stays true everywhere.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, WEEK_BARS, WEEK_PARTS } from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].week;

const peak = Math.max(...WEEK_BARS.map((b) => b.ua));
---

<CaptureFrame title={t.title}>
  <Fragment slot="meta">{t.acwr.k} <span class="text-ready">{t.acwr.v}</span></Fragment>

  <p class="cap-sub">{t.sub}</p>

  <div>
    <p class="cap-k">{t.shape}</p>
    <ul class="week">
      {
        WEEK_BARS.map((b, i) => (
          <li>
            <span class="cap-num week__ua">{b.ua}</span>
            <span
              class:list={['week__bar', b.active && 'is-on']}
              style={`height:${Math.round((b.ua / peak) * 72) + 4}px;`}
              aria-hidden="true"
            />
            <span class:list={['week__day', b.active && 'is-on']}>{t.days[i]}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="week__card">
    <div class="flex items-baseline justify-between gap-3">
      <p class="cap-name m-0">{t.session}</p>
      <p class="cap-num m-0 shrink-0 text-ink">{t.sessionTotal}</p>
    </div>
    <ul class="cap-rows mt-1">
      {
        WEEK_PARTS.map((p, i) => (
          <li>
            <span class:list={['cap-dot', p.attached && 'is-on']} aria-hidden="true" />
            <span class="cap-grow">
              <span class:list={['block', p.attached ? 'text-ink' : 'text-ink-3']}>{t.parts[i]}</span>
              <span class="cap-sub">
                RPE {p.rpe} · {p.min} min · {p.attached ? t.attached : t.pending}
              </span>
            </span>
            <span class:list={['cap-num shrink-0', p.attached ? 'text-ink-2' : 'text-ink-4']}>
              {p.ua} {t.unit}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</CaptureFrame>

<style>
  .week {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }
  .week li {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .week__ua {
    font-size: 10px;
    color: var(--color-ink-4);
  }
  .week__bar {
    display: block;
    width: 100%;
    border-radius: 3px 3px 0 0;
    background: var(--color-navy-700);
  }
  .week__bar.is-on {
    background: var(--color-electric);
  }
  .week__day {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-3);
  }
  .week__day.is-on {
    color: var(--color-ink);
  }
  .cap-dot.is-on {
    background: var(--color-electric-500);
  }
  .week__card {
    padding: 12px 14px 4px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: var(--color-navy-900);
  }
</style>
