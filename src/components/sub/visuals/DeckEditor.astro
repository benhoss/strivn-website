---
/**
 * The presentation editor on a match report: the page rail, and the cover the
 * template filled on its own — opponent, score, date, scorers.
 *
 * The point is that nothing on the cover was typed. The slide keeps the
 * club's own blue (the cover is the club's surface, not ours), and the rail
 * shows the pages the template brought with it.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, DECK_COVER } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].deck.editor;
---

<CaptureFrame title={t.title} meta={t.meta} flush>
  <div class="deck">
    <ol class="deck__rail" aria-hidden="true">
      {
        t.pages.map((p, i) => (
          <li class:list={['deck__page', i === 0 && 'is-on']}>
            <span class="cap-num deck__n">{i + 1}</span>
            <span class:list={['deck__thumb', `deck__thumb--${i}`]} />
            <span class="deck__label">{p}</span>
          </li>
        ))
      }
    </ol>

    <div class="deck__stage">
      <div class="deck__slide">
        <p class="deck__club">Racing Club Ardenne</p>
        <div>
          <p class="deck__kicker">{t.kicker}</p>
          <p class="deck__title">Match</p>
          <p class="deck__sub">{t.at} {DECK_COVER.opponent}</p>
          <p class="deck__score">{DECK_COVER.score}</p>
        </div>
        <div class="deck__foot">
          <span>{t.date}</span>
          <span>{t.scorers} : {DECK_COVER.scorers}</span>
        </div>
      </div>
      <p class="deck__actions">
        <span class="cap-btn cap-btn--primary"><HomeIcon name="play" size={12} />{t.present}</span>
      </p>
    </div>
  </div>
</CaptureFrame>

<style>
  .deck {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    min-height: 300px;
  }
  .deck__rail {
    margin: 0;
    padding: 12px 10px;
    list-style: none;
    border-right: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .deck__page {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 2px 6px;
    align-items: start;
  }
  .deck__n {
    font-size: 10px;
    color: var(--color-ink-4);
  }
  .deck__thumb {
    display: block;
    height: 34px;
    border-radius: 3px;
    border: 1px solid var(--color-line);
    background:
      repeating-linear-gradient(0deg, transparent 0 6px, rgba(255, 255, 255, 0.07) 6px 8px),
      var(--color-navy-850);
  }
  .deck__thumb--0 {
    background: #2f6df0;
  }
  .deck__thumb--4 {
    background: linear-gradient(#1f6a2c, #17521f);
  }
  .deck__page.is-on .deck__thumb {
    outline: 2px solid var(--color-electric-500);
    outline-offset: 1px;
  }
  .deck__label {
    grid-column: 2;
    font-size: 10.5px;
    line-height: 1.25;
    color: var(--color-ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .deck__stage {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .deck__slide {
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    background: #2f6df0;
    color: #fff;
    padding: 6% 7%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }
  .deck__slide p {
    margin: 0;
  }
  .deck__club {
    font-size: 12px;
    font-weight: 600;
  }
  .deck__kicker {
    font-size: 9px;
    letter-spacing: 0.12em;
    opacity: 0.8;
  }
  .deck__title {
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 600;
    line-height: 1.1;
  }
  .deck__sub {
    font-size: 11.5px;
    opacity: 0.9;
  }
  .deck__score {
    margin-top: 8px !important;
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .deck__foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 10px;
    opacity: 0.85;
  }
  .deck__actions {
    margin: 0;
    display: flex;
    justify-content: flex-end;
  }
  .deck__actions .cap-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 560px) {
    .deck {
      grid-template-columns: minmax(0, 1fr);
    }
    .deck__rail {
      display: none;
    }
  }
</style>
