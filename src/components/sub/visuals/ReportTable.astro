---
/**
 * A saved selection-and-form report.
 *
 * K. Nakamura's row is the point: a short sample is starred and its derived
 * columns stay empty rather than showing a figure the data cannot support.
 * Deltas are neutral (a minute count is not a state); the ACWR above the
 * watch threshold is the one status colour, as on the readiness board.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, REPORT_ROWS } from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].report;

const fmt = (n: number) => new Intl.NumberFormat(locale).format(n);
/** ACWR ink: watch from 1.2, risk from 1.3, as the readiness board reads it. */
const acwrInk = (v: string | null) => {
  const n = v === null ? NaN : Number(v.replace(',', '.'));
  return n >= 1.3 ? 'ink-risk' : n >= 1.2 ? 'ink-watch' : '';
};
---

<CaptureFrame title={t.title} meta={t.meta} flush>
  <div class="cap-scroll">
    <table class="cap-table report">
      <thead>
        <tr>{t.cols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          REPORT_ROWS.map((r) => (
            <tr>
              <td class="cap-td-name">{r.name}</td>
              <td>
                {fmt(r.min)}
                <span class="ink-3">
                  {r.minDelta === null
                    ? ' *'
                    : ` ${r.minDelta > 0 ? '+' : '−'}${fmt(Math.abs(r.minDelta))}`}
                </span>
              </td>
              <td>
                {r.rating}
                {r.ratingDelta && <span class="ink-3"> {r.ratingDelta}</span>}
              </td>
              <td class={acwrInk(r.acwr)}>{r.acwr ?? '·'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <Fragment slot="foot">
    <p class="text-ink-3">{t.note}</p>
  </Fragment>
</CaptureFrame>

<style>
  .report {
    min-width: 320px;
  }
</style>
