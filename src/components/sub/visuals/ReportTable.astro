---
/**
 * A saved selection-and-form report.
 *
 * K. Nakamura's row is the point: a short sample is starred and its derived
 * columns stay empty rather than showing a figure the data cannot support.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, REPORT_ROWS } from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].report;

const cols = 'grid grid-cols-[minmax(0,1fr)_minmax(0,72px)_minmax(0,66px)_minmax(0,52px)] gap-2';
const fmt = (n: number) => new Intl.NumberFormat(locale).format(n);
---

<CaptureFrame>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5">
    <p class="text-[0.81rem] font-semibold text-[#F8FAFC]">{t.title}</p>
    <p class="font-mono text-[0.56rem] tracking-[0.09em] whitespace-nowrap text-[#68779A]">
      {t.meta}
    </p>
  </div>

  <div class="overflow-hidden rounded-[11px] bg-[#FFFFFF05] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
    <div class={`${cols} border-b border-[#FFFFFF14] bg-[#FFFFFF0A] px-3.5 py-2.5`}>
      {
        t.cols.map((c, i) => (
          <p
            class={`font-mono text-[0.53rem] tracking-[0.08em] text-[#68779A] ${i === 0 ? '' : 'text-right'}`}
          >
            {c}
          </p>
        ))
      }
    </div>

    <ul>
      {
        REPORT_ROWS.map((r, i) => (
          <li
            class={`${cols} items-center px-3.5 py-2.5 ${i < REPORT_ROWS.length - 1 ? 'border-b border-[#FFFFFF14]' : ''}`}
          >
            <span class="min-w-0 truncate text-[0.78rem] font-medium text-[#DCE4F2]">{r.name}</span>

            <span class="text-right font-mono text-[0.72rem] whitespace-nowrap text-[#9AA8C4]">
              {fmt(r.min)}
              {r.minDelta === null ? (
                <span class="text-[#FF8400]"> *</span>
              ) : (
                <span class={r.minDelta > 0 ? 'text-[#8CE99A]' : 'text-[#FF7A6B]'}>
                  {' '}
                  {r.minDelta > 0 ? '+' : '−'}
                  {fmt(Math.abs(r.minDelta))}
                </span>
              )}
            </span>

            <span class="text-right font-mono text-[0.72rem] whitespace-nowrap text-[#9AA8C4]">
              {r.rating}
              {r.ratingDelta && (
                <span class={r.ratingDelta.startsWith('+') ? 'text-[#8CE99A]' : 'text-[#FF7A6B]'}>
                  {' '}
                  {r.ratingDelta}
                </span>
              )}
            </span>

            <span class="text-right font-mono text-[0.72rem] whitespace-nowrap text-[#9AA8C4]">
              {r.acwr ?? '—'}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="text-[0.72rem] leading-[1.5] text-[#68779A]">{t.note}</p>
</CaptureFrame>
