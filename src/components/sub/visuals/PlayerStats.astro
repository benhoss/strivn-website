---
/**
 * The player's Stats tab: his season figures beside his last matches.
 *
 * Result letters stay neutral on purpose. The system reserves green, amber
 * and red for readiness and risk, so a win rendered green would say "ready"
 * to anyone who has read the rest of the site. The scoreline is mono and the
 * win carries full ink: placement, not colour.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, PLAYER_STAT_TILES, PLAYER_MATCHES } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].playerStats;
---

<CaptureFrame title={t.title} meta={t.who}>
  <!-- Range filters. The selected one is the season, which is what the
       figures below are counting. -->
  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0" aria-hidden="true">
    {t.periods.map((p, i) => <li class:list={['st-tag', i === 2 && 'st-tag--accent']}>{p}</li>)}
  </ul>

  <div class="pstats">
    <ul class="pstats__tiles">
      {
        PLAYER_STAT_TILES.map((tile, i) => (
          <li>
            <p class="cap-k flex items-center gap-1.5">
              <span class="inline-flex shrink-0 text-ink-4">
                <HomeIcon name={tile.icon} size={11} />
              </span>
              {t.tiles[i]}
            </p>
            <p class="pstats__v">{tile.v}</p>
          </li>
        ))
      }
    </ul>

    <div class="pstats__matches">
      <p class="cap-k">{t.matchTitle}</p>
      <ul class="cap-rows mt-1">
        {
          PLAYER_MATCHES.map((m, i) => (
            <li class="pstats__match">
              <div class="flex items-baseline gap-2.5">
                <span class="cap-num shrink-0 text-ink-3">{t.dates[i]}</span>
                <span class="cap-name flex-1">{m.opp}</span>
                <span class="cap-k shrink-0 ink-4">{m.home ? t.home : t.away}</span>
                <span class:list={['cap-num shrink-0', m.us > m.them ? 'text-ink' : 'text-ink-3']}>
                  {m.us}–{m.them}
                </span>
                <span class:list={['pstats__res', m.us > m.them && 'is-win']}>{t.results[i]}</span>
              </div>
              {/* His own line for that match, under the scoreline. Label
                  before value, as the app itself prints it: a count after
                  its noun needs no agreement in any of the six locales. */}
              <p class="cap-sub mt-1.5 flex flex-wrap gap-x-3">
                {m.line.map((v, li) => (
                  <span>
                    {t.lineKeys[li]} <span class={v === '0' ? 'text-ink-4' : 'text-ink'}>{v}</span>
                  </span>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Fragment slot="foot">
    <p class="text-ink-3">{t.note}</p>
  </Fragment>
</CaptureFrame>

<style>
  .pstats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px 32px;
  }
  .pstats__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
  }
  .pstats__tiles li {
    display: grid;
    gap: 6px;
    align-content: start;
    min-width: 0;
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .pstats__tiles li:nth-child(2n) {
    padding-left: 12px;
    border-left: 1px solid var(--color-line);
  }
  .pstats__v {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .pstats__match {
    display: block;
  }
  .pstats__res {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-3);
  }
  .pstats__res.is-win {
    border-color: var(--color-ink-2);
    color: var(--color-ink);
  }
  @media (min-width: 560px) {
    .pstats__tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pstats__tiles li,
    .pstats__tiles li:nth-child(2n) {
      padding: 12px 12px 12px 0;
      border-left: 0;
    }
    .pstats__tiles li:not(:nth-child(3n + 1)) {
      padding-left: 12px;
      border-left: 1px solid var(--color-line);
    }
  }
  @media (min-width: 1080px) {
    .pstats {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }
</style>
