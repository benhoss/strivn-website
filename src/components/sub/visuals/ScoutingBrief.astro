---
/**
 * The opponent file: a scouted roster, and the brief proposed from it.
 *
 * Two things the capture has to make visible, because they are the page's
 * argument. A row lifted from an imported team sheet says so and carries the
 * extraction's confidence: a roster nobody confirmed must not look like one
 * that was. And the brief is a proposal with a Review button, never an
 * answer already applied. Opponents are not our players, so no status colour.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, SCOUT_ROWS, SCOUT_NAMES } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].scout;
---

<CaptureFrame title={t.title} meta={t.meta} flush>
  <div class="scout__head">
    {t.cols.map((c) => <p class="cap-k">{c}</p>)}
  </div>
  <ul class="cap-rows cap-rows--pad">
    {
      SCOUT_ROWS.map((r, i) => (
        <li>
          <span class="cap-num w-6 shrink-0 text-ink-3">{r.num}</span>
          <span class="cap-grow">
            <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
              <span class="cap-name">{SCOUT_NAMES[i]}</span>
              {r.danger && <span class="st-tag shrink-0">{t.danger}</span>}
            </span>
            <span class="cap-sub">{t.positions[r.pos]}</span>
          </span>
          <span class="shrink-0 text-right">
            <span class:list={['cap-num block', r.source === 0 ? 'text-ink' : 'text-ink-3']}>
              {t.sources[r.source]}
            </span>
            {r.confidence !== null && (
              <span class="cap-sub">{r.confidence} %</span>
            )}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="scout__brief">
    <div class="st-proposal">
      <p class="m-0 flex flex-wrap items-center gap-x-2.5 gap-y-2">
        <span class="inline-flex shrink-0 text-electric-500"><HomeIcon name="sparkles" size={14} /></span>
        <span class="font-medium text-ink">{t.proposal}</span>
        <span class="cap-btn ml-auto">{t.accept}</span>
      </p>
      <p class="m-0 text-[13px] leading-[1.5] text-ink-2">{t.proposalNote}</p>
    </div>
  </div>
</CaptureFrame>

<style>
  .scout__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px 8px;
    border-bottom: 1px solid var(--color-line);
  }
  .scout__brief {
    padding: 14px 16px 16px;
    border-top: 1px solid var(--color-line);
  }
</style>
