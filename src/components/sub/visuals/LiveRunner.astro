---
/**
 * The session runner as it looks pitch-side: the running block in full, its
 * chrono, and the actions queued behind it.
 *
 * The live marker is the system's `st-live`, the one place on these captures
 * where motion says something: this screen is running right now. It stops
 * under `prefers-reduced-motion`.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, RUNNER_SEGMENTS, RUNNER_ROW_ICONS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].runner;
---

<CaptureFrame title={t.title}>
  <span slot="meta" class="st-live">{t.live}</span>

  <div class="runner">
    <p class="cap-k">{t.block}</p>
    <div class="runner__head">
      <p class="runner__name">{t.name}</p>
      <p class="runner__chrono">{t.chrono}</p>
    </div>
    <ul class="runner__segs" aria-hidden="true">
      {RUNNER_SEGMENTS.map((state) => <li class={`is-${state}`} />)}
    </ul>
    <div class="cap-btns">
      <span class="cap-btn">{t.pause}</span>
      <span class="cap-btn cap-btn--primary">{t.finish}</span>
    </div>
  </div>

  <ul class="cap-rows">
    {
      t.rows.map((r, i) => (
        <li>
          <span class="inline-flex shrink-0 text-ink-3">
            <HomeIcon name={RUNNER_ROW_ICONS[i]} size={14} />
          </span>
          <span class="cap-grow text-ink-2">{r.t}</span>
          <span class="cap-num shrink-0 text-ink-3">{r.m}</span>
        </li>
      ))
    }
  </ul>
</CaptureFrame>

<style>
  .runner {
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: var(--color-navy-900);
  }
  .runner__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .runner__name {
    margin: 0;
    min-width: 0;
    font-size: 17px;
    font-weight: 600;
    font-variation-settings: 'wdth' 90;
    color: var(--color-ink);
  }
  .runner__chrono {
    margin: 0;
    flex: none;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .runner__segs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
  }
  .runner__segs li {
    flex: 1 1 0;
    height: 4px;
    border-radius: 2px;
    background: var(--color-navy-800);
  }
  .runner__segs li.is-done {
    background: color-mix(in srgb, var(--color-electric) 45%, transparent);
  }
  .runner__segs li.is-live {
    background: var(--color-electric);
  }
</style>
