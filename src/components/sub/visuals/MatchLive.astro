---
/**
 * The match encoder mid-game: score, the counted facts, and the timeline
 * behind them.
 *
 * The minute lives in the fixtures rather than in each locale's title, so the
 * timeline can never drift past the clock in one language and not another.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, MATCH_FACTS, MATCH_SCORE, MATCH_EVENTS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].match;
---

<CaptureFrame title={`${t.title} · ${MATCH_SCORE.minute}’`}>
  <Fragment slot="meta">
    <HomeIcon name="cloud-off" size={12} />
    {t.sync}
  </Fragment>

  <div class="score">
    <p class="cap-k ink-1">{t.us}</p>
    <p class="score__v">
      {MATCH_SCORE.us}<span class="text-ink-4"> – </span>{MATCH_SCORE.them}
    </p>
    <p class="cap-k text-right">{t.them}</p>
  </div>

  <ul class="facts">
    {
      t.facts.map((name, i) => (
        <li>
          <p class="facts__k">{name}</p>
          <p class="cap-num m-0">
            <span class="text-ink">{MATCH_FACTS[i].a}</span>
            <span class="text-ink-4"> · </span>
            <span class="text-ink-3">{MATCH_FACTS[i].b}</span>
          </p>
        </li>
      ))
    }
  </ul>

  <ul class="cap-rows">
    {
      t.events.map((text, i) => (
        <li>
          <span class="inline-flex shrink-0 text-ink-3">
            <HomeIcon name={MATCH_EVENTS[i].icon} size={14} />
          </span>
          <span class="cap-grow text-ink-2">{text}</span>
          <span class="cap-num shrink-0 text-ink-3">{MATCH_EVENTS[i].minute}’</span>
        </li>
      ))
    }
  </ul>
</CaptureFrame>

<style>
  .score {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: var(--color-navy-900);
  }
  .score__v {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .facts li {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 10px 12px;
  }
  .facts li:first-child {
    padding-left: 0;
  }
  .facts li + li {
    border-left: 1px solid var(--color-line);
  }
  .facts__k {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
