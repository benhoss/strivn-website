---
/**
 * The measure editor: a name, a unit, a description, and the zones a value
 * will fall into. Rendered as a read-only mock: the fields are styled blocks,
 * not real inputs, so nothing here is focusable or announced as a form.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, MEASURE_ZONE_DOTS } from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].measure;
---

<CaptureFrame title={t.title} class="w-full max-w-[480px]">
  <div class="grid gap-3">
    {
      t.fields.map((fl) => (
        <div>
          <p class="cap-k">{fl.k}</p>
          <p class="cap-field">{fl.v}</p>
        </div>
      ))
    }
  </div>

  <div class="border-t border-line pt-4">
    <p class="cap-k">{t.zonesLabel}</p>
    <ul class="cap-rows mt-1">
      {
        t.zones.map((z, i) => (
          <li>
            <span
              class="size-2.5 shrink-0 rounded-[2px]"
              style={`background:${MEASURE_ZONE_DOTS[i]};`}
              aria-hidden="true"
            />
            <span class="cap-grow text-ink">{z.name}</span>
            <span class="cap-num shrink-0 text-ink-3">{z.bound}</span>
          </li>
        ))
      }
    </ul>
  </div>
</CaptureFrame>
