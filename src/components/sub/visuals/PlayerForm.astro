---
/**
 * The player's Fitness tab: today's readiness, the week behind it, and the
 * fortnight behind that.
 *
 * This capture is allowed the status colours throughout: green, amber and red
 * here describe the player's own state day by day, which is exactly what the
 * system reserves them for.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, PLAYER_WEEK, PLAYER_TREND } from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].playerForm;

/** Fixture state → status token name. */
const TOKEN = { green: 'ready', amber: 'watch', red: 'risk' } as const;

/* Sparkline geometry, in percentages of the plot box. The band thresholds
   are the same ones the week cells use, so a dot's colour and a cell's
   colour mean the same thing.

   The line is an SVG stretched to the box; the readings are positioned
   elements over it. Stretching the SVG would turn a circle into an ellipse,
   and a fortnight of readings is fourteen chances to notice. */
const points = PLAYER_TREND.map((v, i) => ({
  x: (i / (PLAYER_TREND.length - 1)) * 100,
  y: 100 - v,
  tone: v >= 65 ? 'ready' : v >= 50 ? 'watch' : 'risk',
  /** The last reading has no check-in behind it yet. */
  estimated: i === PLAYER_TREND.length - 1,
}));
const path = points.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');
---

<CaptureFrame title={t.title}>
  <span slot="meta" class="st-chip st-chip--watch">{t.verdict}</span>

  <div class="form__top">
    <div class="st-kpi">
      <span class="st-label">Readiness</span>
      <span class="form__score">{t.score}<small>%</small></span>
    </div>
    {
      t.tiles.map((tile) => (
        <div class="st-kpi">
          <span class="st-label">{tile.k}</span>
          <span class="st-kpi__v">{tile.v}</span>
        </div>
      ))
    }
  </div>

  <div class="form__block">
    <div class="flex items-baseline justify-between gap-3">
      <p class="cap-name m-0">{t.weekTitle}</p>
      <p class="cap-sub">{t.weekMeta}</p>
    </div>
    <div class="form__week" aria-hidden="true">
      {
        PLAYER_WEEK.map((s, i) => (
          <span
            class:list={['form__cell', i === PLAYER_WEEK.length - 1 && 'is-today']}
            style={`--c: var(--color-${TOKEN[s]});`}
          />
        ))
      }
    </div>
    <ul class="form__days">
      {
        t.days.map((d, i) => (
          <li class:list={[i === t.days.length - 1 && 'is-today']}>{d}</li>
        ))
      }
    </ul>
    <p class="form__alert">
      <span class="cap-dot" aria-hidden="true"></span>
      {t.alert}
    </p>
  </div>

  <div class="form__block">
    <p class="cap-k">{t.trendTitle}</p>
    <div class="form__plot" role="img" aria-label={t.trendTitle}>
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line x1="0" y1="35" x2="100" y2="35" class="form__ref" stroke-dasharray="2 4"></line>
        <polyline
          points={path}
          fill="none"
          class="form__line"
          stroke-width="1"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"></polyline>
      </svg>
      {
        points.map((p) => (
          <span
            class:list={['form__pt', p.estimated && 'is-est']}
            style={`left:${p.x}%; top:${p.y}%; --c: var(--color-${p.tone});`}
            aria-hidden="true"
          />
        ))
      }
    </div>
    <ul class="form__legend" aria-hidden="true">
      <li><span class="form__pt form__pt--legend"></span>{t.measured}</li>
      <li><span class="form__pt form__pt--legend is-est"></span>{t.estimated}</li>
    </ul>
  </div>
</CaptureFrame>

<style>
  .form__top {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: end;
  }
  .form__score {
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .form__score small {
    margin-left: 2px;
    font-size: 13px;
    color: var(--color-ink-3);
  }
  .form__block {
    display: grid;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
  }
  .form__week,
  .form__days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
  }
  .form__cell {
    height: 30px;
    border-radius: 5px;
    border: 1px solid var(--c);
    background: color-mix(in srgb, var(--c) 22%, transparent);
  }
  .form__cell.is-today {
    box-shadow: 0 0 0 2px var(--color-navy-950), 0 0 0 3px var(--color-ink-2);
  }
  .form__days {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .form__days li {
    font-family: var(--font-mono);
    font-size: 10px;
    text-align: center;
    color: var(--color-ink-3);
  }
  .form__days li.is-today {
    color: var(--color-ink);
  }
  .form__alert {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 4px 0 0;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--color-risk) 35%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-risk) 8%, transparent);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .form__alert .cap-dot {
    background: var(--color-risk);
    transform: translateY(-1px);
  }
  .form__plot {
    position: relative;
    height: 64px;
    margin: 8px 4px 0;
  }
  .form__plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .form__ref {
    stroke: var(--color-line-strong);
  }
  .form__line {
    stroke: var(--color-navy-500);
  }
  .form__pt {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    transform: translate(-50%, -50%);
  }
  .form__pt.is-est {
    background: var(--color-navy-950);
    box-shadow: inset 0 0 0 1px var(--color-ink-3);
  }
  .form__legend {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .form__legend li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-3);
  }
  .form__pt--legend {
    position: static;
    transform: none;
    --c: var(--color-ready);
  }
</style>
