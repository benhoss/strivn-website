---
/**
 * One injured player's return-to-play protocol.
 *
 * Two steps validated out of four is 50 %, but the bar reads 68 % — because
 * the running step counts for part of itself. The estimated return date is
 * what the staff acts on, so it sits in the header rather than the footnote.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, RTP_STATES, RTP_PROGRESS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].rtp;

const stateLabel = { done: t.stepStates[0], live: t.stepStates[1], todo: t.stepStates[2] };
const stateInk = {
  done: 'text-[#8CE99A]',
  live: 'text-[#7AB8FF]',
  todo: 'text-[#68779A]',
};
const stateDot = {
  done: 'bg-[#8CE99A]',
  live: 'bg-[#2D7FF9]',
  todo: 'bg-[#FFFFFF29]',
};
---

<CaptureFrame>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1.5">
    <div class="min-w-0">
      <p class="truncate text-[0.81rem] font-semibold text-[#F8FAFC]">{t.who}</p>
      <p class="mt-1 font-mono text-[0.63rem] text-[#68779A]">{t.detail}</p>
    </div>
    <p
      class="shrink-0 rounded-full bg-[#FF840014] px-2.5 py-1 font-mono text-[0.56rem] tracking-[0.09em] whitespace-nowrap text-[#FF8400]"
    >
      {t.status}
    </p>
  </div>

  <div>
    <div class="flex items-baseline justify-between gap-4">
      <p class="font-mono text-[0.53rem] tracking-[0.08em] text-[#68779A]">{t.progressKey}</p>
      <p class="shrink-0 font-mono text-[0.94rem] text-[#7AB8FF]">{RTP_PROGRESS} %</p>
    </div>
    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#FFFFFF0F]">
      <span
        class="block h-full rounded-full bg-[#2D7FF9]"
        style={`width:${RTP_PROGRESS}%;`}
        aria-hidden="true"></span>
    </div>
  </div>

  <ol class="grid gap-2.5">
    {
      t.steps.map((step, i) => {
        const state = RTP_STATES[i];
        return (
          <li class="flex items-center gap-2.5">
            <span class={`size-[7px] shrink-0 rounded-full ${stateDot[state]}`} aria-hidden="true" />
            <span
              class={`min-w-0 flex-1 truncate text-[0.78rem] ${state === 'todo' ? 'text-[#68779A]' : 'text-[#DCE4F2]'}`}
            >
              {step}
            </span>
            <span
              class={`shrink-0 font-mono text-[0.63rem] whitespace-nowrap ${stateInk[state]}`}
            >
              {stateLabel[state]}
            </span>
          </li>
        );
      })
    }
  </ol>

  <p
    class="flex flex-wrap items-center gap-x-2.5 gap-y-1 rounded-[10px] bg-[#FFFFFF05] px-3.5 py-3 text-[0.72rem] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]"
  >
    <span class="shrink-0 text-[#FF8400]"><HomeIcon name="shield-check" size={13} /></span>
    <span class="text-[#DCE4F2]">{t.availability}</span>
    <span class="font-mono text-[0.63rem] text-[#68779A]">{t.availabilityNote}</span>
  </p>
</CaptureFrame>
