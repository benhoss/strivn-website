---
/**
 * One injured player's return-to-play protocol.
 *
 * Two steps validated out of four is 50 %, but the bar reads 68 %: the
 * running step counts for part of itself. The estimated return date is what
 * the staff acts on, so it sits with the bar rather than in a footnote.
 * Every colour here is the player's own state.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, RTP_STATES, RTP_PROGRESS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].rtp;

const stateLabel = { done: t.stepStates[0], live: t.stepStates[1], todo: t.stepStates[2] };
const stateChip = {
  done: 'st-chip st-chip--ready',
  live: 'st-chip st-chip--watch',
  todo: 'st-chip st-chip--wait',
};
---

<CaptureFrame title={t.who}>
  <span slot="meta" class="st-chip st-chip--watch">{t.status}</span>

  <p class="cap-sub">{t.detail}</p>

  <div class="grid gap-2">
    <div class="flex items-baseline justify-between gap-4">
      <p class="cap-k">{t.progressKey}</p>
      <p class="cap-num m-0 text-ink">{RTP_PROGRESS} %</p>
    </div>
    <div class="st-meter" aria-hidden="true">
      <i style={`width:${RTP_PROGRESS}%; background: var(--color-watch);`}></i>
    </div>
  </div>

  <ol class="cap-rows">
    {
      t.steps.map((step, i) => {
        const state = RTP_STATES[i];
        return (
          <li>
            <span class="cap-num w-5 shrink-0 text-ink-4">{i + 1}</span>
            <span class:list={['cap-grow', state === 'todo' ? 'text-ink-3' : 'text-ink']}>
              {step}
            </span>
            <span class={`shrink-0 ${stateChip[state]}`}>{stateLabel[state]}</span>
          </li>
        );
      })
    }
  </ol>

  <Fragment slot="foot">
    <span class="text-watch"><HomeIcon name="shield-check" size={14} /></span>
    <p>
      <span class="text-ink">{t.availability}</span>
      <span class="cap-sub mt-0.5">{t.availabilityNote}</span>
    </p>
  </Fragment>
</CaptureFrame>
