---
/**
 * The player's home screen, in a phone shell.
 *
 * The shell is decorative (the status bar and the notch carry no meaning),
 * so it is hidden from assistive tech while the content inside stays read.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].phone;

/** Slider positions for sleep, fatigue and soreness. */
const fill = [78, 42, 30];
---

<div class="phone st-panel">
  <div class="phone__screen">
    <div class="phone__status" aria-hidden="true">
      <span class="cap-num text-ink-2">{t.clock}</span>
      <span class="phone__notch"></span>
      <span class="inline-flex text-ink-3"><HomeIcon name="signal" size={12} /></span>
    </div>

    <div class="phone__body">
      <div>
        <p class="phone__hello">{t.hello}</p>
        <p class="cap-sub">{t.team}</p>
      </div>

      <div class="st-proposal phone__card">
        <div class="flex items-baseline justify-between gap-3">
          <p class="phone__card-title">{t.wellness}</p>
          <p class="cap-num m-0 text-ink-2">{t.duration}</p>
        </div>
        <ul class="phone__sliders">
          {
            t.fields.map((f, i) => (
              <li>
                <span class="phone__field">{f}</span>
                <span class="st-meter flex-1" aria-hidden="true">
                  <i style={`width:${fill[i]}%;`} />
                </span>
              </li>
            ))
          }
        </ul>
        <p class="phone__send">{t.send}</p>
      </div>

      <div class="phone__row">
        <span class="min-w-0 flex-1 truncate">{t.rpe}</span>
        <span class="cap-num shrink-0 text-ink">{t.rpeValue}</span>
      </div>

      <div class="phone__row phone__row--stack">
        <span class="truncate text-ink">{t.workout}</span>
        <span class="cap-sub">{t.workoutMeta}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
    padding: 10px;
    border-radius: 36px;
  }
  .phone__screen {
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid var(--color-line);
    background: var(--color-void);
  }
  .phone__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px 4px;
  }
  .phone__notch {
    width: 44px;
    height: 5px;
    border-radius: 3px;
    background: var(--color-navy-800);
  }
  .phone__body {
    display: grid;
    gap: 10px;
    padding: 12px 16px 18px;
  }
  .phone__hello {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    font-variation-settings: 'wdth' 90;
    color: var(--color-ink);
  }
  .phone__card {
    gap: 12px;
    margin-top: 6px;
  }
  .phone__card-title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .phone__sliders {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .phone__sliders li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .phone__field {
    flex: none;
    width: 76px;
    font-size: 12px;
    color: var(--color-ink-2);
  }
  .phone__send {
    margin: 0;
    padding: 8px;
    border-radius: 6px;
    background: var(--color-electric);
    text-align: center;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .phone__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    font-size: 12.5px;
    color: var(--color-ink-2);
  }
  .phone__row--stack {
    display: grid;
    gap: 3px;
  }
</style>
