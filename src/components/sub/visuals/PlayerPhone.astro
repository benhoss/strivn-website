---
/**
 * The player's home screen, in a phone shell.
 *
 * The shell is decorative — the status bar and the notch carry no meaning —
 * so it is hidden from assistive tech while the content inside stays read.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].phone;
---

<div
  class="mx-auto w-full max-w-[288px] rounded-[34px] bg-[#0A0F1E] p-3 [box-shadow:0_30px_70px_-16px_#000000CC] outline-1 outline-[#FFFFFF1F] -outline-offset-[0.5px]"
>
  <div class="overflow-hidden rounded-[26px] bg-[#070B16]">
    <div class="flex items-center justify-between px-5 pt-3.5 pb-1" aria-hidden="true">
      <span class="font-mono text-[0.63rem] text-[#DCE4F2]">{t.clock}</span>
      <span class="h-1 w-10 rounded-full bg-[#FFFFFF1F]"></span>
      <span class="text-[#68779A]"><HomeIcon name="signal" size={12} /></span>
    </div>

    <div class="px-5 pt-3 pb-5">
      <p class="text-[1rem] font-semibold text-[#F8FAFC]">{t.hello}</p>
      <p class="mt-0.5 font-mono text-[0.59rem] text-[#68779A]">{t.team}</p>

      <div class="mt-4 rounded-[14px] bg-[#2D7FF90F] p-3.5 outline-1 outline-[#2D7FF92E] -outline-offset-[0.5px]">
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-[0.78rem] font-semibold text-[#F8FAFC]">{t.wellness}</p>
          <p class="shrink-0 font-mono text-[0.59rem] text-[#7AB8FF]">{t.duration}</p>
        </div>
        <ul class="mt-3 grid gap-2">
          {
            t.fields.map((f, i) => (
              <li class="flex items-center gap-2.5">
                <span class="w-[68px] shrink-0 text-[0.66rem] text-[#9AA8C4]">{f}</span>
                <span class="h-1 flex-1 overflow-hidden rounded-full bg-[#FFFFFF12]">
                  <span
                    class="hl-fill block h-full rounded-full bg-[#7AB8FF]"
                    style={`width:${[78, 42, 30][i]}%; --bd:${120 + i * 90}ms;`}
                    aria-hidden="true"
                  />
                </span>
              </li>
            ))
          }
        </ul>
        <!-- Send lands once the three fields are answered: the capture's claim
             is that the whole thing takes twenty seconds. -->
        <p
          class="hl-late mt-3.5 rounded-full bg-[#2D7FF9] py-2 text-center text-[0.69rem] font-semibold text-[#F8FAFC]"
          style="--ld: 560ms;"
        >
          {t.send}
        </p>
      </div>

      <div class="mt-2.5 flex items-center gap-2.5 rounded-[12px] bg-[#FFFFFF05] px-3.5 py-3 outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
        <span class="min-w-0 flex-1 truncate text-[0.72rem] text-[#C3CDE0]">{t.rpe}</span>
        <span class="shrink-0 font-mono text-[0.81rem] text-[#7AB8FF]">{t.rpeValue}</span>
      </div>

      <div class="mt-2.5 rounded-[12px] bg-[#FFFFFF05] px-3.5 py-3 outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
        <p class="truncate text-[0.72rem] text-[#DCE4F2]">{t.workout}</p>
        <p class="mt-1 font-mono text-[0.59rem] text-[#68779A]">{t.workoutMeta}</p>
      </div>
    </div>
  </div>
</div>
