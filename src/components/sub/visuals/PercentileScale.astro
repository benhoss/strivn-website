---
/**
 * Where one player's value sits on the benchmarks for their position.
 *
 * The marker column is the same width as its band, so the marker stays over
 * the band it names at any width: the number is meaningless until placed.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, SCALE_BANDS, SCALE_MARKER_INDEX } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].scale;
---

<CaptureFrame title={t.who} meta={t.ref}>
  <div class="scale">
    <!-- Marker row: an empty cell per band, the value sitting over its own. -->
    <div class="scale__row">
      {
        SCALE_BANDS.map((_, i) =>
          i === SCALE_MARKER_INDEX ? (
            <div class="scale__marker">
              <span class="scale__value">{t.marker}</span>
              <span class="scale__tick" aria-hidden="true" />
            </div>
          ) : (
            <span aria-hidden="true" />
          ),
        )
      }
    </div>

    <div class="scale__row" aria-hidden="true">
      {
        SCALE_BANDS.map((c, i) => (
          <span
            class:list={['scale__band', i === SCALE_MARKER_INDEX && 'is-on']}
            style={`background:${c};`}
          />
        ))
      }
    </div>

    <ul class="scale__row scale__labels">
      {t.labels.map((l, i) => <li class:list={[i === SCALE_MARKER_INDEX && 'is-on']}>{l}</li>)}
    </ul>
  </div>

  <Fragment slot="foot">
    <span class="text-ready"><HomeIcon name="trending-up" size={14} /></span>
    <p>{t.delta}</p>
  </Fragment>
</CaptureFrame>

<style>
  .scale {
    display: grid;
    gap: 6px;
    padding: 8px 0 4px;
  }
  .scale__row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
  }
  .scale__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .scale__value {
    padding: 5px 10px;
    border: 1px solid var(--color-line-strong);
    border-radius: 6px;
    background: var(--color-navy-900);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .scale__tick {
    width: 1px;
    height: 10px;
    margin-top: 4px;
    background: var(--color-ink-2);
  }
  .scale__band {
    height: 14px;
    border-radius: 3px;
  }
  .scale__band.is-on {
    box-shadow: inset 0 0 0 1px var(--color-ink-2);
  }
  .scale__labels {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }
  .scale__labels li {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.3;
    text-align: center;
    color: var(--color-ink-3);
    overflow-wrap: anywhere;
  }
  .scale__labels li.is-on {
    color: var(--color-ink);
  }
</style>
