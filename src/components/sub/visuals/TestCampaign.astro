---
/**
 * "MAS campaign" capture: entry progress over the result grid.
 *
 * The last row carries no value on purpose: the page's argument is that a
 * missing result stays visibly missing rather than being guessed at.
 */
import type { Locale } from '../../../data/landingContent';
import {
  captureText,
  CAMPAIGN_ROWS,
  CAMPAIGN_ZONE_TONES,
  CAMPAIGN_PROGRESS,
} from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].campaign;
const pct = Math.round((CAMPAIGN_PROGRESS.done / CAMPAIGN_PROGRESS.total) * 100);
const done = `${CAMPAIGN_PROGRESS.done} / ${CAMPAIGN_PROGRESS.total}`;
---

<CaptureFrame title={t.title} meta={t.unit}>
  <p class="cap-sub">{t.sub}</p>

  <div class="grid gap-2">
    <div class="flex items-baseline justify-between gap-4">
      <p class="cap-k">{t.progress}</p>
      <p class="cap-num m-0 text-ink">{done}</p>
    </div>
    <div class="st-meter" aria-hidden="true"><i style={`width: ${pct}%;`}></i></div>
  </div>

  <ul class="cap-rows">
    {
      CAMPAIGN_ROWS.map((r) => (
        <li>
          <span class="cap-grow">
            <span class="cap-name">{r.name}</span>
            <span class="cap-sub">{t.positions[r.pos]}</span>
          </span>
          <span class:list={['cap-num shrink-0', r.value ? 'text-ink' : 'text-ink-4']}>
            {r.value ?? '·'}
          </span>
          <span class="campaign-zone">
            <span class={`st-chip st-chip--${CAMPAIGN_ZONE_TONES[r.zone]}`}>
              {t.zones[r.zone]}
            </span>
          </span>
        </li>
      ))
    }
  </ul>

  <Fragment slot="foot">
    <p class="text-ink-3">{t.note}</p>
  </Fragment>
</CaptureFrame>

<style>
  .campaign-zone {
    flex: none;
    display: flex;
    justify-content: flex-end;
    width: 112px;
  }
</style>
