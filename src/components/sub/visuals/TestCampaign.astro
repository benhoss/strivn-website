---
/**
 * "MAS campaign" capture: entry progress over the result grid.
 *
 * The last row carries no value on purpose — the page's argument is that a
 * missing result stays visibly missing rather than being guessed at.
 */
import type { Locale } from '../../../data/landingContent';
import {
  captureText,
  CAMPAIGN_ROWS,
  CAMPAIGN_ZONE_DOTS,
  CAMPAIGN_PROGRESS,
} from '../../../data/subpages/captures';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].campaign;
const pct = Math.round((CAMPAIGN_PROGRESS.done / CAMPAIGN_PROGRESS.total) * 100);
const done = `${CAMPAIGN_PROGRESS.done} / ${CAMPAIGN_PROGRESS.total}`;
---

<CaptureFrame gap="gap-4">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-[0.81rem] font-semibold text-[#F8FAFC]">{t.title}</p>
      <p class="mt-0.5 text-[0.69rem] text-[#68779A]">{t.sub}</p>
    </div>
    <p class="shrink-0 font-mono text-[0.63rem] text-[#68779A]">{t.unit}</p>
  </div>

  <div>
    <div class="flex items-center justify-between gap-4">
      <p class="font-mono text-[0.53rem] tracking-[0.08em] text-[#68779A]">{t.progress}</p>
      <p class="hl-display text-[0.94rem] tracking-[-0.02em]" data-count>{done}</p>
    </div>
    <div class="mt-2.5 h-1.5 overflow-hidden rounded-full bg-[#FFFFFF0F]">
      <span class="hl-fill block h-full rounded-full bg-[#2D7FF9]" style={`width: ${pct}%; --bd: 100ms;`} aria-hidden="true"></span>
    </div>
  </div>

  <ul class="overflow-hidden rounded-[11px] bg-[#FFFFFF05] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
    {
      CAMPAIGN_ROWS.map((r, i) => (
        <li
          class={`flex items-center gap-3 px-3.5 py-3 ${i < CAMPAIGN_ROWS.length - 1 ? 'border-b border-[#FFFFFF14]' : ''}`}
        >
          <span class="min-w-0 flex-1">
            <span class="block truncate text-[0.78rem] font-medium text-[#DCE4F2]">{r.name}</span>
            <span class="block truncate text-[0.66rem] text-[#68779A]">{t.positions[r.pos]}</span>
          </span>
          <span
            class={`shrink-0 font-mono text-[0.81rem] ${r.value ? 'text-[#DCE4F2]' : 'text-[#68779A]'}`}
          >
            {r.value ?? '—'}
          </span>
          <span class="flex w-[118px] shrink-0 items-center justify-center gap-1.5 rounded-full bg-[#FFFFFF0A] px-2 py-1 outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
            <span
              class="size-[5px] shrink-0 rounded-full"
              style={`background:${CAMPAIGN_ZONE_DOTS[r.zone]};`}
              aria-hidden="true"
            />
            <span class="font-mono text-[0.56rem] whitespace-nowrap" style={`color:${CAMPAIGN_ZONE_DOTS[r.zone]};`}>
              {t.zones[r.zone]}
            </span>
          </span>
        </li>
      ))
    }
  </ul>

  <p class="text-[0.72rem] leading-[1.45] text-[#68779A]">{t.note}</p>
</CaptureFrame>
