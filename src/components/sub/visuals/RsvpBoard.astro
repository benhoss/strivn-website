---
/**
 * A call-up and the answers coming back.
 *
 * The five counters sum to the ten players called up, and the header's
 * "answered" figure is the eight who are not pending — so the nudge line's
 * "2 still pending" is arithmetic the reader can check.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, RSVP_COUNTS, RSVP_ROWS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].rsvp;

const ink = [
  'text-[#8CE99A]',
  'text-[#FF8400]',
  'text-[#7AB8FF]',
  'text-[#FF7A6B]',
  'text-[#68779A]',
];
const chip = [
  'bg-[#8CE99A14] text-[#8CE99A]',
  'bg-[#FF840014] text-[#FF8400]',
  'bg-[#2D7FF914] text-[#7AB8FF]',
  'bg-[#FF7A6B14] text-[#FF7A6B]',
  'bg-[#FFFFFF0A] text-[#68779A]',
];
---

<CaptureFrame>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5">
    <p class="text-[0.81rem] font-semibold text-[#F8FAFC]">{t.title}</p>
    <p class="font-mono text-[0.56rem] tracking-[0.09em] whitespace-nowrap text-[#68779A]">
      {t.meta}
    </p>
  </div>

  <ul class="grid grid-cols-5 gap-1.5">
    {
      RSVP_COUNTS.map((n, i) => (
        <li class="rounded-[9px] bg-[#FFFFFF05] px-2 py-2.5 text-center outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
          <p class={`font-mono text-[0.94rem] ${n === 0 ? 'text-[#68779A]' : ink[i]}`} data-count>
            {n}
          </p>
          <p class="mt-0.5 text-[0.56rem] leading-[1.3] text-[#68779A]">{t.counts[i]}</p>
        </li>
      ))
    }
  </ul>

  <ul class="grid gap-2.5">
    {
      RSVP_ROWS.map((r) => (
        <li class="flex items-center gap-2.5">
          <span class="min-w-0 flex-1">
            <span class="block truncate text-[0.78rem] text-[#DCE4F2]">{r.name}</span>
            <span class="block font-mono text-[0.63rem] text-[#68779A]">{t.positions[r.pos]}</span>
          </span>
          <span
            class={`shrink-0 rounded-full px-2.5 py-[3px] text-[0.63rem] whitespace-nowrap ${chip[r.answer]}`}
          >
            {t.answers[r.answer]}
          </span>
        </li>
      ))
    }
  </ul>

  <!-- The nudge is only offered once the answers are in — it is the decision
       the board leads to, not part of the board. -->
  <div
    class="hl-late flex flex-wrap items-center gap-x-3 gap-y-2.5 rounded-[10px] bg-[#2D7FF90F] px-3.5 py-3 outline-1 outline-[#2D7FF92E] -outline-offset-[0.5px]"
    style="--ld: 620ms;"
  >
    <span class="shrink-0 text-[#7AB8FF]"><HomeIcon name="bell" size={13} /></span>
    <p class="min-w-0 flex-1 text-[0.72rem] leading-[1.45] text-[#C3CDE0]">{t.nudge}</p>
    <span
      class="shrink-0 rounded-full bg-[#2D7FF9] px-3.5 py-1.5 text-[0.69rem] font-semibold text-[#F8FAFC]"
      >{t.send}</span
    >
  </div>
</CaptureFrame>
