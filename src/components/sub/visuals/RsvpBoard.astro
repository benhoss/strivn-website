---
/**
 * A call-up and the answers coming back.
 *
 * The five counters sum to the ten players called up, and the header's
 * "answered" figure is the eight who are not pending, so the nudge line's
 * "2 still pending" is arithmetic the reader can check. "Uncertain" is not
 * yet a state, so it stays neutral; the others wear their status.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, RSVP_COUNTS, RSVP_ROWS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].rsvp;

const ink = ['text-ready', 'text-watch', 'text-ink', 'text-risk', 'text-ink-3'];
const chip = [
  'st-chip st-chip--ready',
  'st-chip st-chip--watch',
  'st-chip',
  'st-chip st-chip--risk',
  'st-chip st-chip--wait',
];
---

<CaptureFrame title={t.title} meta={t.meta}>
  <ul class="counts">
    {
      RSVP_COUNTS.map((n, i) => (
        <li>
          <p class:list={['counts__n', n === 0 ? 'text-ink-4' : ink[i]]}>{n}</p>
          <p class="counts__k">{t.counts[i]}</p>
        </li>
      ))
    }
  </ul>

  <ul class="cap-rows">
    {
      RSVP_ROWS.map((r) => (
        <li>
          <span class="cap-grow">
            <span class="cap-name">{r.name}</span>
            <span class="cap-sub">{t.positions[r.pos]}</span>
          </span>
          <span class={`shrink-0 ${chip[r.answer]}`}>{t.answers[r.answer]}</span>
        </li>
      ))
    }
  </ul>

  <div class="st-proposal nudge">
    <span class="inline-flex shrink-0 text-electric-500"><HomeIcon name="bell" size={14} /></span>
    <p class="nudge__text">{t.nudge}</p>
    <span class="cap-btn cap-btn--primary">{t.send}</span>
  </div>
</CaptureFrame>

<style>
  .counts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .counts li {
    min-width: 0;
    padding: 10px 8px;
  }
  .counts li:first-child {
    padding-left: 0;
  }
  .counts li + li {
    border-left: 1px solid var(--color-line);
  }
  .counts__n {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .counts__k {
    margin: 2px 0 0;
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--color-ink-3);
    overflow-wrap: anywhere;
  }
  .nudge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    padding: 12px 14px;
  }
  .nudge__text {
    flex: 1 1 12rem;
    min-width: 0;
    margin: 0;
    font-size: 13px;
    color: var(--color-ink);
  }
</style>
