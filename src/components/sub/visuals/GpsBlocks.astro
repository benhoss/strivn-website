---
/**
 * GPS zones mapped onto named speed blocks.
 *
 * The arrow between the two panels turns downward on narrow screens, where
 * the panels stack: an arrow pointing right at a panel that now sits below
 * would misdescribe the relationship.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, GPS_ZONES, GPS_BLOCKS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].gps;

/** "Zone 1 + Zone 2 + Zone 3", or the elided form for the total. */
const formula = (zones: number[] | 'all') =>
  zones === 'all'
    ? `${t.zone} 1 + … + ${t.zone} ${GPS_ZONES.length}`
    : zones.map((z) => `${t.zone} ${z}`).join(' + ');
---

<div class="gps">
  <CaptureFrame meta={t.colsTitle} flush>
    <ul class="cap-rows cap-rows--pad">
      {
        GPS_ZONES.map((z) => (
          <li>
            <span class="cap-grow cap-name">
              {t.zone} {z.n}
            </span>
            <span class:list={['st-tag', !z.dist && 'gps-off']}>{z.dist ? t.dist : t.none}</span>
            <span class:list={['st-tag', !z.time && 'gps-off']}>{z.time ? t.time : t.none}</span>
          </li>
        ))
      }
    </ul>
  </CaptureFrame>

  <span class="gps__arrow" aria-hidden="true">
    <HomeIcon name="arrow-right" size={22} stroke={1.5} />
  </span>

  <CaptureFrame flush>
    <ul class="cap-rows cap-rows--pad">
      {
        GPS_BLOCKS.map((b, i) => (
          <li class="gps__block">
            <span class="gps__name">{t.blocks[i]}</span>
            <span class="gps__formula">{formula(b.zones)}</span>
          </li>
        ))
      }
    </ul>
  </CaptureFrame>
</div>

<style>
  .gps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }
  .gps__arrow {
    justify-self: center;
    color: var(--color-ink-4);
    transform: rotate(90deg);
  }
  .gps-off {
    border-style: dashed;
    color: var(--color-ink-4);
  }
  .gps__block {
    flex-wrap: wrap;
    padding-block: 16px;
  }
  .gps__name {
    flex: 0 0 200px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .gps__formula {
    flex: 1 1 12rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-ink-2);
  }
  @media (min-width: 1000px) {
    .gps {
      grid-template-columns: minmax(0, 360px) 40px minmax(0, 1fr);
      gap: 24px;
    }
    .gps__arrow {
      transform: none;
    }
  }
</style>
