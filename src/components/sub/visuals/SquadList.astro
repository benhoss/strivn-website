---
/**
 * The squad, split by the four statuses that decide who can be called up.
 * The tab counts add up to the header total, so the capture never claims a
 * squad it does not list. Present, adapted and injured are player states and
 * wear the status chips; "on trial" is a contract state and stays neutral.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, SQUAD_ROWS, SQUAD_TABS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].squad;

const chip = ['st-chip st-chip--ready', 'st-chip st-chip--watch', 'st-chip st-chip--risk', 'st-tag'];
---

<CaptureFrame title={t.title} meta={t.meta}>
  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
    {
      t.tabs.map((tab, i) => (
        <li class:list={['st-tag', i === 0 && 'st-tag--accent']}>
          {tab}
          <span class="cap-num">{SQUAD_TABS[i]}</span>
        </li>
      ))
    }
  </ul>

  <ul class="cap-rows">
    {
      SQUAD_ROWS.map((r) => (
        <li>
          <span class="squad__av" aria-hidden="true">
            {r.name[0]}
          </span>
          <span class="cap-grow">
            <span class="cap-name">{r.name}</span>
            <span class="cap-sub">{t.positions[r.pos]}</span>
          </span>
          <span class={`shrink-0 ${chip[r.status]}`}>{t.statuses[r.status]}</span>
        </li>
      ))
    }
  </ul>

  <Fragment slot="foot">
    <span class="text-ink-3"><HomeIcon name="info" size={14} /></span>
    <p>{t.note}</p>
  </Fragment>
</CaptureFrame>

<style>
  .squad__av {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-2);
  }
</style>
