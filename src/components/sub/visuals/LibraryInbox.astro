---
/**
 * A capture waiting to be sorted, and the two behind it in the queue.
 *
 * The fields are styled blocks rather than real inputs: nothing here is
 * focusable, so the capture never puts a fake form in the tab order.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, LIBRARY_QUEUE_ICONS } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].library;
---

<CaptureFrame title={t.title} meta={t.count}>
  <div class="inbox">
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
      <p class="m-0 flex min-w-0 items-center gap-2 text-ink-2">
        <span class="inline-flex shrink-0 text-ink-3"><HomeIcon name="external-link" size={13} /></span>
        <span class="truncate">{t.source}</span>
      </p>
      <p class="cap-sub shrink-0">{t.via}</p>
    </div>

    <div>
      <p class="cap-k flex flex-wrap items-center gap-2">
        {t.titleKey}
        <span class="st-tag st-tag--accent">{t.ai}</span>
      </p>
      <p class="cap-field">{t.name}</p>
    </div>

    <div>
      <p class="cap-k">{t.folderKey}</p>
      <p class="cap-field">{t.folder}</p>
    </div>

    <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
      {t.tags.map((tag) => <li class="st-tag">{tag}</li>)}
    </ul>

    <div class="cap-btns">
      <span class="cap-btn">{t.file}</span>
      <span class="cap-btn cap-btn--primary">{t.publish}</span>
    </div>
  </div>

  <ul class="cap-rows">
    {
      t.queue.map((q, i) => (
        <li>
          <span class="inline-flex shrink-0 text-ink-3">
            <HomeIcon name={LIBRARY_QUEUE_ICONS[i]} size={14} />
          </span>
          <span class="cap-grow text-ink-2">{q.t}</span>
          <span class="cap-num shrink-0 text-ink-3">{q.m}</span>
        </li>
      ))
    }
  </ul>
</CaptureFrame>

<style>
  .inbox {
    display: grid;
    gap: 14px;
    padding: 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    background: var(--color-navy-900);
  }
  .inbox :global(.cap-field) {
    background: var(--color-navy-950);
  }
</style>
