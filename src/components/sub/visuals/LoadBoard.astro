---
/**
 * "Load · week 12" capture: three KPIs over the day's feed.
 *
 * The KPI values are mono and nowrap so "2 340 UA" never wraps its unit.
 * Only the ACWR (the squad inside its zone) and the alert count carry a
 * status colour; the total is a quantity, not a state.
 */
import type { Locale } from '../../../data/landingContent';
import { captureText, LOAD_ROW_STYLE } from '../../../data/subpages/captures';
import HomeIcon from '../../home/HomeIcon.astro';
import CaptureFrame from './CaptureFrame.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = captureText[locale].load;

/** KPI ink, in `t.stats` order: total, ratio, alerts. */
const statInk = ['ink-1', 'ink-ready', 'ink-watch'];
const rowInk: Record<string, string> = {
  neutral: 'text-ink-3',
  ready: 'text-ready',
  watch: 'text-watch',
  risk: 'text-risk',
};
---

<CaptureFrame title={t.title} meta={t.meta} flush>
  <div class="cap-kpis load-kpis">
    {
      t.stats.map((st, i) => (
        <div class="st-kpi">
          <span class="st-label">{st.k}</span>
          <span class={`st-kpi__v whitespace-nowrap ${statInk[i]}`}>{st.v}</span>
        </div>
      ))
    }
  </div>

  <ul class="cap-rows cap-rows--pad">
    {
      t.rows.map((r, i) => (
        <li>
          <span class={`inline-flex shrink-0 ${rowInk[LOAD_ROW_STYLE[i].tone]}`}>
            <HomeIcon name={LOAD_ROW_STYLE[i].icon} size={14} />
          </span>
          <span class="cap-grow text-ink-2">{r.text}</span>
          <span class="cap-num shrink-0 text-ink-3">{r.meta}</span>
        </li>
      ))
    }
  </ul>
</CaptureFrame>

<style>
  .load-kpis {
    padding: 16px;
    border-bottom: 1px solid var(--color-line);
  }
</style>
