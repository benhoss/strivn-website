---
/**
 * Sub-page hero. Two columns when the page names a visual (copy on the left,
 * the product panel on the right); one centred column when it does not.
 *
 * The header is sticky in the flow now, so the hero carries no top padding
 * for a fixed nav. Nothing here waits for a scroll to appear.
 */
import type { SubpageContent } from '../../data/subpages/types';
import { appStartUrl } from '../../lib/appUrl';
import type { Locale } from '../../data/landingContent';
import HomeIcon from '../home/HomeIcon.astro';
import SubStores from './SubStores.astro';
import SubVisual from './SubVisual.astro';

interface Props {
  locale: Locale;
  hero: SubpageContent['hero'];
  /** Features index label and URL, and this page's short name. */
  crumbs: { label: string; href: string; page: string };
}

const { locale, hero, crumbs } = Astro.props;
const split = Boolean(hero.visual);
---

<section
  class:list={['sub-hero st-grid-bg', split ? 'sub-hero--split' : 'sub-hero--center']}
  aria-labelledby="sub-hero-title"
>
  <div class="st-wrap sub-hero__grid">
    <div class="sub-hero__copy">
      <ol class="st-crumbs sub-hero__crumbs">
        <li><a href={crumbs.href}>{crumbs.label}</a></li>
        <li aria-current="page">{crumbs.page}</li>
      </ol>

      {
        hero.badge && (
          <p class="st-tag sub-hero__badge">
            <HomeIcon name={hero.badge.icon} size={12} />
            {hero.badge.label}
          </p>
        )
      }

      {hero.kickerShown && <p class="st-label st-eyebrow sub-hero__kicker">{hero.kicker}</p>}

      <h1 id="sub-hero-title" class="st-h1 sub-hero__title">{hero.title}</h1>

      <p class="st-lede">{hero.sub}</p>

      {
        hero.bullets && (
          <ul class="sub-hero__points">
            {hero.bullets.map((b) => (
              <li>
                <span class="sub-hero__tick" aria-hidden="true">
                  <HomeIcon name="check" size={14} />
                </span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        hero.ctas && (
          <div class="st-ctas sub-hero__ctas">
            <a class="st-btn st-btn--primary" href={appStartUrl(locale)}>
              {hero.ctas.primary}
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            {hero.ctas.secondary && (
              <a class="st-btn st-btn--ghost" href={hero.ctas.secondary.href}>
                {hero.ctas.secondary.label}
              </a>
            )}
          </div>
        )
      }

      {
        hero.stores && (
          <SubStores locale={locale} app={hero.stores} class={split ? '' : 'justify-center'} />
        )
      }
    </div>

    {
      split && (
        <div class="sub-hero__visual">
          <SubVisual name={hero.visual!} locale={locale} />
        </div>
      )
    }
  </div>
</section>

<style>
  .sub-hero {
    padding-block: clamp(40px, 6vw, 88px) clamp(56px, 8vw, 104px);
  }
  .sub-hero__grid {
    position: relative;
  }
  .sub-hero--split .sub-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .sub-hero__copy {
    display: grid;
    gap: 24px;
    align-content: start;
    min-width: 0;
  }
  .sub-hero--center .sub-hero__copy {
    max-width: 860px;
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
  .sub-hero__crumbs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sub-hero--center .sub-hero__crumbs,
  .sub-hero--center .sub-hero__ctas {
    justify-content: center;
  }
  .sub-hero__crumbs [aria-current] {
    color: var(--color-ink-3);
  }
  .sub-hero__badge,
  .sub-hero__kicker {
    margin: 0;
    justify-self: start;
  }
  .sub-hero--center .sub-hero__badge,
  .sub-hero--center .sub-hero__kicker {
    justify-self: center;
  }
  /* In two columns the title shares the row with a panel: the display voice
     one step down, so a long German compound still fits the measure. */
  .sub-hero--split .sub-hero__title {
    font-size: clamp(38px, 4.3vw, 62px);
  }
  .sub-hero--center .sub-hero__title {
    max-width: 18ch;
  }
  .sub-hero__points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .sub-hero__points li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .sub-hero__tick {
    flex: none;
    color: var(--color-ink-3);
    transform: translateY(2px);
  }
  .sub-hero__ctas {
    margin-top: 4px;
  }
  .sub-hero__visual {
    min-width: 0;
  }
  .sub-hero__visual :global(.st-panel) {
    box-shadow: var(--shadow-float-lg);
  }
  @media (max-width: 1000px) {
    .sub-hero--split .sub-hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
