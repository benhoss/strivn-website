---
/**
 * Shell for every feature sub-page: header, hero, data-driven sections, then
 * the closing CTA and footer shared with the homepage.
 *
 * Nav comes from `nav.ts` and the footer from `homeContent`, rather than each
 * page's own file: sixteen copies of the same six-locale nav would be sixteen
 * places to forget. The closing band has its own copy in `subpages/closing.ts`.
 */
import { NAV } from '../../data/nav';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SubHero from './SubHero.astro';
import SubSections from './SubSections.astro';
import SubClosing from './SubClosing.astro';
import HomeFooter from '../home/HomeFooter.astro';
import { homeContent } from '../../data/homeContent';
import type { Locale } from '../../data/landingContent';
import type { SubpageContent } from '../../data/subpages/types';

interface Props {
  locale: Locale;
  /** Path segment under `/{locale}/features/`. */
  slug: string;
  content: SubpageContent;
}

const { locale, slug, content } = Astro.props;
const shared = homeContent[locale];

const LOCALES: Locale[] = ['en', 'fr', 'nl', 'de', 'pt', 'es'];
const path = (l: Locale) => `/${l}/features/${slug}/`;
const canonicalPath = path(locale);

const switchHrefs = Object.fromEntries(LOCALES.map((l) => [l, path(l)])) as Record<Locale, string>;
const alternates = [
  ...LOCALES.map((l) => ({ hreflang: l, href: path(l) })),
  { hreflang: 'x-default', href: path('fr') },
];

const skipLabel: Record<Locale, string> = {
  fr: 'Aller au contenu',
  nl: 'Naar de inhoud',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  es: 'Ir al contenido',
  en: 'Skip to content',
};

/**
 * Short page name ("Charge, RPE & GPS") for the visible breadcrumb and the
 * JSON-LD one: the meta title without its brand suffix. The hero title is a
 * sentence, which reads badly as a crumb.
 */
const pageName = content.meta.title.replace(/\s*\|\s*STRIVN\s*$/, '');

/** The features index entry of the nav, found by URL rather than position. */
const featuresHref = `/${locale}/features/`;
const featuresLabel =
  NAV[locale].links.find((l) => 'href' in l && l.href === featuresHref)?.label ?? 'Features';

/** Breadcrumb so the sub-page reads as a child of the features index. */
const site = 'https://strivn.net';
const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'STRIVN', item: `${site}/${locale}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: featuresLabel,
        item: `${site}${featuresHref}`,
      },
      { '@type': 'ListItem', position: 3, name: pageName, item: `${site}${canonicalPath}` },
    ],
  },
];
---

<BaseLayout
  lang={locale}
  title={content.meta.title}
  description={content.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={jsonLdExtra}
>
  <a href="#s-main" class="s-skip">{skipLabel[locale]}</a>

  <SiteHeader
    locale={locale}
    links={NAV[locale].links}
    cta={NAV[locale].cta}
    switchHrefs={switchHrefs}
  />

  <main id="s-main" class="bg-void font-sans text-ink antialiased">
    <SubHero
      locale={locale}
      hero={content.hero}
      crumbs={{ label: featuresLabel, href: featuresHref, page: pageName }}
    />
    <SubSections sections={content.sections} locale={locale} />
    <SubClosing locale={locale} />
  </main>

  <HomeFooter locale={locale} footer={shared.footer} />
</BaseLayout>
