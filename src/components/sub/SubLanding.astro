---
/**
 * Shell for every feature sub-page: header, hero, data-driven sections, then
 * the closing CTA and footer shared with the homepage.
 *
 * Nav and footer come from `homeContent` rather than each page's own file —
 * fifteen copies of the same six-locale nav would be fifteen places to forget.
 */
import '../../styles/home.css';
import { NAV } from '../../data/nav';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteMotion from '../SiteMotion.astro';
import SubHero from './SubHero.astro';
import SubSections from './SubSections.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import HomeFooter from '../home/HomeFooter.astro';
import { homeContent } from '../../data/homeContent';
import type { Locale } from '../../data/landingContent';
import type { SubpageContent } from '../../data/subpages/types';

interface Props {
  locale: Locale;
  /** Path segment under `/{locale}/features/`. */
  slug: string;
  content: SubpageContent;
}

const { locale, slug, content } = Astro.props;
const shared = homeContent[locale];

const LOCALES: Locale[] = ['en', 'fr', 'nl', 'de', 'pt', 'es'];
const path = (l: Locale) => `/${l}/features/${slug}/`;
const canonicalPath = path(locale);

const switchHrefs = Object.fromEntries(LOCALES.map((l) => [l, path(l)])) as Record<Locale, string>;
const alternates = [
  ...LOCALES.map((l) => ({ hreflang: l, href: path(l) })),
  { hreflang: 'x-default', href: path('fr') },
];

const skipLabel: Record<Locale, string> = {
  fr: 'Aller au contenu',
  nl: 'Naar de inhoud',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  es: 'Ir al contenido',
  en: 'Skip to content',
};

/** Breadcrumb so the sub-page reads as a child of the features index. */
const site = 'https://strivn.net';
const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'STRIVN', item: `${site}/${locale}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: NAV[locale].links[1]?.label ?? 'Features',
        item: `${site}/${locale}/features/`,
      },
      { '@type': 'ListItem', position: 3, name: content.hero.title, item: `${site}${canonicalPath}` },
    ],
  },
];
---

<BaseLayout
  lang={locale}
  title={content.meta.title}
  description={content.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={jsonLdExtra}
>
  <a href="#s-main" class="s-skip">{skipLabel[locale]}</a>

  <SiteHeader
    locale={locale}
    links={NAV[locale].links}
    cta={NAV[locale].cta}
    switchHrefs={switchHrefs}
  />

  <main id="s-main" class="bg-[#05070F] font-sans text-[#F8FAFC] antialiased">
    <SubHero locale={locale} hero={content.hero} />
    <SubSections sections={content.sections} locale={locale} />
    <HomeFinalCta locale={locale} finalCta={shared.finalCta} />
  </main>

  <HomeFooter locale={locale} footer={shared.footer} />

  <SiteMotion />
</BaseLayout>
