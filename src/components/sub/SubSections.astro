---
/**
 * Renders a feature sub-page's sections from data.
 *
 * Every section is one `st-sec` band: one hairline above, no alternating
 * background. Groups of items are hairline columns or hairline rows, never
 * boxed cards. Each section may close with an aside, a banner or a last
 * paragraph; those are trailing slots rather than sections of their own, so
 * the band keeps one set of vertical padding.
 *
 * Colour: green / orange / red become ready / watch / risk, and only where the
 * item describes a player's state (row chips and names, column labels, card
 * icons). Panels, comparisons and figures stay neutral. Blue is the electric
 * label accent.
 */
import type { Section, Tone } from '../../data/subpages/types';
import type { Locale } from '../../data/landingContent';
import HomeIcon from '../home/HomeIcon.astro';
import SubVisual from './SubVisual.astro';
import SubCallout from './SubCallout.astro';
import SubNote from './SubNote.astro';
import SubStores from './SubStores.astro';
import PartnerTiles from '../shared/PartnerTiles.astro';

interface Props {
  sections: Section[];
  locale: Locale;
}

const { sections, locale } = Astro.props;

/** Status ink, for content that is a player's state. Scoped classes rather
 *  than Tailwind utilities: the `st-*` type rules come later in the cascade
 *  and would win over a utility's colour. */
const status: Partial<Record<Tone, string>> = {
  green: 'ink-ready',
  orange: 'ink-watch',
  red: 'ink-risk',
};
/** Mono label: electric for blue, status ink for a state, neutral otherwise. */
const label = (tone?: Tone) =>
  tone === 'blue' ? 'st-label st-label--accent' : `st-label ${(tone && status[tone]) ?? ''}`;
/** Chip on a definition row. A state gets a status chip; anything else a tag. */
const chip = (tone?: Tone) =>
  tone === 'green'
    ? 'st-chip st-chip--ready'
    : tone === 'orange'
      ? 'st-chip st-chip--watch'
      : tone === 'red'
        ? 'st-chip st-chip--risk'
        : tone === 'blue'
          ? 'st-tag st-tag--accent'
          : 'st-tag';
/** Hairline grid class for n items: 2, 3 or 4 across at desktop width. */
const grid = (n: number) => `sub-grid sub-grid--${Math.min(Math.max(n, 2), 4)}`;
---

{
  sections.map((s, i) => {
    const head = s.kicker || s.title || s.body;
    /* A section that is only a banner or an aside carries its content in the
       body; the trailing slots would repeat it. */
    const bare = s.kind === 'callout' || s.kind === 'note';
    /* A narrow capture shares the opening row with the heading instead of
       stranding half the band; a wide one keeps the row to itself. */
    const aside = Boolean(s.visual && s.visualAside && head);

    return (
      <section
        id={s.id}
        class:list={['st-sec sub-sec', bare && !head && 'st-sec--tight']}
        aria-labelledby={s.title ? `sub-s${i}` : undefined}
      >
        <div class="st-wrap">
          {(head || s.visual) && (
            <div class:list={['sub-open', aside && 'sub-open--aside']}>
              {head && (
                <div class="st-head sub-head">
                  {s.kicker && <p class="st-label st-eyebrow">{s.kicker}</p>}
                  {s.title && (
                    <h2 id={`sub-s${i}`} class="st-h2">
                      {s.title}
                    </h2>
                  )}
                  {s.body && <p class="st-body">{s.body}</p>}
                </div>
              )}
              {s.visual && (
                <div class="sub-vis">
                  <SubVisual name={s.visual} locale={locale} />
                </div>
              )}
            </div>
          )}

          {/* ── Items with an icon: hairline columns ─────────────── */}
          {s.kind === 'cards' && (
            <ul class={grid(s.per ?? 3)}>
              {s.cards.map((c) => (
                <li>
                  <span class:list={['sub-ico', c.tone && status[c.tone]]}>
                    <HomeIcon name={c.icon} size={18} />
                  </span>
                  <h3 class="st-h4">{c.title}</h3>
                  <p class="st-small">{c.desc}</p>
                </li>
              ))}
            </ul>
          )}

          {/* ── Definition rows ───────────────────────────────────── */}
          {s.kind === 'rows' && (
            <ul class="sub-rows">
              {s.rows.map((r) => (
                <li class:list={[r.chip && 'has-chip']}>
                  <div class="sub-rows__name">
                    {s.pill ? (
                      <span class="sub-pill">{r.name}</span>
                    ) : (
                      <h3 class:list={['st-h4', r.tone && status[r.tone]]}>{r.name}</h3>
                    )}
                    {r.sub && <p class="sub-rows__sub">{r.sub}</p>}
                  </div>
                  <p class="st-small">{r.desc}</p>
                  {r.chip && (
                    <div class="sub-rows__chip">
                      <span class={chip(r.chip.tone)}>{r.chip.label}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}

          {/* ── Columns split by hairlines ────────────────────────── */}
          {s.kind === 'columns' && (
            <ul class={grid(s.cols.length)}>
              {s.cols.map((c) => (
                <li>
                  {c.eyebrow && <p class={label(c.tone)}>{c.eyebrow}</p>}
                  <h3 class:list={['st-h4', !c.eyebrow && c.tone && status[c.tone]]}>{c.title}</h3>
                  <p class="st-small">{c.desc}</p>
                </li>
              ))}
            </ul>
          )}

          {/* ── One statement, or panels compared ─────────────────── */}
          {s.kind === 'panels' &&
            (s.panels.length === 1 ? (
              <div class="sub-statement">
                <h3 class="st-h2 st-h2--sm">{s.panels[0].title}</h3>
                <div class="sub-statement__body">
                  {s.panels[0].lead && <p class="sub-lead">{s.panels[0].lead}</p>}
                  {s.panels[0].desc && <p class="st-body">{s.panels[0].desc}</p>}
                </div>
              </div>
            ) : (
              <ul class={grid(s.panels.length)}>
                {s.panels.map((p) => (
                  <li class="sub-panel">
                    {p.eyebrow && (
                      <p class={p.tone === 'blue' ? 'st-label st-label--accent' : 'st-label'}>
                        {p.eyebrow}
                      </p>
                    )}
                    <h3 class="st-h3">{p.title}</h3>
                    {p.lead && <p class="sub-lead">{p.lead}</p>}
                    {p.desc && <p class="st-small">{p.desc}</p>}
                    {p.items && (
                      <ul class="sub-items">
                        {p.items.map((it) => (
                          <li>{it}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            ))}

          {/* ── Comparison table ──────────────────────────────────── */}
          {s.kind === 'compare' && (
            <div class="sub-cmp">
              <div class="sub-cmp__heads" aria-hidden="true">
                <span />
                {s.heads.map((h) => (
                  <p class="st-h4">{h}</p>
                ))}
              </div>
              <ul>
                {s.rows.map((r) => (
                  <li>
                    <p class="st-label">{r.label}</p>
                    <p class="st-small">
                      <span class="sub-cmp__mh">{s.heads[0]}</span>
                      {r.a}
                    </p>
                    <p class="st-small">
                      <span class="sub-cmp__mh">{s.heads[1]}</span>
                      {r.b}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* ── Before / during / after rail ─────────────────────── */}
          {s.kind === 'rail' && (
            <ol class={`${grid(s.steps.length)} sub-rail`}>
              {s.steps.map((st, si) => {
                const live = si === (s.activeIndex ?? -1);
                return (
                  <li class:list={[live && 'is-live']}>
                    <p class={live ? 'st-label st-label--accent' : 'st-label'}>{st.num}</p>
                    <h3 class="st-h4">{st.title}</h3>
                    <p class="st-small">{st.desc}</p>
                    {st.items && (
                      <ul class="sub-items">
                        {st.items.map((it) => (
                          <li>{it}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ol>
          )}

          {/* ── Nested scales ─────────────────────────────────────── */}
          {s.kind === 'nested' && (
            <ol class="sub-nest">
              {s.levels.map((lv, li) => (
                <li
                  class:list={[li === (s.activeIndex ?? -1) && 'is-live']}
                  style={`--depth: ${li};`}
                >
                  <div class="sub-nest__line">
                    <h3 class="st-h3">{lv.name}</h3>
                    <p
                      class={
                        li === (s.activeIndex ?? -1) ? 'st-label st-label--accent' : 'st-label'
                      }
                    >
                      {lv.where}
                    </p>
                  </div>
                  <p class="st-small">{lv.desc}</p>
                </li>
              ))}
            </ol>
          )}

          {/* ── Headline figures ──────────────────────────────────── */}
          {s.kind === 'stats' && (
            <ul class={`${grid(s.stats.length)} sub-stats`}>
              {s.stats.map((st) => (
                <li>
                  <p class="sub-n">{st.value}</p>
                  <p class="st-small">{st.label}</p>
                </li>
              ))}
            </ul>
          )}

          {/* ── Pointer to a neighbouring page ────────────────────── */}
          {s.kind === 'crosslink' && (
            <a href={s.link.href} class="st-btn st-btn--ghost">
              {s.link.label}
              <HomeIcon name="arrow-right" size={16} />
            </a>
          )}

          {/* ── Bespoke capture ───────────────────────────────────── */}
          {s.kind === 'visual' && <SubVisual name={s.name} locale={locale} />}

          {/* ── Marks of the systems STRIVN reads from ────────────── */}
          {s.kind === 'logos' && <PartnerTiles only={s.only} />}

          {/* ── Store badges ──────────────────────────────────────── */}
          {s.kind === 'stores' && <SubStores locale={locale} app={s.app} />}

          {/* ── Standalone banner / aside ─────────────────────────── */}
          {s.kind === 'callout' && (
            <SubCallout tone={s.tone} icon={s.icon} text={s.text} link={s.link} />
          )}
          {s.kind === 'note' && <SubNote label={s.label} desc={s.desc} icon={s.icon} />}

          {/* ── Trailing slots, inside the same band ──────────────── */}
          {!bare && s.callouts && (
            <div class="sub-trail sub-trail--callouts">
              {s.callouts.map((c) => (
                <SubCallout tone={c.tone} icon={c.icon} text={c.text} link={c.link} />
              ))}
            </div>
          )}
          {!bare && s.note && (
            <div class="sub-trail">
              <SubNote label={s.note.label} desc={s.note.desc} icon={s.note.icon} />
            </div>
          )}
          {!bare && s.foot && <p class="sub-trail sub-foot">{s.foot}</p>}
        </div>
      </section>
    );
  })
}

<style>
  /* ── Opening: heading, then the band's capture ─────────────────── */
  .sub-open {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .sub-open:last-child {
    margin-bottom: 0;
  }
  .sub-open .sub-head {
    margin-bottom: 0;
  }
  .sub-open:not(.sub-open--aside) .sub-head + .sub-vis {
    margin-top: clamp(32px, 4vw, 48px);
  }
  .sub-open--aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: 40px clamp(32px, 5vw, 72px);
    align-items: center;
  }
  @media (max-width: 1000px) {
    .sub-open--aside {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Hairline grid: columns split by rules, rows closed by one ───── */
  .sub-grid {
    --cols: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    border-top: 1px solid var(--color-line-strong);
  }
  .sub-grid > li {
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
    padding: 24px 0 26px;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 621px) {
    .sub-grid--2,
    .sub-grid--3,
    .sub-grid--4 {
      --cols: 2;
    }
    .sub-grid > li {
      padding-inline: 28px;
      border-left: 1px solid var(--color-line);
    }
    .sub-grid--2 > li:nth-child(2n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .sub-grid--2 > li:nth-child(2n) {
      padding-right: 0;
    }
  }
  @media (min-width: 621px) and (max-width: 1080px) {
    .sub-grid--3 > li:nth-child(2n + 1),
    .sub-grid--4 > li:nth-child(2n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .sub-grid--3 > li:nth-child(2n),
    .sub-grid--4 > li:nth-child(2n) {
      padding-right: 0;
    }
  }
  @media (min-width: 1081px) {
    .sub-grid--3 {
      --cols: 3;
    }
    .sub-grid--4 {
      --cols: 4;
    }
    .sub-grid--3 > li:nth-child(3n + 1),
    .sub-grid--4 > li:nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .sub-grid--3 > li:nth-child(3n),
    .sub-grid--4 > li:nth-child(4n) {
      padding-right: 0;
    }
  }
  .sub-ico {
    display: inline-flex;
    margin-bottom: 4px;
    color: var(--color-ink-3);
  }
  .ink-ready {
    color: var(--color-ready);
  }
  .ink-watch {
    color: var(--color-watch);
  }
  .ink-risk {
    color: var(--color-risk);
  }

  /* ── Definition rows ─────────────────────────────────────────── */
  .sub-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .sub-rows > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px 40px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .sub-rows__name {
    display: grid;
    gap: 6px;
    align-content: start;
    justify-items: start;
  }
  .sub-rows__sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-3);
  }
  .sub-rows > li > .st-small {
    max-width: 68ch;
  }
  .sub-pill {
    display: inline-flex;
    padding: 5px 10px;
    border: 1px solid var(--color-line-strong);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-ink);
  }
  @media (min-width: 761px) {
    .sub-rows > li {
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    }
  }
  @media (min-width: 1081px) {
    .sub-rows > li.has-chip {
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr) minmax(0, 200px);
    }
    .sub-rows__chip {
      justify-self: end;
    }
  }
  @media (min-width: 761px) and (max-width: 1080px) {
    .sub-rows__chip {
      grid-column: 2;
    }
  }

  /* ── Panels and statement ────────────────────────────────────── */
  .sub-lead {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .sub-panel .st-h3 {
    margin-bottom: 2px;
  }
  .sub-items {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .sub-items > li {
    display: flex;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .sub-items > li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    margin-top: 8px;
    border-radius: 1px;
    background: var(--color-ink-4);
  }
  .sub-rail > li.is-live .sub-items > li::before {
    background: var(--color-electric-500);
  }
  .sub-statement {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: start;
    padding-top: 32px;
    border-top: 1px solid var(--color-line-strong);
  }
  .sub-statement__body {
    display: grid;
    gap: 14px;
  }
  @media (max-width: 900px) {
    .sub-statement {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Comparison ──────────────────────────────────────────────── */
  .sub-cmp ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .sub-cmp__heads,
  .sub-cmp li {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px 40px;
  }
  .sub-cmp__heads {
    padding-bottom: 16px;
  }
  .sub-cmp li {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .sub-cmp li > .st-label {
    margin: 0;
    padding-top: 3px;
  }
  /* Column name before each value: read aloud everywhere, shown only once
     the columns stack and the heads row is gone. */
  .sub-cmp__mh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .sub-cmp__heads {
      display: none;
    }
    .sub-cmp li {
      grid-template-columns: minmax(0, 1fr);
    }
    .sub-cmp__mh {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      display: block;
      margin-bottom: 2px;
      font-weight: 600;
      color: var(--color-ink);
    }
  }

  /* ── Rail: the active step carries the electric rule ─────────── */
  .sub-rail > li.is-live {
    box-shadow: inset 0 2px 0 var(--color-electric);
  }

  /* ── Nested scales ───────────────────────────────────────────── */
  .sub-nest {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sub-nest > li {
    display: grid;
    gap: 8px;
    margin-left: calc(var(--depth) * clamp(12px, 3vw, 40px));
    padding: 22px 0 22px;
    border-top: 1px solid var(--color-line);
  }
  .sub-nest > li:first-child {
    border-top-color: var(--color-line-strong);
  }
  .sub-nest > li + li {
    padding-left: 24px;
    border-left: 1px solid var(--color-line);
  }
  .sub-nest > li.is-live {
    border-left-color: var(--color-electric);
  }
  .sub-nest__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }
  .sub-nest .st-small {
    max-width: 62ch;
  }

  /* ── Figures ─────────────────────────────────────────────────── */
  .sub-n {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  /* ── Trailing slots ──────────────────────────────────────────── */
  .sub-trail {
    margin-top: clamp(28px, 3.5vw, 40px);
  }
  .sub-trail--callouts {
    display: grid;
    gap: 12px;
  }
  .sub-foot {
    max-width: 72ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .sub-sec .st-small {
    margin: 0;
  }
</style>
