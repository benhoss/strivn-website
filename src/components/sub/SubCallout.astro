---
/**
 * Banner used both as a section of its own and as a section's trailing slot,
 * so the two spellings cannot drift apart.
 *
 * `blue` marks something STRIVN does or suggests (the assistant, a proposal):
 * it takes the `st-proposal` surface. Every other tone is a caution or an
 * aside about the product, not a player's state, so it stays a neutral
 * `st-block`. No coloured side stripe in either case.
 */
import type { Tone } from '../../data/subpages/types';
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  tone?: Tone;
  icon?: string;
  text: string;
  link?: { label: string; href: string };
  class?: string;
}

const { tone = 'plain', icon, text, link, class: className = '' } = Astro.props;
const proposal = tone === 'blue';
---

<div class:list={['sub-call', proposal ? 'st-proposal' : 'st-block', className]}>
  {
    icon && (
      <span class:list={['sub-call__ico', proposal ? 'text-electric-500' : 'text-ink-3']}>
        <HomeIcon name={icon} size={16} />
      </span>
    )
  }
  <p class="sub-call__text">{text}</p>
  {
    link && (
      <a href={link.href} class="st-link sub-call__link">
        {link.label}
      </a>
    )
  }
</div>

<style>
  .sub-call {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px 14px;
    padding: 16px 20px;
  }
  .sub-call.st-block {
    border-radius: 10px;
  }
  .sub-call__ico {
    flex: none;
    display: inline-flex;
    margin-top: 2px;
  }
  .sub-call__text {
    flex: 1 1 0;
    min-width: min(100%, 16rem);
    max-width: 78ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .sub-call__link {
    flex: none;
    align-self: center;
    font-size: 14px;
  }
</style>
