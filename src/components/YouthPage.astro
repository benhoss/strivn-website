---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import { type Locale } from '../data/landingContent';
import { appStartUrl } from '../lib/appUrl';
import HomeIcon from './home/HomeIcon.astro';
import PricingCta from './pricing/PricingCta.astro';
import { pngSize } from '../lib/pngSize';
import { youthContent } from '../data/youthContent';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = youthContent[locale];

const base = `/${locale}`;
const frPath = '/fr/equipes-jeunes/';
const enPath = '/en/youth-teams/';
const nlPath = '/nl/youth-teams/';
const dePath = '/de/youth-teams/';
const ptPath = '/pt/youth-teams/';
const esPath = '/es/youth-teams/';
const pathByLocale: Record<Locale, string> = {
  fr: frPath, en: enPath, nl: nlPath, de: dePath, pt: ptPath, es: esPath,
};
const canonicalPath = pathByLocale[locale];
const switchHrefs = { en: enPath, fr: frPath, nl: nlPath, de: dePath, pt: ptPath, es: esPath };
const alternates = [
  { hreflang: 'en', href: enPath },
  { hreflang: 'fr', href: frPath },
  { hreflang: 'nl', href: nlPath },
  { hreflang: 'de', href: dePath },
  { hreflang: 'pt', href: ptPath },
  { hreflang: 'es', href: esPath },
  { hreflang: 'x-default', href: frPath },
];

const site = 'https://strivn.net';
const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'STRIVN', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: c.eyebrow, item: `${site}${canonicalPath}` },
    ],
  },
];

// Illustrative hero mock: a convocation/RSVP card seen from the guardian's side.
const heroCard = {
  fr: {
    label: 'Convocation',
    group: 'U13',
    event: 'Match · Samedi 14:30',
    present: 'Présent',
    unsure: 'Incertain',
    absent: 'Absent',
    replyWho: 'Parent de Léa',
    replyMeta: 'a répondu pour Léa',
    consent: 'Consentement parental à jour',
  },
  en: {
    label: 'Call-up',
    group: 'U13',
    event: 'Match · Saturday 14:30',
    present: 'Present',
    unsure: 'Unsure',
    absent: 'Absent',
    replyWho: 'Léa’s parent',
    replyMeta: 'replied for Léa',
    consent: 'Parental consent up to date',
  },
  nl: {
    label: 'Oproeping',
    group: 'U13',
    event: 'Wedstrijd · za 14:30',
    present: 'Aanwezig',
    unsure: 'Onzeker',
    absent: 'Afwezig',
    replyWho: 'Ouder van Léa',
    replyMeta: 'antwoordde voor Léa',
    consent: 'Ouderlijke toestemming in orde',
  },
  de: {
    label: 'Aufgebot',
    group: 'U13',
    event: 'Spiel · Samstag 14:30',
    present: 'Dabei',
    unsure: 'Unsicher',
    absent: 'Abwesend',
    replyWho: 'Elternteil von Léa',
    replyMeta: 'hat für Léa geantwortet',
    consent: 'Elterliche Einwilligung aktuell',
  },
  pt: {
    label: 'Convocatória',
    group: 'Sub-13',
    event: 'Jogo · sábado 14:30',
    present: 'Presente',
    unsure: 'Incerto',
    absent: 'Ausente',
    replyWho: 'Encarregada de educação da Léa',
    replyMeta: 'respondeu pela Léa',
    consent: 'Consentimento parental em dia',
  },
  es: {
    label: 'Convocatoria',
    group: 'Sub-13',
    event: 'Partido · sábado 14:30',
    present: 'Voy',
    unsure: 'Duda',
    absent: 'No voy',
    replyWho: 'Tutora de Léa',
    replyMeta: 'ha respondido por Léa',
    consent: 'Consentimiento parental al día',
  },
}[locale];
---

<SubpageLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={jsonLdExtra}
  switchHrefs={switchHrefs}
>
  <section class="st-grid-bg yt-hero" aria-labelledby="youth-title">
    <div class="st-wrap st-split">
      <div class="yt-hero__copy">
        <nav class="st-crumbs" aria-label="Breadcrumb">
          <a href={`${base}/`}>STRIVN</a>
          <span aria-current="page">{c.crumb}</span>
        </nav>
        <h1 id="youth-title" class="st-h1">{c.hero.title}</h1>
        <p class="st-lede">{c.hero.lede}</p>
        <div class="st-ctas">
          <a href={appStartUrl(locale)} target="_blank" rel="noopener" class="st-btn st-btn--primary">
            {c.hero.cta}
            <HomeIcon name="arrow-right" size={16} />
          </a>
        </div>
      </div>

      <!-- The call-up as the guardian answers it. Product strings, not copy;
           decorative, so hidden from assistive tech. -->
      <div class="st-panel st-panel--float yt-card" aria-hidden="true">
        <div class="st-panel__bar yt-card__bar">
          <span class="st-label">{heroCard.label}</span>
          <span class="st-tag">{heroCard.group}</span>
        </div>
        <div class="st-panel__body yt-card__body">
          <p class="yt-card__event">{heroCard.event}</p>
          <div class="yt-card__choices">
            <span class="st-chip st-chip--ready">{heroCard.present}</span>
            <span class="st-tag">{heroCard.unsure}</span>
            <span class="st-tag">{heroCard.absent}</span>
          </div>
          <div class="yt-card__reply">
            <span class="yt-card__avatar">L</span>
            <span class="yt-card__who">
              <b>{heroCard.replyWho}</b>
              <span>{heroCard.replyMeta}</span>
            </span>
            <span class="st-num yt-card__time">08:42</span>
          </div>
          <p class="yt-card__consent">
            <HomeIcon name="shield-check" size={14} />
            <span>{heroCard.consent}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  {c.showcase.map((show, si) => (
    <section class="st-sec">
      <div class:list={['st-wrap st-split yt-show', { 'yt-show--flip': si % 2 === 1 }]}>
        <div class="st-head yt-show__head">
          <h2 class="st-h2 st-h2--sm">{show.title}</h2>
          <p class="st-body">{show.blurb}</p>
        </div>
        <div class="yt-show__media">
          {show.slides.map((sl) => (
            <figure class:list={['yt-fig', `yt-fig--${sl.kind}`]}>
              {sl.video ? (
                <video
                  class="st-shot"
                  poster={sl.img}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-label={sl.alt}
                  data-autoplay
                >
                  <source src={`${sl.video}.mp4`} type="video/mp4" />
                  <source src={`${sl.video}.webm`} type="video/webm" />
                </video>
              ) : (
                <img
                  class="st-shot"
                  src={sl.img}
                  alt={sl.alt}
                  width={pngSize(sl.img)?.width ?? (sl.kind === 'desktop' ? 1440 : 402)}
                  height={pngSize(sl.img)?.height ?? (sl.kind === 'desktop' ? 880 : 860)}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <figcaption class="st-label">{sl.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Six features: one object, hairlines between, no cards. -->
  <section class="st-sec" aria-labelledby="youth-features">
    <div class="st-wrap">
      <div class="st-head">
        <h2 id="youth-features" class="st-h2">{c.features.title}</h2>
        <p class="st-body">{c.featuresLead}</p>
      </div>
      <ul class="yt-feats">
        {c.features.items.map((item) => (
          <li>
            <h3 class="st-h4">{item.title}</h3>
            <p class="st-small">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The set-up is a real sequence, so it takes the rail. -->
  <section class="st-sec" aria-labelledby="youth-steps">
    <div class="st-wrap">
      <div class="st-head">
        <h2 id="youth-steps" class="st-h2">{c.howItWorks.title}</h2>
      </div>
      <ol class="yt-steps">
        {c.howItWorks.steps.map((step, i) => (
          <li class="st-frame">
            <div class="st-stamp">
              <span class="st-stamp__a">{c.howItWorks.stepLabel}</span>
              <span class="st-stamp__b">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="yt-steps__body">
              <h3 class="st-h3">{step.title}</h3>
              <p class="st-body">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <PricingCta locale={locale} title={c.finalCta.title} sub={c.finalCta.body} primary={c.finalCta.cta} />
</SubpageLayout>

<style>
  .yt-hero {
    padding-block: clamp(56px, 8vw, 112px) clamp(56px, 7vw, 96px);
  }

  .yt-hero__copy {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .yt-hero__copy .st-h1 {
    max-width: 16ch;
  }

  /* Call-up card */
  .yt-card {
    width: 100%;
    max-width: 440px;
    justify-self: center;
  }

  .yt-card__bar {
    justify-content: space-between;
  }

  .yt-card__body {
    display: grid;
    gap: 18px;
    padding: 24px;
  }

  .yt-card__event {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    font-variation-settings: 'wdth' 85;
    color: var(--color-ink);
  }

  .yt-card__choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .yt-card__reply {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 14px 0;
    border-block: 1px solid var(--color-line);
  }

  .yt-card__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-navy-800);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink);
  }

  .yt-card__who {
    display: grid;
    gap: 2px;
    min-width: 0;
    font-size: 13px;
    color: var(--color-ink-3);
  }

  .yt-card__who b {
    font-weight: 500;
    font-size: 14.5px;
    color: var(--color-ink);
  }

  .yt-card__time {
    font-size: 12px;
    color: var(--color-ink-3);
  }

  .yt-card__consent {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    color: var(--color-ink-2);
  }

  /* Showcases */
  .yt-show__head {
    margin-bottom: 0;
  }

  .yt-show--flip .yt-show__head {
    order: 2;
  }

  .yt-fig {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .yt-fig--mobile {
    max-width: 300px;
    margin-inline: auto;
  }

  .yt-fig--mobile .st-shot {
    border-radius: 28px;
  }

  .yt-fig figcaption {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 12px;
    line-height: 1.5;
  }

  /* Features */
  .yt-feats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line-strong);
  }

  .yt-feats li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px 24px 28px;
    border-bottom: 1px solid var(--color-line);
    min-width: 0;
  }

  .yt-feats li:not(:nth-child(3n + 1)) {
    border-left: 1px solid var(--color-line);
  }

  .yt-feats li:nth-child(3n + 1) {
    padding-left: 0;
  }

  /* Steps */
  .yt-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .yt-steps > li {
    padding: 28px 0;
    border-top: 1px solid var(--color-line);
  }

  .yt-steps > li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .yt-steps .st-stamp {
    border-top: 0;
    padding-top: 0;
  }

  .yt-steps__body {
    display: grid;
    gap: 10px;
  }

  @media (max-width: 1000px) {
    .yt-show--flip .yt-show__head {
      order: 0;
    }

    .yt-card {
      justify-self: start;
    }

    .yt-feats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .yt-feats li:nth-child(n) {
      border-left: 0;
      padding-left: 24px;
    }

    .yt-feats li:nth-child(2n) {
      border-left: 1px solid var(--color-line);
    }

    .yt-feats li:nth-child(2n + 1) {
      padding-left: 0;
    }
  }

  @media (max-width: 620px) {
    .yt-feats {
      grid-template-columns: minmax(0, 1fr);
    }

    .yt-feats li:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>

<script>
  // Demo videos, if a showcase carries one: autoplay muted and looping only
  // in view and only without a reduced-motion request; otherwise the poster.
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
    if (reduce || !videos.length) return;
    if (!('IntersectionObserver' in window)) {
      videos.forEach((v) => {
        v.preload = 'auto';
        v.play().catch(() => {});
      });
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            v.preload = 'auto';
            v.play().catch(() => {});
          } else v.pause();
        });
      },
      { threshold: 0.4 },
    );
    videos.forEach((v) => io.observe(v));
  })();
</script>
