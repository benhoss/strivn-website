---
import type { ScPageContent } from '../../data/scPageContent';
import { PLAN_BARS } from '../../data/scPageContent';
import ScFrame from './ScFrame.astro';
import ScPoints from './ScPoints.astro';

interface Props {
  planning: ScPageContent['planning'];
}

const { planning: c } = Astro.props;
const v = c.visual;

/** Variance is a player's state: over plan is watch, within plan is ready. */
const chip: Record<string, string> = { orange: 'st-chip--watch', green: 'st-chip--ready', coral: 'st-chip--risk' };
---

<ScFrame id="planification" labelledby="sc-planning-title" stamp={c.stamp}>
  <div class="st-head">
    <h2 id="sc-planning-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-split st-split--wide-right st-split--top">
    <ScPoints points={c.points} cta={c.cta} href={c.href} />

    <figure class="st-panel lp">
      <div class="st-panel__bar">
        <div class="lp__head">
          <span class="lp__title">{v.week}</span>
          <span class="st-small text-ink-3">{v.goal}</span>
        </div>
        <span class="st-tag st-tag--accent lp__left">{v.remaining}</span>
      </div>

      <div class="st-panel__body lp__body">
        <div class="lp__group">
          <span class="st-label">{v.budgetLabel}</span>
          <ul class="lp__cats">
            {v.categories.map((cat) => (
              <li>
                <span class="lp__cat">{cat.name}</span>
                <span class="st-num lp__val">{cat.value}</span>
                <span class="st-meter lp__meter" aria-hidden="true"><i style={`width: ${cat.pct}%;`}></i></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lp__group">
          <div class="lp__charthead">
            <span class="st-label">{v.chartLabel}</span>
            <span class="lp__legend">
              <span><i class="lp__key lp__key--plan"></i>{v.legendPlanned}</span>
              <span><i class="lp__key lp__key--act"></i>{v.legendActual}</span>
            </span>
          </div>
          <div class="lp__chart" aria-hidden="true">
            {PLAN_BARS.map(([planned, actual], i) => (
              <div class="lp__day">
                <span class="lp__plan" style={`height: ${planned}%;`}></span>
                {actual !== null && <span class="lp__act" style={`height: ${actual}%;`}></span>}
              </div>
            ))}
          </div>
          <div class="lp__days st-num" aria-hidden="true">
            {v.days.map((d) => <span>{d}</span>)}
          </div>
        </div>

        <ul class="lp__var">
          {v.variance.map((row) => (
            <li>
              <span class="lp__cat">{row.name}</span>
              <span class={`st-chip ${chip[row.tone] ?? ''}`}>{row.delta}</span>
            </li>
          ))}
        </ul>
      </div>
    </figure>
  </div>

  <figure class="lp__shot">
    <img
      class="st-shot"
      src={c.shot.src}
      alt={c.shot.alt}
      width="2880"
      height="1760"
      loading="lazy"
      decoding="async"
    />
    <figcaption class="st-label">{c.shot.caption}</figcaption>
  </figure>
</ScFrame>

<style>
  figure {
    margin: 0;
  }
  .lp__head {
    display: grid;
    gap: 2px;
  }
  .lp__title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .lp__left {
    margin-left: auto;
  }
  .lp__body {
    display: grid;
    gap: 24px;
  }
  .lp__group {
    display: grid;
    gap: 12px;
  }
  .lp__cats,
  .lp__var {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .lp__cats li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .lp__meter {
    grid-column: 1 / -1;
  }
  .lp__cat {
    font-size: 14px;
    color: var(--color-ink);
  }
  .lp__val {
    font-size: 12.5px;
    color: var(--color-ink-2);
  }
  .lp__charthead {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    justify-content: space-between;
  }
  .lp__legend {
    display: flex;
    gap: 14px;
    font-size: 12px;
    color: var(--color-ink-3);
  }
  .lp__legend > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lp__key {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  .lp__key--plan {
    background: var(--color-navy-800);
    border: 1px dashed var(--color-navy-300);
  }
  .lp__key--act {
    background: var(--color-electric);
  }
  .lp__chart {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 10px;
    height: 128px;
    align-items: end;
    border-bottom: 1px solid var(--color-line-strong);
  }
  .lp__day {
    position: relative;
    height: 100%;
  }
  .lp__plan,
  .lp__act {
    position: absolute;
    bottom: 0;
    border-radius: 3px 3px 0 0;
  }
  .lp__plan {
    inset-inline: 0;
    background: var(--color-navy-850);
    border: 1px dashed var(--color-navy-500);
    border-bottom: 0;
  }
  .lp__act {
    inset-inline: 22%;
    background: var(--color-electric);
  }
  .lp__days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 10px;
    text-align: center;
    font-size: 11px;
    color: var(--color-ink-3);
  }
  .lp__var li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--color-line);
  }
  .lp__shot {
    display: grid;
    gap: 12px;
    margin-top: clamp(40px, 5vw, 64px);
  }
</style>
