---
/**
 * One band of the S&C page. The label is the section's topic (Charge,
 * Tests…), shown as an eyebrow above the section head. The page used to hang
 * each band on a day and a time of the coach's week; that read as a
 * prescribed routine and was dropped: sections are topics, not a schedule.
 */
interface Props {
  id?: string;
  labelledby: string;
  label: string;
}

const { id, labelledby, label } = Astro.props;
---

<section id={id} class="st-sec" aria-labelledby={labelledby}>
  <div class="st-wrap">
    <p class="st-label st-eyebrow sc-frame__label">{label}</p>
    <slot />
  </div>
</section>

<style>
  .sc-frame__label {
    margin: 0 0 20px;
  }
</style>
