---
import type { ScPageContent } from '../../data/scPageContent';
import HomeIcon from '../home/HomeIcon.astro';
import ScFrame from './ScFrame.astro';
import ScPoints from './ScPoints.astro';

interface Props {
  library: ScPageContent['library'];
}

const { library: c } = Astro.props;
const v = c.visual;
---

<ScFrame id="bibliotheque" labelledby="sc-library-title" stamp={c.stamp}>
  <div class="st-head">
    <h2 id="sc-library-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-split st-split--wide-right st-split--top">
    <ScPoints points={c.points} cta={c.cta} href={c.href} />

    <div class="st-panel lb">
      <div class="st-panel__bar">
        <div class="lb__head">
          <span class="lb__title">{v.title}</span>
          <span class="st-small text-ink-3">{v.sub}</span>
        </div>
        <span class="st-tag lb__badge"><HomeIcon name="pen-tool" size={11} />{v.badge}</span>
      </div>

      <div class="st-panel__body lb__body">
        <div class="lb__group">
          <span class="st-label">{v.metricsLabel}</span>
          <ul class="lb__metrics">
            {v.metrics.map((m) => (
              <li>
                <span class="lb__name">{m.name}</span>
                <span class="st-tag">{m.tag}</span>
                <span class="st-num lb__val">{m.value}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lb__scale">
          <span class="lb__scaletitle">
            <HomeIcon name="clock" size={13} class="text-ink-3" />
            {v.scalingTitle}
          </span>
          <div class="lb__scalecols">
            {v.scaling.map((s) => (
              <div>
                <span class="st-label">{s.label}</span>
                <span class="st-num lb__from">
                  <span class="text-ink-3">{s.from}</span>
                  {!s.unchanged && <span class="text-ink-4">→</span>}
                  <span class="text-ink">{s.to}</span>
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="lb__total">
          <div class="lb__totalrow">
            <span class="lb__name">{v.totalTitle}</span>
            <span class="st-num lb__val">{v.totalValue}</span>
          </div>
          <div class="lb__totalrow">
            <span class="st-small text-ink-3">{v.coverageLabel}</span>
            <span class="st-num lb__val">{v.coverageValue}</span>
          </div>
          <span class="st-meter" aria-hidden="true"><i style={`width: ${v.coveragePct}%;`}></i></span>
        </div>
      </div>
    </div>
  </div>
</ScFrame>

<style>
  .lb__head {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .lb__title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .lb__badge {
    margin-left: auto;
  }
  .lb__body {
    display: grid;
    gap: 22px;
  }
  .lb__group {
    display: grid;
    gap: 10px;
  }
  .lb__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .lb__metrics li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 104px;
    gap: 12px;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .lb__name {
    font-size: 14px;
    color: var(--color-ink);
    min-width: 0;
  }
  .lb__val {
    font-size: 12.5px;
    color: var(--color-ink);
    text-align: right;
    white-space: nowrap;
  }
  .lb__scale {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-navy-900);
  }
  .lb__scaletitle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .lb__scalecols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .lb__scalecols > div {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .lb__from {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 6px;
    font-size: 12.5px;
  }
  .lb__total {
    display: grid;
    gap: 10px;
  }
  .lb__totalrow {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 12px;
    align-items: baseline;
  }
  @media (max-width: 520px) {
    .lb__metrics li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .lb__metrics .st-tag {
      display: none;
    }
    .lb__scalecols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
