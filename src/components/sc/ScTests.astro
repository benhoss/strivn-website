---
import type { ScPageContent } from '../../data/scPageContent';
import { TEST_ROWS } from '../../data/scPageContent';
import HomeIcon from '../home/HomeIcon.astro';
import ScFrame from './ScFrame.astro';
import ScPoints from './ScPoints.astro';

interface Props {
  tests: ScPageContent['tests'];
}

const { tests: c } = Astro.props;
const v = c.visual;

/** A test delta describes the player: progress is ready, regression is watch. */
const deltaTone: Record<string, string> = { green: 'text-ready', orange: 'text-watch', coral: 'text-risk' };
---

<ScFrame id="tests" labelledby="sc-tests-title" label={c.tag}>
  <div class="st-head">
    <h2 id="sc-tests-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-split st-split--wide-right st-split--top">
    <ScPoints points={c.points} cta={c.cta} href={c.href} />

    <div class="st-panel ts">
      <div class="st-panel__bar">
        <div class="ts__head">
          <span class="ts__title">{v.title}</span>
          <span class="st-small text-ink-3">{v.sub}</span>
        </div>
        <span class="st-tag ts__badge"><HomeIcon name="link" size={11} />{v.badge}</span>
      </div>

      <div class="st-panel__body ts__body">
        <div class="ts__progress">
          <span class="st-label">{v.progressLabel}</span>
          <span class="st-figure ts__fig">{v.progressValue}</span>
          <span class="st-meter" aria-hidden="true"><i style={`width: ${v.progressPct}%;`}></i></span>
        </div>

        <div class="ts__group">
          <span class="st-label">{v.entriesLabel}</span>
          <ul class="ts__rows">
            {TEST_ROWS.map((row) => (
              <li>
                <span class="ts__name">{row.name}</span>
                <span class="st-num ts__val">{row.value}</span>
                <span class={`st-num ts__delta ${deltaTone[row.deltaTone ?? 'green']}`}>{row.delta ?? ''}</span>
                {row.state === 'received' ? (
                  <span class="st-tag ts__state">{v.stateReceived}</span>
                ) : (
                  <span class="st-chip st-chip--wait ts__state">{v.statePending}</span>
                )}
              </li>
            ))}
          </ul>
        </div>

        <p class="st-small ts__note">
          <HomeIcon name="corner-down-right" size={15} class="text-ink-3" />
          {v.note}
        </p>
      </div>
    </div>
  </div>
</ScFrame>

<style>
  .ts__head {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .ts__title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .ts__badge {
    margin-left: auto;
  }
  .ts__body {
    display: grid;
    gap: 22px;
  }
  .ts__progress {
    display: grid;
    gap: 10px;
  }
  .ts__fig {
    font-size: clamp(40px, 4.4vw, 56px);
  }
  .ts__group {
    display: grid;
    gap: 8px;
  }
  .ts__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .ts__rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 44px 104px;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .ts__name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ts__val {
    font-size: 12.5px;
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .ts__delta {
    font-size: 12px;
    text-align: right;
  }
  .ts__state {
    justify-self: end;
  }
  .ts__note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--color-ink-2);
  }
  @media (max-width: 520px) {
    .ts__rows li {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 4px 12px;
    }
    .ts__val {
      grid-column: 1;
      grid-row: 2;
    }
    .ts__delta {
      grid-column: 2;
      grid-row: 1;
    }
    .ts__state {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }
</style>
