---
import type { ScPageContent } from '../../data/scPageContent';
import ReportingDashboard from '../shared/ReportingDashboard.astro';
import HomeIcon from '../home/HomeIcon.astro';
import ScFrame from './ScFrame.astro';

interface Props {
  reports: ScPageContent['reports'];
}

const { reports: c } = Astro.props;
const r = c.report;
---

<ScFrame id="rapports" labelledby="sc-reports-title" stamp={c.stamp}>
  <div class="st-head">
    <h2 id="sc-reports-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="rp">
    <ReportingDashboard dashboard={c.dashboard} />

    <div class="st-panel rp__report">
      <div class="st-panel__bar">
        <span class="rp__title"><HomeIcon name="file-text" size={15} class="text-ink-3" />{r.title}</span>
        <span class="st-tag st-tag--accent rp__badge"><HomeIcon name="sparkles" size={10} />{r.aiBadge}</span>
      </div>
      <div class="st-panel__body rp__body">
        <p class="st-small rp__text">{r.body}</p>
        <ul class="rp__items">
          {r.items.map((item) => (
            <li>
              <HomeIcon name={item.icon} size={14} class="text-ink-3" />
              <span>{item.label}</span>
            </li>
          ))}
        </ul>
        <p class="st-proposal rp__strip">{r.aiStrip}</p>
      </div>
    </div>
  </div>
</ScFrame>

<style>
  .rp {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .rp__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .rp__badge {
    margin-left: auto;
  }
  .rp__body {
    display: grid;
    gap: 18px;
  }
  .rp__text {
    color: var(--color-ink);
  }
  .rp__items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .rp__items li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 13.5px;
    color: var(--color-ink-2);
  }
  .rp__strip {
    margin: 0;
    color: var(--color-ink);
  }
  @media (max-width: 1080px) {
    .rp {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
