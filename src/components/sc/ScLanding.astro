---
import '../../styles/home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteMotion from '../SiteMotion.astro';
import ScHero from './ScHero.astro';
import ScDaily from './ScDaily.astro';
import ScMetrics from './ScMetrics.astro';
import ScLoadPlanning from './ScLoadPlanning.astro';
import ScLibrary from './ScLibrary.astro';
import ScStrength from './ScStrength.astro';
import ScTests from './ScTests.astro';
import ScReports from './ScReports.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import HomeFooter from '../home/HomeFooter.astro';
import { scPageContent } from '../../data/scPageContent';
import { homeContent } from '../../data/homeContent';
import { SC_SLUG } from '../../data/solutionsContent';
import type { Locale } from '../../data/scPageContent';

interface Props {
  locale: Locale;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, canonicalPath, alternates } = Astro.props;
const c = scPageContent[locale];
/** Closing CTA and footer are shared with the homepage. */
const shared = homeContent[locale];

/**
 * The switcher falls back to a locale's homepage only for pages with no
 * counterpart. This one exists in all six — and French serves it from a
 * translated slug — so hand the header the real targets.
 */
const LOCALES: Locale[] = ['en', 'fr', 'nl', 'de', 'pt', 'es'];
const switchHrefs = Object.fromEntries(
  LOCALES.map((l) => [l, `/${l}/${SC_SLUG[l]}/`]),
) as Record<Locale, string>;

const skipLabelByLocale: Record<Locale, string> = {
  fr: 'Aller au contenu',
  nl: 'Naar de inhoud',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  es: 'Ir al contenido',
  en: 'Skip to content',
};
---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
>
  <a href="#s-main" class="s-skip">{skipLabelByLocale[locale]}</a>

  <SiteHeader locale={locale} links={c.nav.links} cta={c.nav.cta} switchHrefs={switchHrefs} />

  <main id="s-main" class="bg-[#05070F] font-sans text-[#F8FAFC] antialiased">
    <ScHero locale={locale} hero={c.hero} />
    <ScDaily daily={c.daily} />
    <ScMetrics metrics={c.metrics} />
    <ScLoadPlanning planning={c.planning} />
    <ScLibrary library={c.library} />
    <ScStrength strength={c.strength} />
    <ScTests tests={c.tests} />
    <ScReports reports={c.reports} />
    <HomeFinalCta locale={locale} finalCta={shared.finalCta} />
  </main>

  <HomeFooter locale={locale} footer={shared.footer} />

  <SiteMotion />
</BaseLayout>
