---
import type { ScPageContent, Locale } from '../../data/scPageContent';
import HomeIcon from '../home/HomeIcon.astro';
import { appStartUrl } from '../../lib/appUrl';
import ReadinessBoard from '../shared/ReadinessBoard.astro';

interface Props {
  locale: Locale;
  hero: ScPageContent['hero'];
}

const { locale, hero } = Astro.props;
---

<section class="sc-hero st-grid-bg" aria-labelledby="sc-hero-title">
  <div class="st-wrap">
    <div class="sc-hero__top">
      <div class="sc-hero__title">
        <p class="st-label st-eyebrow">{hero.kicker}</p>
        <h1 id="sc-hero-title" class="st-h1">{hero.title}</h1>
      </div>
      <div class="sc-hero__side">
        <p class="st-lede">{hero.sub}</p>
        <div class="st-ctas">
          <a class="st-btn st-btn--primary" href={appStartUrl(locale)} target="_blank" rel="noopener">
            {hero.primaryCta}
            <HomeIcon name="arrow-right" size={16} />
          </a>
          <a class="st-btn st-btn--ghost" href={hero.secondaryHref}>{hero.secondaryCta}</a>
        </div>
        <p class="st-fine">
          {hero.fine.map((f) => <span>{f}</span>)}
        </p>
      </div>
    </div>

    <ReadinessBoard board={hero.board} why class="sc-hero__board" />
  </div>
</section>

<style>
  .sc-hero {
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 8vw, 112px);
    overflow: hidden;
  }
  .sc-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .sc-hero__title {
    display: grid;
    gap: 24px;
  }
  .sc-hero__title .st-h1 {
    max-width: 16ch;
  }
  .sc-hero__side {
    display: grid;
    gap: 24px;
    padding-bottom: 6px;
  }
  .st-fine {
    margin: 0;
  }
  @media (max-width: 1000px) {
    .sc-hero__top {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .sc-hero__title .st-h1 {
      max-width: 18ch;
    }
  }
</style>
