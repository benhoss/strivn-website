---
import type { ScPageContent } from '../../data/scPageContent';
import { ONE_RM_ROWS } from '../../data/scPageContent';
import HomeIcon from '../home/HomeIcon.astro';
import ScFrame from './ScFrame.astro';
import ScPoints from './ScPoints.astro';

interface Props {
  strength: ScPageContent['strength'];
}

const { strength: c } = Astro.props;
const v = c.visual;
---

<ScFrame id="musculation" labelledby="sc-strength-title" label={c.tag}>
  <div class="st-head">
    <h2 id="sc-strength-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-split st-split--wide-right st-split--top">
    <ScPoints points={c.points} cta={c.cta} href={c.href} />

    <div class="st-panel sg">
      <div class="st-panel__bar">
        <span class="sg__title">{v.title}</span>
        <span class="st-tag sg__badge">{v.badge}</span>
      </div>

      <div class="st-panel__body sg__body">
        <div class="sg__ex">
          <span class="sg__exname"><HomeIcon name="dumbbell" size={15} class="text-ink-3" />{v.exercise}</span>
          <span class="st-num sg__rx">{v.prescription}</span>
        </div>

        <ul class="sg__modes" aria-label={v.title}>
          {v.modes.map((mode, i) => (
            <li class:list={['st-num', { 'is-on': i === 0 }]}>{mode}</li>
          ))}
        </ul>

        <div class="sg__group">
          <span class="st-label">{v.tableLabel}</span>
          <table class="sg__table">
            <thead>
              <tr>
                <th scope="col" class="st-label">{v.colPlayer}</th>
                <th scope="col" class="st-label">{v.colMax}</th>
                <th scope="col" class="st-label">{v.colLoad}</th>
              </tr>
            </thead>
            <tbody>
              {ONE_RM_ROWS.map((row) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  <td class="st-num text-ink-3">{row.max}</td>
                  <td class="st-num text-ink">{row.load}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="st-small sg__note">
          <HomeIcon name="smartphone" size={15} class="text-ink-3" />
          {v.note}
        </p>
      </div>
    </div>
  </div>
</ScFrame>

<style>
  .sg__title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .sg__badge {
    margin-left: auto;
  }
  .sg__body {
    display: grid;
    gap: 20px;
  }
  .sg__ex {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-line);
  }
  .sg__exname {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .sg__rx {
    font-size: 14px;
    color: var(--color-ink);
  }
  .sg__modes {
    list-style: none;
    margin: 0;
    padding: 3px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
  }
  .sg__modes li {
    padding: 7px 4px;
    border-radius: 6px;
    text-align: center;
    font-size: 12px;
    color: var(--color-ink-3);
  }
  .sg__modes li.is-on {
    background: var(--color-navy-800);
    color: var(--color-ink);
  }
  .sg__group {
    display: grid;
    gap: 8px;
  }
  .sg__table {
    width: 100%;
    border-collapse: collapse;
  }
  .sg__table th,
  .sg__table td {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    font-size: 13px;
  }
  .sg__table thead th {
    padding-top: 4px;
    font-size: 10.5px;
    font-weight: 500;
  }
  .sg__table tbody th {
    font-weight: 500;
    font-size: 14px;
    color: var(--color-ink);
  }
  .sg__table th:not(:first-child),
  .sg__table td {
    text-align: right;
  }
  .sg__note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--color-ink-2);
  }
</style>
