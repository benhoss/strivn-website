---
import type { ScPageContent } from '../../data/scPageContent';
import ScFrame from './ScFrame.astro';

interface Props {
  metrics: ScPageContent['metrics'];
}

const { metrics: c } = Astro.props;
---

<ScFrame id="indicateurs" labelledby="sc-metrics-title" stamp={c.stamp}>
  <div class="st-head">
    <h2 id="sc-metrics-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <dl class="sc-defs">
    {c.items.map((item) => (
      <div>
        <dt>{item.name}</dt>
        <dd class="st-num">{item.detail}</dd>
      </div>
    ))}
  </dl>
</ScFrame>

<style>
  .sc-defs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
    margin: 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .sc-defs > div {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 16px;
    align-items: baseline;
    padding: 15px 0;
    border-bottom: 1px solid var(--color-line);
    min-width: 0;
  }
  .sc-defs dt {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .sc-defs dd {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-ink-3);
  }
  @media (max-width: 1080px) {
    .sc-defs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .sc-defs > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
