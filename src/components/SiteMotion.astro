---
/**
 * Shared motion runtime for the marketing pages.
 *
 * Since the 2026-09 redesign every page is legible at rest: nothing waits at
 * opacity 0 for an observer, and no figure is rewound to zero to count back
 * up. Screenshots, link previews and a reader who skims all get the real page.
 *
 * What is left is one progressive enhancement: `[data-st-inview]` gets
 * `.is-inview` while it is on screen, for components that want to *start* an
 * animation (a scan, a pulse) only when someone is looking. The resting state
 * must already be complete without it.
 */
---

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-st-inview]');
  if (els.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-inview', e.isIntersecting)),
      { rootMargin: '0px 0px -10% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
