---
/**
 * Competitive landing, French only. Built from the site primitives in
 * system.css and the shared chrome. The pricing band is `PricingPlans`,
 * fed by the catalogue, so the figures cannot drift from /fr/pricing/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import HomeFooter from '../home/HomeFooter.astro';
import HomeFaq from '../home/HomeFaq.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import HomeIcon from '../home/HomeIcon.astro';
import PricingPlans from '../pricing/PricingPlans.astro';
import { NAV } from '../../data/nav';
import { homeContent, HERO_FILE, HERO_ROWS, HERO_TIME, PROOF_FIGURES } from '../../data/homeContent';
import { alternativeTeamworks as c, ALTERNATIVE_PATH, plansForLanding } from '../../data/alternativeTeamworks';
import { pricingContent } from '../../data/pricingContent';
import { appStartUrl } from '../../lib/appUrl';
import { catalogueOffers } from '../../lib/planPrice';
import { SKIP_LABEL } from '../../lib/skipLabel';

const locale = 'fr' as const;
const home = homeContent[locale];
const pricing = pricingContent[locale];
const register = appStartUrl(locale);

/** Same roster as the homepage hero; this page shows the four columns it talks about. */
const rows = HERO_ROWS.slice(0, 4);
const tone = (row: (typeof rows)[number], cell: 'sleep' | 'acwr') =>
  row.risk?.includes(cell) ? 'is-risk' : row.hot?.includes(cell) ? 'is-hot' : undefined;

const pageUrl = `https://strivn.net${ALTERNATIVE_PATH}`;
const jsonLdExtra: Record<string, unknown>[] = [
  {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: c.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'STRIVN', item: 'https://strivn.net/fr/' },
      { '@type': 'ListItem', position: 2, name: c.hero.eyebrow, item: pageUrl },
    ],
  },
  {
    '@type': 'Product',
    '@id': `${pageUrl}#product`,
    name: 'STRIVN',
    description: c.meta.description,
    offers: catalogueOffers(pricing.plans.items, pageUrl),
  },
];

/** This URL exists in French only. Other languages fall back to their home. */
const alternates = [
  { hreflang: 'fr', href: ALTERNATIVE_PATH },
  { hreflang: 'x-default', href: ALTERNATIVE_PATH },
];
---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={ALTERNATIVE_PATH}
  alternates={alternates}
  ogImage={c.meta.ogImage}
  ogImageAlt={c.meta.ogImageAlt}
  ogTitle={c.meta.ogTitle}
  ogDescription={c.meta.ogDescription}
  twitterTitle={c.meta.twitterTitle}
  twitterDescription={c.meta.twitterDescription}
  jsonLdExtra={jsonLdExtra}
>
  <a href="#s-main" class="s-skip">{SKIP_LABEL[locale]}</a>

  <SiteHeader
    locale={locale}
    links={NAV[locale].links}
    cta={NAV[locale].cta}
    switchHrefs={{ fr: ALTERNATIVE_PATH }}
  />

  <main id="s-main">
    <section class="alt-hero st-grid-bg" aria-labelledby="alt-hero-title">
      <div class="st-wrap">
        <div class="alt-hero__grid">
          <div class="alt-hero__copy">
            <span class="st-label st-eyebrow">{c.hero.eyebrow}</span>
            <h1 id="alt-hero-title" class="st-h1">
              <span class="st-muted alt-hero__lead">{c.hero.titleLead}</span>
              {c.hero.title}
            </h1>
            <p class="st-lede">{c.hero.lede}</p>
            <div class="st-ctas">
              <a class="st-btn st-btn--primary" href={register} target="_blank" rel="noopener">
                {c.hero.primaryCta}
                <HomeIcon name="arrow-right" size={16} />
              </a>
              <a class="st-btn st-btn--ghost" href={c.hero.secondaryHref}>{c.hero.secondaryCta}</a>
            </div>
            <p class="st-fine">{c.hero.perks.map((perk) => <span>{perk}</span>)}</p>
          </div>

          <figure class="st-panel st-panel--float alt-board" aria-label={c.hero.panelAria}>
            <div class="alt-board__bar">
              <span class="alt-board__file">{HERO_FILE}</span>
              <span class="alt-board__state">Lecture <i>{HERO_TIME}</i></span>
            </div>
            <div class="alt-board__scroll">
              <table>
                <thead>
                  <tr>
                    <th scope="col">{c.hero.columns[0]}</th>
                    <th scope="col">{c.hero.columns[1]}</th>
                    <th scope="col" class="sleep">{c.hero.columns[2]}</th>
                    <th scope="col">{c.hero.columns[3]}</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((row) => (
                    <tr>
                      <td class="name">{row.name}</td>
                      <td class={tone(row, 'acwr')}>{row.acwr}</td>
                      <td class:list={['sleep', tone(row, 'sleep')]}>{row.sleep}</td>
                      <td class="dec">
                        <span class={`st-chip st-chip--${row.state}`}>{c.hero.readings[row.state]}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <figcaption class="alt-board__foot">
              <p><strong>{c.hero.proposed}</strong> {c.hero.proposal}</p>
              <span class="st-label">{c.hero.sources}</span>
            </figcaption>
          </figure>
        </div>

        <dl class="alt-stats" aria-label={c.hero.statsAria}>
          {PROOF_FIGURES.map((n, i) => (
            <div>
              <dt>{home.proof.figures[i]}</dt>
              <dd data-st-count>{n}</dd>
            </div>
          ))}
        </dl>
        <p class="st-small alt-stats__cap">{c.hero.statsCaption}</p>
      </div>
    </section>

    <section class="st-sec" id={c.opteamal.id} aria-labelledby="opteamal-title">
      <div class="st-wrap">
        <div class="st-head">
          <span class="st-label st-eyebrow">{c.opteamal.eyebrow}</span>
          <h2 id="opteamal-title" class="st-h2">{c.opteamal.title}</h2>
          <p class="st-lede">{c.opteamal.lede}</p>
        </div>
        <div class="alt-pair">
          <article class="st-block alt-card">
            <h3 class="st-h3">{c.opteamal.change.title}</h3>
            <ul class="st-facts alt-timeline">
              {c.opteamal.change.timeline.map((step) => (
                <li><b>{step.when}</b><span>{step.what}</span></li>
              ))}
            </ul>
            <p class="st-body">{c.opteamal.change.body}</p>
            <ul class="st-rules">
              {c.opteamal.change.questions.map((q) => <li>{q}</li>)}
            </ul>
          </article>
          <article class="st-block alt-card alt-offer">
            <span class="st-tag st-tag--accent">{c.opteamal.offer.tag}</span>
            <h3 class="st-h3">{c.opteamal.offer.title}</h3>
            <p class="st-body">{c.opteamal.offer.body}</p>
            <ul class="alt-points">
              {c.opteamal.offer.points.map((point) => (
                <li><strong>{point.lead}</strong>{point.rest}</li>
              ))}
            </ul>
            <a class="st-btn st-btn--primary" href={c.opteamal.offer.href}>{c.opteamal.offer.cta}</a>
          </article>
        </div>
      </div>
    </section>

    <section class="st-sec" id={c.compare.id} aria-labelledby="compare-title">
      <div class="st-wrap">
        <div class="st-head">
          <span class="st-label st-eyebrow">{c.compare.eyebrow}</span>
          <h2 id="compare-title" class="st-h2">{c.compare.title}</h2>
          <p class="st-lede">{c.compare.lede}</p>
        </div>
        <div class="alt-cmp">
          <table>
            <thead>
              <tr>
                <th scope="col">{c.compare.columns.criterion}</th>
                <th scope="col">{c.compare.columns.strivn}</th>
                <th scope="col">{c.compare.columns.ams}</th>
              </tr>
            </thead>
            <tbody>
              {c.compare.rows.map((row) => (
                <tr>
                  <th scope="row">{row.criterion}</th>
                  <td class="us" data-side={c.compare.columns.strivn}>
                    <HomeIcon name="check" size={14} />
                    <span>{row.strivn}</span>
                  </td>
                  <td class:list={['them', row.amsMuted && 'is-muted']} data-side={c.compare.columns.ams}>{row.ams}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="st-cols alt-fair">
          {c.compare.fair.map((item) => (
            <div>
              <span class="st-label">{item.tag}</span>
              <h3 class="st-h3">{item.title}</h3>
              <p class="st-body">{item.body}</p>
            </div>
          ))}
        </div>
        <p class="st-small alt-note">{c.compare.note}</p>
      </div>
    </section>

    <PricingPlans
      locale={locale}
      plans={plansForLanding(pricing.plans)}
      matrix={pricing.matrix}
      email={pricing.faq.email}
      sectionId="tarifs"
      compareHref={`/${locale}/pricing/#compare`}
      gpsNote={c.gpsNote}
    />

    {c.testimonials.items.length > 0 && (
      <section class="st-sec" id={c.testimonials.id} aria-labelledby="quotes-title">
        <div class="st-wrap">
          <div class="st-head">
            <span class="st-label st-eyebrow">{c.testimonials.eyebrow}</span>
            <h2 id="quotes-title" class="st-h2">{c.testimonials.title}</h2>
            <p class="st-lede">{c.testimonials.lede}</p>
          </div>
          <div class="alt-quotes">
            {c.testimonials.items.map((item) => (
              <figure class="st-block alt-quote">
                <blockquote><p class="st-body">{item.quote}</p></blockquote>
                <figcaption>
                  <b>{item.name}</b>
                  <span class="st-label">{item.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <HomeFaq c={c.faq} />
    <HomeFinalCta
      locale={locale}
      finalCta={c.finalCta}
      eyebrow={c.finalCta.eyebrow}
      secondaryHref={c.finalCta.secondaryHref}
    />
  </main>

  <HomeFooter locale={locale} footer={home.footer} note={c.disclaimer} />
</BaseLayout>

<style>
  .alt-hero {
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 88px) clamp(56px, 8vw, 96px);
  }
  .alt-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .alt-hero__copy {
    display: grid;
    gap: 22px;
    justify-items: start;
    min-width: 0;
  }
  .alt-hero__lead {
    display: block;
  }
  .alt-hero__copy .st-fine {
    margin: 0;
  }

  .alt-board {
    margin: 0;
    min-width: 0;
  }
  .alt-board__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .alt-board__file {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-2);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .alt-board__file::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 10px;
    margin-right: 8px;
    border: 1px solid var(--color-navy-300);
    border-radius: 1px;
    vertical-align: -1px;
  }
  .alt-board__state {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .alt-board__state i {
    font-style: normal;
    color: var(--color-ready);
  }
  .alt-board__scroll {
    overflow-x: auto;
  }
  .alt-board table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .alt-board th {
    padding: 10px 12px;
    text-align: left;
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-line);
  }
  .alt-board td {
    padding: 11px 12px;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }
  .alt-board td.name {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
  }
  .alt-board td.is-hot {
    color: var(--color-watch);
  }
  .alt-board td.is-risk {
    color: var(--color-risk);
  }
  .alt-board__foot {
    display: grid;
    gap: 8px;
    padding: 14px 16px 16px;
    background: var(--color-navy-900);
  }
  .alt-board__foot p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .alt-board__foot strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .alt-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding-top: 8px;
  }
  .alt-stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 16px 24px;
    border-left: 1px solid var(--color-line);
  }
  .alt-stats > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .alt-stats dd {
    margin: 0;
    font-weight: 600;
    font-variation-settings: 'wdth' 75;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .alt-stats dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .alt-stats__cap {
    margin-top: 8px;
    color: var(--color-ink-3);
  }

  .alt-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .alt-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .alt-card .st-body {
    max-width: none;
  }
  .alt-timeline {
    border-top-color: var(--color-line);
  }
  .alt-timeline > li {
    grid-template-columns: 7.6rem minmax(0, 1fr);
  }
  .alt-offer {
    border-color: rgba(45, 127, 249, 0.35);
    background: rgba(45, 127, 249, 0.08);
  }
  .alt-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .alt-points li {
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-2);
    font-size: 15px;
  }
  .alt-points strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .alt-offer .st-btn {
    margin-top: auto;
    align-self: flex-start;
  }

  .alt-cmp {
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    overflow: hidden;
  }
  .alt-cmp table {
    width: 100%;
    border-collapse: collapse;
  }
  .alt-cmp th,
  .alt-cmp td {
    padding: 16px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .alt-cmp tr:last-child th,
  .alt-cmp tr:last-child td {
    border-bottom: 0;
  }
  .alt-cmp thead th {
    background: var(--color-navy-900);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .alt-cmp thead th:nth-child(2) {
    color: var(--color-ink);
    background: var(--color-navy-850);
  }
  .alt-cmp tbody th {
    width: 24%;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .alt-cmp td.us {
    background: rgba(45, 127, 249, 0.05);
    color: var(--color-ink);
  }
  .alt-cmp td.them {
    color: var(--color-ink-2);
  }
  .alt-cmp td.is-muted {
    color: var(--color-ink-3);
  }
  .alt-cmp td.us {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .alt-cmp td.us :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--color-ink-3);
  }
  .alt-fair {
    margin-top: 8px;
  }
  .alt-note {
    margin-top: 8px;
    color: var(--color-ink-3);
  }

  .alt-quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .alt-quote {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .alt-quote blockquote {
    margin: 0;
  }
  .alt-quote figcaption {
    display: grid;
    gap: 4px;
  }
  .alt-quote b {
    font-weight: 600;
    color: var(--color-ink);
  }

  @media (max-width: 1000px) {
    .alt-hero__grid,
    .alt-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 800px) {
    .alt-quotes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 680px) {
    .alt-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 8px;
    }
    .alt-stats > div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .alt-stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
    .alt-cmp {
      border: 0;
      border-radius: 0;
      overflow: visible;
    }
    .alt-cmp table,
    .alt-cmp tbody,
    .alt-cmp tr,
    .alt-cmp th,
    .alt-cmp td {
      display: block;
      width: 100%;
    }
    .alt-cmp thead {
      display: none;
    }
    .alt-cmp tr {
      border: 1px solid var(--color-line-strong);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
      background: var(--color-navy-950);
    }
    .alt-cmp tbody th {
      width: auto;
      background: var(--color-navy-900);
      border-bottom: 1px solid var(--color-line);
    }
    .alt-cmp td {
      border-bottom: 1px solid var(--color-line);
    }
    .alt-cmp tr td:last-child {
      border-bottom: 0;
    }
    .alt-cmp td.us,
    .alt-cmp td.them {
      display: block;
    }
    .alt-cmp td[data-side]::before {
      content: attr(data-side);
      display: block;
      margin-bottom: 4px;
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-ink-3);
    }
    .alt-cmp td.us::before {
      color: var(--color-electric-500);
    }
    .alt-cmp td.us {
      display: flex;
      flex-wrap: wrap;
      background: transparent;
    }
    .alt-cmp td.us::before {
      flex: 1 0 100%;
    }
  }
  @media (max-width: 420px) {
    .alt-board th.sleep,
    .alt-board td.sleep {
      display: none;
    }
    .alt-board .st-chip {
      padding: 3px 7px;
      font-size: 10px;
      letter-spacing: 0.03em;
    }
    .alt-board .st-chip::before {
      display: none;
    }
    .st-ctas .st-btn {
      white-space: normal;
      text-align: center;
    }
  }
</style>
