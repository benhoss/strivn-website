---
import '../../styles/home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteMotion from '../SiteMotion.astro';
import SolHero from './SolHero.astro';
import SolCompo from './SolCompo.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import HomeFooter from '../home/HomeFooter.astro';
import { solutionsContent } from '../../data/solutionsContent';
import { homeContent } from '../../data/homeContent';
import type { Locale } from '../../data/solutionsContent';

interface Props {
  locale: Locale;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, canonicalPath, alternates } = Astro.props;
const c = solutionsContent[locale];
/** Closing CTA and footer are shared with the homepage. */
const shared = homeContent[locale];

const skipLabelByLocale: Record<Locale, string> = {
  fr: 'Aller au contenu',
  nl: 'Naar de inhoud',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  es: 'Ir al contenido',
  en: 'Skip to content',
};
---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
>
  <a href="#s-main" class="s-skip">{skipLabelByLocale[locale]}</a>

  <SiteHeader locale={locale} links={c.nav.links} cta={c.nav.cta} />

  <main id="s-main" class="bg-[#05070F] font-sans text-[#F8FAFC] antialiased">
    <SolHero hero={c.hero} />
    <SolCompo locale={locale} compo={c.compo} />
    <HomeFinalCta locale={locale} finalCta={shared.finalCta} />
  </main>

  <HomeFooter locale={locale} footer={shared.footer} />

  <SiteMotion />
</BaseLayout>
