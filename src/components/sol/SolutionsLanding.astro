---
/**
 * Platform page (`/xx/solutions/`): what STRIVN connects, as the sequence it
 * runs (data → context → reading → action), the six roles that read the same
 * base, and the week the modules cover.
 */
import { NAV } from '../../data/nav';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import HomeFooter from '../home/HomeFooter.astro';
import FeatClose from '../feat/FeatClose.astro';
import SolHero from './SolHero.astro';
import SolCompo from './SolCompo.astro';
import SolRoles from './SolRoles.astro';
import SolWeek from './SolWeek.astro';
import { solutionsContent } from '../../data/solutionsContent';
import type { Locale } from '../../data/solutionsContent';
import { featuresIndexContent } from '../../data/featuresIndexContent';
import { homeContent } from '../../data/homeContent';
import { SKIP_LABEL } from '../../lib/skipLabel';

interface Props {
  locale: Locale;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, canonicalPath, alternates } = Astro.props;
const c = solutionsContent[locale];
/** CTA pair, closing band and the week's groups come from the features index. */
const feat = featuresIndexContent[locale];
/** Footer only: shared with every page. */
const home = homeContent[locale];

const LOCALES: Locale[] = ['en', 'fr', 'nl', 'de', 'pt', 'es'];
const switchHrefs = Object.fromEntries(LOCALES.map((l) => [l, `/${l}/solutions/`])) as Record<Locale, string>;
---

<BaseLayout lang={locale} title={c.meta.title} description={c.meta.description} canonicalPath={canonicalPath} alternates={alternates}>
  <a href="#s-main" class="s-skip">{SKIP_LABEL[locale]}</a>

  <SiteHeader locale={locale} links={NAV[locale].links} cta={NAV[locale].cta} switchHrefs={switchHrefs} />

  <main id="s-main" class="bg-void text-ink">
    <SolHero locale={locale} hero={c.hero} cta={feat.cta} steps={c.compo.steps} />
    <SolCompo locale={locale} compo={c.compo} />
    <SolRoles locale={locale} roles={c.roles} />
    <SolWeek locale={locale} week={c.week} feat={feat} />
    <FeatClose locale={locale} close={feat.close} />
  </main>

  <HomeFooter locale={locale} footer={home.footer} />
</BaseLayout>
