---
/**
 * What STRIVN connects, as the sequence it runs: data → context → reading →
 * action. Numbered because it is a sequence; each step has its mechanism, the
 * product fragment that shows it, and the module page behind it. Everything
 * is visible at rest.
 */
import type { SolutionsContent, Locale } from '../../data/solutionsContent';
import { READING_ROWS, STEP_SLUGS } from '../../data/solutionsContent';

interface Props {
  locale: Locale;
  compo: SolutionsContent['compo'];
}

const { locale, compo: c } = Astro.props;
const [data, context, reading, action] = c.steps;
const href = (i: number) => `/${locale}/features/${STEP_SLUGS[i]}/`;
const chip = { ready: 'st-chip--ready', watch: 'st-chip--watch', risk: 'st-chip--risk' } as const;
const meter = { ready: 'var(--color-ready)', watch: 'var(--color-watch)', risk: 'var(--color-risk)' } as const;
---

<section id="composition" class="st-sec" aria-labelledby="sx-compo-title">
  <div class="st-wrap">
    <div class="st-head">
      <h2 id="sx-compo-title" class="st-h2">{c.title}</h2>
      <p class="st-body">{c.body}</p>
    </div>

    <ol class="sx-steps">
      {c.steps.map((s, i) => (
        <li id={`step-${i + 1}`} class="sx-step">
          <p class="sx-step__rail">
            <span class="sx-step__n st-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="st-label st-label--accent">{s.label}</span>
          </p>

          <div class="sx-step__copy">
            <h3 class="st-h3">{s.title}</h3>
            <p class="st-body">{s.body}</p>
            <a class="st-link" href={href(i)}>{s.cta}</a>
          </div>

          <div class="sx-step__fig">
            {i === 0 && (
              <div class="st-panel">
                <ul class="sx-rows">
                  {data.rows.map((r) => (
                    <li>
                      <span class="sx-rows__name">{r.name}</span>
                      <span class="st-num sx-rows__meta">{r.meta}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {i === 1 && (
              <div class="st-panel">
                <p class="st-panel__bar sx-fig__bar">
                  <span class="st-h4">{context.event}</span>
                </p>
                <ul class="sx-rows">
                  {context.rows.map((r) => (
                    <li>
                      <span class="sx-rows__name">{r.name}</span>
                      <span class="st-num sx-rows__meta">{r.meta}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {i === 2 && (
              <div class="st-panel">
                <p class="st-panel__bar sx-fig__bar">
                  <span class="st-label">{reading.head}</span>
                </p>
                <ul class="sx-rows sx-rows--players">
                  {READING_ROWS.map((p) => (
                    <li>
                      <span class="sx-rows__name">{p.name}</span>
                      <span class="st-meter sx-rows__meter" aria-hidden="true">
                        <i style={`width: ${p.pct}%; background: ${meter[p.state]}`}></i>
                      </span>
                      <span class="st-num sx-rows__meta">{p.acwr}</span>
                      <span class={`st-chip ${chip[p.state]}`}>{reading.status[p.state]}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {i === 3 && (
              <div class="st-panel">
                <div class="st-panel__body grid gap-3">
                  <div class="st-proposal">
                    <span class="st-tag st-tag--accent sx-fig__tag">{action.tag}</span>
                    <p class="sx-fig__proposal">{action.proposal}</p>
                    <div class="flex flex-wrap gap-2">
                      <span class="st-btn st-btn--primary st-btn--sm">{action.apply}</span>
                      <span class="st-btn st-btn--ghost st-btn--sm">{action.edit}</span>
                    </div>
                  </div>
                  <p class="st-label">→ {action.targets}</p>
                </div>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sx-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sx-step {
    display: grid;
    grid-template-columns: var(--st-rail) minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 24px 40px;
    align-items: start;
    padding-block: 36px;
    border-top: 1px solid var(--color-line-strong);
    scroll-margin-top: calc(var(--st-header) + 24px);
  }
  .sx-step:last-child {
    border-bottom: 1px solid var(--color-line-strong);
  }
  .sx-step__rail {
    display: grid;
    gap: 8px;
    align-content: start;
    margin: 0;
    position: relative;
    align-self: stretch;
  }
  /* The thread between numbers: it stops at the last step. */
  .sx-step:not(:last-child) .sx-step__rail::after {
    content: '';
    position: absolute;
    left: 13px;
    top: 58px;
    bottom: -36px;
    width: 1px;
    background: var(--color-line-strong);
  }
  .sx-step__n {
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-ink);
  }
  .sx-step__copy {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .sx-step__fig {
    min-width: 0;
  }
  .sx-fig__bar {
    margin: 0;
  }
  .sx-rows {
    list-style: none;
    margin: 0;
    padding: 4px 20px;
  }
  .sx-rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    font-size: 14px;
  }
  .sx-rows li + li {
    border-top: 1px solid var(--color-line);
  }
  .sx-rows__name {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-ink);
  }
  .sx-rows__meta {
    font-size: 13px;
    white-space: nowrap;
    color: var(--color-ink-2);
  }
  .sx-rows--players li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 72px 40px auto;
  }
  .sx-rows__meter {
    width: 100%;
  }
  .sx-fig__tag {
    justify-self: start;
  }
  .sx-fig__proposal {
    margin: 0;
    color: var(--color-ink);
  }
  @media (max-width: 1000px) {
    .sx-step {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      padding-block: 28px;
    }
    .sx-step__rail {
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .sx-step__rail::after {
      display: none;
    }
    .sx-step__n {
      font-size: 20px;
    }
    .sx-step__fig {
      max-width: 560px;
    }
  }
  @media (max-width: 420px) {
    .sx-rows--players li {
      grid-template-columns: minmax(0, 1fr) 40px auto;
    }
    .sx-rows__meter {
      display: none;
    }
  }
</style>
