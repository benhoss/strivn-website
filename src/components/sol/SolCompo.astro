---
import type { SolutionsContent, Locale } from '../../data/solutionsContent';
import { PITCH_SPOTS, ROSTER_NUMS, ROSTER_TARGETS, SC_SLUG, SOON_INDEX } from '../../data/solutionsContent';
import HomeIcon from '../home/HomeIcon.astro';

interface Props {
  locale: Locale;
  compo: SolutionsContent['compo'];
}

const { locale, compo: c } = Astro.props;

/** Shirt colours: the captain is the only one that glows. */
const tone: Record<string, { ring: string; text: string; glow: string }> = {
  plain: { ring: 'outline-[#C3CDE066]', text: 'text-[#C3CDE0]', glow: '' },
  green: { ring: 'outline-[#8CE99A66]', text: 'text-[#8CE99A]', glow: '' },
  blue: {
    ring: 'outline-[1.5px] outline-[#7AB8FF]',
    text: 'text-[#7AB8FF]',
    glow: '[box-shadow:0_0_34px_2px_rgba(45,127,249,0.5)]',
  },
  orange: { ring: 'outline-[#FF840066]', text: 'text-[#FF8400]', glow: '' },
};

const base = `/${locale}`;
/** Resolve each roster row's destination; the S&C slug is translated in FR. */
const hrefs = ROSTER_TARGETS.map((t) =>
  t.kind === 'sc'
    ? `${base}/${SC_SLUG[locale]}/`
    : t.kind === 'feature'
      ? `${base}/features/${t.slug}/`
      : 'mailto:hello@strivn.net',
);
---

<section id="solutions" class="scroll-mt-20 bg-[#070A14] py-20 md:py-24" aria-labelledby="sol-compo-title">
  <div class="hl-wrap">
    <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,380px)] lg:gap-20">
      <div class="hl-reveal">
        <p class="font-mono text-[0.63rem] tracking-[0.13em] text-[#7AB8FF]">{c.kicker}</p>
        <h2 id="sol-compo-title" class="hl-display mt-3.5 max-w-[20ch] text-[clamp(1.85rem,3.8vw,2.5rem)]">
          {c.title}
        </h2>
      </div>
      <p class="hl-reveal text-[0.9rem] leading-[1.6] text-[#9AA8C4] lg:pb-1.5" style="--d: 100ms;">{c.body}</p>
    </div>

    <div class="mt-12 grid items-center gap-14 lg:grid-cols-[minmax(0,560px)_minmax(0,1fr)] lg:gap-[72px]">
      <!-- Pitch: CSS-drawn, markers placed in % so the formation scales -->
      <div class="hl-reveal hl-reveal--card flex flex-col items-center gap-4">
        <div
          class="relative w-full overflow-hidden rounded-[16px] [aspect-ratio:4/5] [background-image:linear-gradient(90deg,#0C1428_0%,#070C1A_100%)] outline-1 outline-[#FFFFFF29] -outline-offset-[0.5px]"
        >
          <!-- Pitch markings, purely decorative -->
          <span class="pointer-events-none absolute inset-[5%_5%] rounded-[2px] outline-1 outline-[#FFFFFF12]" aria-hidden="true"></span>
          <span class="pointer-events-none absolute top-1/2 right-[5%] left-[5%] h-px bg-[#FFFFFF12]" aria-hidden="true"></span>
          <span
            class="pointer-events-none absolute top-1/2 left-1/2 size-[19.6%] -translate-x-1/2 -translate-y-1/2 rounded-full outline-1 outline-[#FFFFFF12]"
            aria-hidden="true"></span>
          <span
            class="pointer-events-none absolute top-1/2 left-1/2 size-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#FFFFFF12]"
            aria-hidden="true"></span>
          <span class="pointer-events-none absolute top-[4%] left-1/2 h-[12%] w-[39.3%] -translate-x-1/2 outline-1 outline-[#FFFFFF12]" aria-hidden="true"></span>
          <span class="pointer-events-none absolute top-[4%] left-1/2 h-[4.9%] w-[19.6%] -translate-x-1/2 outline-1 outline-[#FFFFFF12]" aria-hidden="true"></span>
          <span class="pointer-events-none absolute bottom-[4%] left-1/2 h-[12%] w-[39.3%] -translate-x-1/2 outline-1 outline-[#FFFFFF12]" aria-hidden="true"></span>
          <span class="pointer-events-none absolute bottom-[4%] left-1/2 h-[4.9%] w-[19.6%] -translate-x-1/2 outline-1 outline-[#FFFFFF12]" aria-hidden="true"></span>

          <ul data-stagger>
            {PITCH_SPOTS.map((spot, i) => (
              <li
                class="absolute flex -translate-x-1/2 flex-col items-center gap-[7px]"
                style={`left: ${spot.x}%; top: ${spot.y}%;`}
              >
                <span
                  class={`grid size-[54px] place-items-center rounded-full [background-image:linear-gradient(90deg,#18223F,#0A101F)] outline-1 -outline-offset-[0.5px] ${tone[spot.tone].ring} ${tone[spot.tone].glow} ${spot.captain ? 'hl-breathe' : ''}`}
                >
                  <span class={`hl-display text-[1.19rem] leading-none ${tone[spot.tone].text}`}>{spot.num}</span>
                </span>
                <span class="flex items-center gap-1.5 rounded-full bg-[#05070FD9] px-2.5 py-1 font-mono text-[0.53rem] tracking-[0.11em] whitespace-nowrap text-[#C3CDE0] outline-1 outline-[#FFFFFF14] -outline-offset-[0.5px]">
                  {c.spots[i]}
                  {spot.captain && <span class="text-[#FF8400]">{c.captain}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <p class="text-center font-mono text-[0.59rem] tracking-[0.11em] text-balance text-[#68779A]">{c.caption}</p>
      </div>

      <!-- Roster -->
      <ul class="hl-reveal hl-reveal--right" data-stagger style="--d: 120ms;">
        {c.roster.map((row, i) => {
          const isCaptain = i === 0;
          const isSoon = i === SOON_INDEX;
          return (
            <li
              class={
                isCaptain
                  ? 'rounded-[12px] bg-[#2D7FF912] p-5 outline-1 outline-[#2D7FF959] -outline-offset-[0.5px]'
                  : 'border-t border-[#FFFFFF14]'
              }
            >
              <!-- Two nested grids rather than one flex-wrap row. Wrapping made
                   the link column ragged — a long description pushed its CTA to
                   the next line while short ones kept it inline. Nesting also
                   avoids placing the CTA with `col-start`, whose responsive
                   variant carries equal specificity and resolves by stylesheet
                   order rather than by breakpoint. -->
              <a
                href={hrefs[i]}
                class={`hl-row grid grid-cols-[40px_minmax(0,1fr)] items-center gap-x-4 text-[#7AB8FF] ${isCaptain ? '' : 'px-1 py-[18px]'}`}
              >
                <span
                  class={`grid size-10 shrink-0 place-items-center rounded-full outline-1 -outline-offset-[0.5px] ${
                    isCaptain ? 'bg-[#2D7FF929] outline-[#7AB8FF80]' : 'bg-[#FFFFFF07] outline-[#FFFFFF14]'
                  }`}
                >
                  <span class={`hl-display text-[0.94rem] leading-none ${isCaptain ? 'text-[#7AB8FF]' : 'text-[#C3CDE0]'}`}>
                    {ROSTER_NUMS[i]}
                  </span>
                </span>

                <span class="grid min-w-0 gap-2.5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-4">
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-center gap-2">
                      <span class="text-[0.94rem] font-semibold text-[#F8FAFC]">{row.name}</span>
                      {isCaptain && <span class="font-mono text-[0.66rem] text-[#FF8400]">{c.captain}</span>}
                      {isSoon && (
                        <span class="rounded-full bg-[#FF840014] px-2.5 py-[3px] font-mono text-[0.53rem] tracking-[0.13em] text-[#FF8400] outline-1 outline-[#FF840040] -outline-offset-[0.5px]">
                          {c.soon}
                        </span>
                      )}
                    </span>
                    <span class="mt-1 block text-[0.78rem] leading-[1.5] text-[#9AA8C4]">{row.desc}</span>
                  </span>

                  <span class={`hl-more shrink-0 text-[0.78rem] ${isSoon ? 'text-[#F8FAFC]' : 'text-[#7AB8FF]'}`}>
                    {row.cta}
                    <HomeIcon name="arrow-right" size={13} class="hl-row__icon" />
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
