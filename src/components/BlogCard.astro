---
/* One post as a row of a hairline list (blog index, category pages, related
   posts). Mono locator on the left (date, category, reading time), title and
   excerpt on the right. The whole row is the link. Render inside a
   <ul class="b-list">; styles live in blog.css. */
import type { CollectionEntry } from 'astro:content';
import { BLOG_CATEGORY_LABELS, formatDateFr, frenchSpacing, slugFromEntry } from '../lib/blog';

interface Props {
  entry: CollectionEntry<'blog'>;
  /** Compact row (related posts): no excerpt, smaller title. */
  compact?: boolean;
  /** Heading level of the title, to keep the page outline right. */
  level?: 2 | 3;
}

const { entry, compact = false, level = 2 } = Astro.props;
const slug = slugFromEntry(entry);
const { data } = entry;
const Heading = level === 2 ? 'h2' : 'h3';
---

<li class:list={['b-row st-hover-row', { 'b-row--compact': compact }]}>
  <p class="b-row__meta">
    <time datetime={data.pubDate.toISOString()}>{formatDateFr(data.pubDate)}</time>
    <span class="b-row__cat">{BLOG_CATEGORY_LABELS[data.category]}</span>
    <span class="b-row__time">{data.readingTime} min</span>
  </p>
  <div class="b-row__body">
    <Heading class="b-row__title">
      <a href={`/fr/blog/${slug}/`}>{frenchSpacing(data.title)}</a>
    </Heading>
    {!compact && <p class="b-row__excerpt">{frenchSpacing(data.description)}</p>}
  </div>
  <span class="b-row__go" aria-hidden="true">→</span>
</li>
