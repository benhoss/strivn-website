---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import HomeHero from './HomeHero.astro';
import HomeProof from './HomeProof.astro';
import HomeImport from './HomeImport.astro';
import HomeReadiness from './HomeReadiness.astro';
import HomeMicrocycle from './HomeMicrocycle.astro';
import HomeLive from './HomeLive.astro';
import HomePlayers from './HomePlayers.astro';
import HomeAssistant from './HomeAssistant.astro';
import HomePricing from './HomePricing.astro';
import HomeFaq from './HomeFaq.astro';
import HomeFinalCta from './HomeFinalCta.astro';
import HomeFooter from './HomeFooter.astro';
import { homeContent, type Locale } from '../../data/homeContent';
import { NAV } from '../../data/nav';
import { SKIP_LABEL } from '../../lib/skipLabel';

interface Props {
  locale: Locale;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, canonicalPath, alternates } = Astro.props;
const c = homeContent[locale];

/** FAQPage structured data — the FAQ is rendered verbatim on this page. */
const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={[faqJsonLd]}
>
  <a href="#s-main" class="s-skip">{SKIP_LABEL[locale]}</a>

  <SiteHeader locale={locale} links={NAV[locale].links} cta={NAV[locale].cta} />

  <main id="s-main" class="home bg-void text-ink">
    <HomeHero locale={locale} c={c} />
    <HomeProof c={c.proof} />
    <HomeImport c={c.import} />
    <HomeReadiness c={c.readiness} status={c.status} pct={c.pct} />
    <HomeMicrocycle c={c.plan} status={c.status} pct={c.pct} />
    <HomeLive c={c.live} pct={c.pct} />
    <HomePlayers c={c.playerApp} pct={c.pct} />
    <HomeAssistant c={c.assistant} pct={c.pct} />
    <HomePricing locale={locale} c={c.pricing} />
    <HomeFaq c={c.faq} />
    <HomeFinalCta locale={locale} finalCta={c.finalCta} />
  </main>

  <HomeFooter locale={locale} footer={c.footer} />
</BaseLayout>

<style>
  /* Buttons drawn inside a product panel: they show the product and do
     nothing on the site, so they are spans, not buttons. */
  .home :global(.home-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .home :global(.home-mini) {
    display: inline-flex;
    align-items: center;
    font: 500 12.5px/1 var(--font-sans);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    white-space: nowrap;
  }
  .home :global(.home-mini--primary) {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }
</style>

