---
import '../../styles/home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteMotion from '../SiteMotion.astro';
import HomeHero from './HomeHero.astro';
import HomeSpectre from './HomeSpectre.astro';
import HomeCredibility from './HomeCredibility.astro';
import HomeBeforeAfter from './HomeBeforeAfter.astro';
import HomeWorkflow from './HomeWorkflow.astro';
import HomePlayerApp from './HomePlayerApp.astro';
import HomePlatform from './HomePlatform.astro';
import HomeIntelligence from './HomeIntelligence.astro';
import HomeConvince from './HomeConvince.astro';
import HomeSolutions from './HomeSolutions.astro';
import HomePricing from './HomePricing.astro';
import HomeFaq from './HomeFaq.astro';
import HomeFinalCta from './HomeFinalCta.astro';
import HomeFooter from './HomeFooter.astro';
import { homeContent, type Locale } from '../../data/homeContent';

interface Props {
  locale: Locale;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, canonicalPath, alternates } = Astro.props;
const c = homeContent[locale];

const skipLabelByLocale: Record<Locale, string> = {
  fr: 'Aller au contenu',
  nl: 'Naar de inhoud',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  es: 'Ir al contenido',
  en: 'Skip to content',
};

/** FAQPage structured data — the FAQ is rendered verbatim on this page. */
const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  lang={locale}
  title={c.meta.title}
  description={c.meta.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={[faqJsonLd]}
>
  <a href="#s-main" class="s-skip">{skipLabelByLocale[locale]}</a>

  <SiteHeader locale={locale} links={c.nav.links} cta={c.nav.cta} />

  <main id="s-main" class="bg-[#05070F] font-sans text-[#F8FAFC] antialiased">
    <HomeHero locale={locale} hero={c.hero} />
    <HomeSpectre spectre={c.spectre} />
    <HomeCredibility credibility={c.credibility} />
    <HomeBeforeAfter beforeAfter={c.beforeAfter} />
    <HomeWorkflow workflow={c.workflow} />
    <HomePlayerApp playerApp={c.playerApp} />
    <HomePlatform platform={c.platform} />
    <HomeIntelligence intelligence={c.intelligence} />
    <HomeConvince convince={c.convince} />
    <HomeSolutions solutions={c.solutions} />
    <HomePricing locale={locale} pricing={c.pricing} email={c.faq.email} />
    <HomeFaq faq={c.faq} />
    <HomeFinalCta locale={locale} finalCta={c.finalCta} />
  </main>

  <HomeFooter locale={locale} footer={c.footer} />

  <SiteMotion />
</BaseLayout>
