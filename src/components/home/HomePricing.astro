---
import type { HomeContent, Locale } from '../../data/homeContent';
import HomeIcon from './HomeIcon.astro';
import { pricingContent } from '../../data/pricingContent';
import { planPrice } from '../../lib/planPrice';

interface Props {
  locale: Locale;
  pricing: HomeContent['pricing'];
}

const { locale, pricing: c } = Astro.props;

/**
 * The tiers themselves come from `pricingContent`, never from `homeContent`:
 * a price that appears in two files eventually disagrees with itself, and this
 * section spent months claiming three plans after the architecture moved to
 * four. The homepage owns the heading; the pricing page owns the pricing.
 *
 * `id="tarifs"` outlives the links that pointed at it — campaign emails already
 * in inboxes still carry the fragment, and a sent email cannot be rewritten.
 */
const pricing = pricingContent[locale];
const plans = pricing.plans.items;
const teaserCta = pricing.teaserCta;
---

<section id="tarifs" class="scroll-mt-24 bg-[#05070F] py-20 md:py-28" aria-labelledby="pricing-title">
  <div class="hl-wrap">
    <div class="hl-reveal mx-auto max-w-[46rem] text-center">
      <p class="hl-index justify-center text-[#7AB8FF]">
        {c.index}
        <span class="hl-index__rule"></span>
        <span class="text-[#68779A]">{c.kicker}</span>
      </p>
      <h2 id="pricing-title" class="hl-display mt-5 text-[clamp(2rem,4.4vw,3.2rem)]">{c.title}</h2>
    </div>

    {/* One rail rather than four cards: the tiers are a ladder, and the page
        they lead to is where a reader compares them properly. */}
    <div
      class="hl-reveal mt-12 grid overflow-hidden rounded-[20px] bg-[#0B1020] outline-1 outline-[#FFFFFF0F] -outline-offset-[0.5px] md:grid-cols-4"
      style="--d: 80ms;"
    >
      {plans.map((plan, i) => {
        const price = planPrice(plan.code, locale, pricing.plans, plan.quotePrice);
        return (
        <div
          class={`relative p-6 ${plan.featured ? 'bg-gradient-to-b from-[#101B33] to-[#0B1020]' : ''} ${
            i > 0 ? 'border-t border-[#FFFFFF0F] md:border-t-0 md:border-l' : ''
          }`}
        >
          {plan.featured && <span class="absolute inset-x-0 top-0 h-px bg-[#2D7FF9]" aria-hidden="true"></span>}
          <p class={`font-mono text-[0.62rem] font-semibold tracking-[0.1em] uppercase ${plan.featured ? 'text-[#7AB8FF]' : 'text-[#68779A]'}`}>
            {plan.name}
          </p>
          {/* The teaser shows the headline figure only. The struck rate and
              the yearly total belong on the page that compares tiers. */}
          <p class="mt-3 flex items-baseline gap-1.5">
            <span class="hl-display text-[1.9rem] leading-none text-[#F8FAFC]">{price.headline}</span>
            {price.period && <span class="text-[0.78rem] text-[#68779A]">{price.period}</span>}
          </p>
          <p class="mt-3 text-[0.9rem] leading-[1.5] text-[#AAB8D4]">{plan.promise}</p>
        </div>
        );
      })}
    </div>

    <div class="hl-reveal mt-10 flex flex-col items-center gap-5 text-center" style="--d: 160ms;">
      <p class="max-w-[42rem] text-[0.9rem] leading-[1.6] text-[#8CA3C7]">{c.note}</p>
      <a
        href={`/${locale}/pricing/`}
        class="hl-more hl-btn inline-flex items-center gap-2 rounded-full bg-[#2D7FF9] px-6 py-3.5 text-[0.95rem] font-semibold text-white [box-shadow:0px_10px_36px_-6px_#2D7FF966] hover:bg-[#4F94FB]"
      >
        {teaserCta}
        <HomeIcon name="arrow-right" size={15} />
      </a>
    </div>
  </div>
</section>
