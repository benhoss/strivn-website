---
import type { HomeContent } from '../../data/homeContent';
import { CLUBS } from '../../data/clubs';
import { pngSize } from '../../lib/pngSize';

interface Props {
  credibility: HomeContent['credibility'];
}

const { credibility } = Astro.props;

/**
 * The crests are normalized to a common ink *area*, not a common height — a
 * portrait shield and a square roundel of equal height do not read as equal.
 * Constraining them in CSS would undo that, so each is emitted at its own
 * intrinsic size times one shared factor. 0.34 lands the tallest crest at
 * ~76px inside a 7rem tile, and leaves every file at ~2.9x its drawn size.
 */
const SCALE = 0.34;

const crests = CLUBS.map((club) => {
  const src = `logos/clubs/${club.slug}.png`;
  const size = pngSize(src);
  return {
    ...club,
    src: `/${src}`,
    width: size ? Math.round(size.width * SCALE) : undefined,
    height: size ? Math.round(size.height * SCALE) : undefined,
  };
});
---

<section class="bg-[#070A14] py-20 md:py-24" aria-labelledby="cred-title">
  <div class="hl-wrap">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)]">
      <div class="hl-reveal">
        <p class="hl-display text-[clamp(3.4rem,6vw,4.6rem)] leading-none">
          <span data-count={credibility.stat}>{credibility.stat}</span><span class="text-[#7AB8FF]">{credibility.statSuffix}</span>
        </p>
        <p id="cred-title" class="mt-3 max-w-[24rem] text-[1.05rem] leading-normal text-[#E2E8F0]">
          {credibility.statLine}
        </p>
        <p class="mt-3 font-mono text-[0.64rem] tracking-[0.12em] text-[#68779A]">{credibility.statSub}</p>
      </div>

      <div class="hl-reveal hl-marquee-mask" style="--d: 120ms;">
        <div class="hl-marquee">
          {/* The animation translates by -50%, so the set is laid down twice.
              The second pass is scenery: hidden from assistive tech, and
              dropped entirely when motion is reduced and the row wraps. */}
          {[false, true].map((clone) =>
            crests.map((crest) => (
              <span
                class:list={[
                  'grid h-[7rem] w-[10.5rem] shrink-0 place-items-center rounded-[14px] bg-white px-5',
                  clone && 'hl-marquee__clone',
                ]}
                aria-hidden={clone ? 'true' : undefined}
              >
                <img
                  src={crest.src}
                  alt={clone ? '' : crest.name}
                  width={crest.width}
                  height={crest.height}
                  class="max-w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ))
          )}
        </div>
      </div>
    </div>

    <div
      class="hl-reveal hl-reveal--card mt-12 flex flex-col items-start gap-5 rounded-[18px] bg-[#0B1020] p-5 outline-1 outline-[#FFFFFF0F] -outline-offset-[0.5px] sm:flex-row sm:items-center sm:gap-7 sm:p-6"
      style="--d: 180ms;"
    >
      <span class="grid h-[6rem] w-full shrink-0 place-items-center rounded-[14px] bg-white px-6 sm:w-[17.5rem]">
        <img
          src="/logos/barca-innovation-hub.png"
          alt="Barça Innovation Hub"
          width="1926"
          height="627"
          class="h-auto max-h-[4.2rem] w-full max-w-[13.5rem] object-contain"
          loading="lazy"
          decoding="async"
        />
      </span>
      <div>
        <p class="hl-kicker">{credibility.methodKicker}</p>
        <p class="mt-2 text-[1.3rem] leading-tight font-bold text-[#F8FAFC]">{credibility.methodTitle}</p>
      </div>
    </div>
  </div>
</section>
