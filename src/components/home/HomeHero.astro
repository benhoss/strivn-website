---
import {
  CONTACT_EMAIL,
  FOCUS_PLAYER,
  HERO_FILE,
  HERO_ROWS,
  HERO_TIME,
  type HomeContent,
  type Locale,
} from '../../data/homeContent';
import { appStartUrl } from '../../lib/appUrl';

interface Props {
  locale: Locale;
  c: HomeContent;
}

const { locale, c } = Astro.props;
const h = c.hero;
const p = h.panel;
const status = c.status;

type Cell = 'hsr' | 'rpe' | 'sleep' | 'acwr';
const tone = (row: (typeof HERO_ROWS)[number], cell: Cell) =>
  row.risk?.includes(cell) ? 'is-risk' : row.hot?.includes(cell) ? 'is-hot' : undefined;
---

<section class="home-hero st-grid-bg" id="hero" aria-labelledby="hero-title">
  <div class="st-wrap home-hero__grid">
    <div class="home-hero__copy">
      <span class="st-label st-eyebrow">{h.eyebrow}</span>
      <h1 id="hero-title" class="st-display">
        <span class="st-muted home-hero__muted">{h.titleMuted}</span>
        {h.titleMain}
      </h1>
      <p class="st-lede">{h.sub}</p>
      <div class="st-ctas">
        <a class="st-btn st-btn--primary" href={appStartUrl(locale)} target="_blank" rel="noopener">
          {h.primaryCta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="st-btn st-btn--ghost" href={`mailto:${CONTACT_EMAIL}`}>{h.secondaryCta}</a>
      </div>
      <p class="st-fine home-hero__fine">{h.fine.map((f) => <span>{f}</span>)}</p>
    </div>

    {/* Tuesday's export resolves into Wednesday's read. At rest the table is
        resolved; the scan replays on a loop while the panel is on screen. */}
    <figure
      class="st-panel st-panel--float home-xform"
      aria-label={p.aria}
      data-st-inview
      data-xform
      data-read={p.read}
      data-busy={p.busy}
      data-busy-value={p.busyValue}
      data-importing={status.importing}
    >
      <div class="home-xform__bar">
        <span class="home-xform__file">{HERO_FILE}</span>
        <span class="home-xform__state" data-xstate>{p.read} <i>{HERO_TIME}</i></span>
      </div>
      <div class="home-xform__scroll">
        <table class="home-xtable">
          <thead>
            <tr>
              <th scope="col">{p.cols[0]}</th>
              <th scope="col" class="opt">{p.cols[1]}</th>
              <th scope="col">{p.cols[2]}</th>
              <th scope="col">{p.cols[3]}</th>
              <th scope="col">{p.cols[4]}</th>
              <th scope="col">{p.cols[5]}</th>
            </tr>
          </thead>
          <tbody>
            {HERO_ROWS.map((r) => (
              <tr data-state={r.state} data-label={status[r.state]}>
                <td class="name">{r.name}</td>
                <td class:list={['opt', tone(r, 'hsr')]}>{r.hsr}</td>
                <td class={tone(r, 'rpe')}>{r.rpe}</td>
                <td class={tone(r, 'sleep')}>{r.sleep}</td>
                <td class={tone(r, 'acwr')}>{r.acwr}</td>
                <td class="dec"><span class={`st-chip st-chip--${r.state}`}>{status[r.state]}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <figcaption class="home-xform__foot">
        <span class="st-label st-label--accent">{p.proposed}</span>
        <p><strong>{FOCUS_PLAYER}</strong>{p.proposal}</p>
        <span class="st-label home-xform__sources">{p.sources}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero {
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(56px, 8vw, 104px);
  }
  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }
  .home-hero__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
    min-width: 0;
  }
  .home-hero__muted {
    display: block;
  }
  .home-hero__fine {
    margin: 0;
  }

  /* ── The transform panel ── */
  .home-xform {
    margin: 0;
    min-width: 0;
  }
  .home-xform__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-line);
  }
  .home-xform__file {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-2);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-xform__file::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 10px;
    margin-right: 8px;
    border: 1px solid var(--color-navy-300);
    border-radius: 1px;
    vertical-align: -1px;
  }
  .home-xform__state {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
    white-space: nowrap;
  }
  .home-xform__state :global(i) {
    font-style: normal;
    color: var(--color-ready);
  }
  .home-xform__state :global(i.is-busy) {
    color: var(--color-electric-500);
  }
  .home-xform__scroll {
    overflow-x: auto;
  }
  .home-xtable {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .home-xtable th {
    text-align: right;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-4);
    padding: 10px 12px 8px;
    border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }
  .home-xtable th:first-child,
  .home-xtable td:first-child {
    text-align: left;
  }
  .home-xtable td {
    text-align: right;
    padding: 9px 12px;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }
  .home-xtable td.name {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
  }
  .home-xtable td.is-hot {
    color: var(--color-watch);
  }
  .home-xtable td.is-risk {
    color: var(--color-risk);
  }
  .home-xtable td.dec {
    width: 116px;
  }
  .home-xtable tr {
    transition: background-color 0.3s ease;
  }
  .home-xtable tr.is-scan {
    background: color-mix(in srgb, var(--color-electric) 10%, transparent);
  }
  .home-xtable .st-chip {
    transition:
      color 0.35s ease,
      background-color 0.35s ease;
  }
  .home-xform__foot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px 14px;
    align-items: start;
    padding: 14px 16px 16px;
    border-top: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .home-xform__foot .st-label--accent {
    padding-top: 3px;
  }
  .home-xform__foot p {
    margin: 0;
    font-size: 14px;
    color: var(--color-ink-2);
  }
  .home-xform__foot strong {
    color: var(--color-ink);
    font-weight: 500;
  }
  .home-xform__sources {
    grid-column: 2;
    color: var(--color-ink-4);
  }

  @media (max-width: 1080px) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (max-width: 560px) {
    .home-xtable .opt {
      display: none;
    }
    .home-xtable th,
    .home-xtable td {
      padding-inline: 8px;
    }
    .home-xtable td.dec {
      width: auto;
    }
    .home-xform__foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-xform__sources {
      grid-column: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-xtable tr,
    .home-xtable .st-chip {
      transition: none;
    }
  }
</style>

<script>
  // Rows resolve one by one: Import → the call. The table starts resolved
  // (legible at rest) and replays the scan while it is on screen. Reduced
  // motion keeps it static.
  const panel = document.querySelector<HTMLElement>('[data-xform]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (panel && !reduce) {
    const rows = [...panel.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const state = panel.querySelector<HTMLElement>('[data-xstate]');
    const restState = state?.innerHTML ?? '';
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const chip = (tr: HTMLTableRowElement) => tr.querySelector<HTMLElement>('.st-chip');
    const onScreen = () => panel.classList.contains('is-inview') && !document.hidden;

    const setWaiting = (tr: HTMLTableRowElement) => {
      const c = chip(tr);
      if (!c) return;
      c.className = 'st-chip st-chip--wait';
      c.textContent = panel.dataset.importing ?? '';
    };
    const resolve = (tr: HTMLTableRowElement) => {
      const c = chip(tr);
      if (!c) return;
      c.className = `st-chip st-chip--${tr.dataset.state}`;
      c.textContent = tr.dataset.label ?? '';
    };

    const loop = async () => {
      for (;;) {
        await sleep(4200);
        if (!onScreen()) continue;
        rows.forEach(setWaiting);
        if (state) {
          state.textContent = `${panel.dataset.busy} `;
          const i = document.createElement('i');
          i.className = 'is-busy';
          i.textContent = panel.dataset.busyValue ?? '';
          state.append(i);
        }
        await sleep(700);
        for (const tr of rows) {
          tr.classList.add('is-scan');
          await sleep(520);
          resolve(tr);
          tr.classList.remove('is-scan');
        }
        if (state) state.innerHTML = restState;
      }
    };
    loop();
  }
</script>
