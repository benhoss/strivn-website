---
import HomeWeek from './HomeWeek.astro';
import { KPI_TONES, ROSTER, WHY_VALUES, type HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['readiness'];
  status: HomeContent['status'];
  pct: string;
}

const { c, status, pct } = Astro.props;

const meterColor: Record<string, string> = {
  ready: 'var(--color-ready)',
  watch: 'var(--color-watch)',
  risk: 'var(--color-risk)',
  wait: 'transparent',
};
---

<HomeWeek id="readiness" stamp={c.stamp} links={c.links} labelledby="readiness-title">
  <div class="st-head">
    <h2 id="readiness-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-panel home-board">
    <dl class="home-board__head">
      {c.kpis.map((k, i) => (
        <div class="st-kpi">
          <dt class="st-label">{k.label}</dt>
          <dd class:list={['st-kpi__v', KPI_TONES[i] && `is-${KPI_TONES[i]}`]}>{k.value}</dd>
        </div>
      ))}
    </dl>
    <div class="home-board__cols">
      <ul class="home-roster" aria-label={c.rosterAria}>
        {ROSTER.map((p) => (
          <li>
            <span class="nm">{p.name}</span>
            <span class="st-meter" aria-hidden="true"><i style={`width:${p.bar}%;background:${meterColor[p.state]}`}></i></span>
            <span class:list={['acwr', p.tone && `is-${p.tone}`]}>{p.acwr}</span>
            <span class={`st-chip st-chip--${p.state}`}>{status[p.state]}</span>
          </li>
        ))}
      </ul>
      <aside class="home-why" aria-labelledby="why-title">
        <div class="home-why__title">
          <h3 id="why-title" class="st-h4">{c.whyTitle}</h3>
          <span class="st-label">{c.whyScore}</span>
        </div>
        <dl class="home-why__evidence">
          {c.evidence.map((label, i) => (
            <div>
              <dt>{label}</dt>
              <dd class={WHY_VALUES[i].tone && `is-${WHY_VALUES[i].tone}`}>
                {WHY_VALUES[i].v}{WHY_VALUES[i].pct && pct}
              </dd>
            </div>
          ))}
        </dl>
        <div class="st-proposal">
          <p>{c.proposal}</p>
          <div class="home-actions" aria-hidden="true">
            <span class="home-mini home-mini--primary">{c.apply}</span>
            <span class="home-mini">{c.edit}</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</HomeWeek>

<style>
  .home-board__head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 0;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .home-board__head dd {
    margin: 0;
  }
  .home-board__head .is-ready {
    color: var(--color-ready);
  }
  .home-board__head .is-watch {
    color: var(--color-watch);
  }
  .home-board__cols {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }
  .home-roster {
    list-style: none;
    margin: 0;
    padding: 8px 0;
  }
  .home-roster li {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 60px 116px;
    gap: 16px;
    align-items: center;
    padding: 11px 24px;
    border-bottom: 1px solid var(--color-line);
    font-size: 14px;
  }
  .home-roster li:last-child {
    border-bottom: 0;
  }
  .home-roster .nm {
    font-weight: 500;
    color: var(--color-ink);
  }
  .home-roster .acwr {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-ink-3);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .home-roster .acwr.is-hi {
    color: var(--color-risk);
  }
  .home-roster .acwr.is-mid {
    color: var(--color-watch);
  }
  .home-roster .st-chip {
    justify-self: start;
  }
  .home-why {
    display: grid;
    gap: 18px;
    align-content: start;
    padding: 24px;
    border-left: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .home-why__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .home-why__evidence {
    margin: 0;
  }
  .home-why__evidence div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 13.5px;
    color: var(--color-ink-2);
  }
  .home-why__evidence dd {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12.5px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .home-why__evidence dd.is-risk {
    color: var(--color-risk);
  }
  .home-why__evidence dd.is-watch {
    color: var(--color-watch);
  }
  .st-proposal p {
    margin: 0;
    color: var(--color-ink);
  }
  @media (max-width: 1080px) {
    .home-board__cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-why {
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }
  @media (max-width: 560px) {
    .home-roster li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
      padding: 12px 16px;
    }
    .home-roster .st-meter {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .home-roster .acwr {
      display: none;
    }
    .home-roster .st-chip {
      justify-self: end;
    }
    .home-board__head {
      padding: 16px;
      gap: 12px 24px;
    }
    .home-why {
      padding: 16px;
    }
  }
</style>
