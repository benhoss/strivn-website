---
import HomeWeek from './HomeWeek.astro';
import type { HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['board'];
}

/**
 * The tactical board as the staff draws it before the session: the tool
 * rail, a half-pitch with one pressing pattern, and the frame timeline. The
 * players replay the three frames along their arrows, as the board's own
 * playback does; with reduced motion the drawing stays on frame 1, where the
 * arrows already tell the move.
 *
 * Team A is filled, team B open: colour stays reserved for player states on
 * this page, so the two sides differ by shape, as the live runner's bibs do.
 */
const { c } = Astro.props;

/** Keyboard shortcuts of the board's tools, same order as `c.tools`. */
const KEYS = ['P', '⇧P', 'A', 'Z', 'C', 'T'];

/**
 * Pitch units: a 100 × 62 half-pitch, attacking right. Each moving piece
 * lists its position on frames 1, 2 and 3.
 */
type Pos = [number, number];
const TEAM_A: Array<{ n: number; f: [Pos, Pos, Pos] }> = [
  { n: 11, f: [[58, 11], [64, 10], [70, 9.5]] },
  { n: 9, f: [[68, 40], [76, 32], [81, 20.5]] },
  { n: 8, f: [[56, 27], [61, 27.3], [66, 27.5]] },
  { n: 7, f: [[58, 50], [63, 47], [68, 44]] },
  // The back line holds while the front four press.
  { n: 6, f: [[42, 31], [44, 31], [46, 31]] },
  { n: 4, f: [[28, 22], [30, 22], [32, 22]] },
  { n: 5, f: [[28, 40], [30, 40], [32, 40]] },
];
const TEAM_B: Pos[] = [
  [96, 31],
  [86, 20],
  [86, 42],
  [74, 5.5],
  [71, 27],
];
const BALL: [Pos, Pos, Pos] = [[88.5, 21.5], [76.5, 7.5], [76.5, 7.5]];
const CONES: Pos[] = [
  [52, 3],
  [52, 59],
];

/** CSS offsets of frames 2 and 3 from frame 1, for the playback keyframes. */
const moves = (f: [Pos, Pos, Pos]) =>
  `--x2:${f[1][0] - f[0][0]}px;--y2:${f[1][1] - f[0][1]}px;--x3:${f[2][0] - f[0][0]}px;--y3:${f[2][1] - f[0][1]}px`;
---

<HomeWeek id="board" stamp={c.stamp} links={c.links} labelledby="board-title">
  <div class="st-head">
    <h2 id="board-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <figure class="st-panel home-board" aria-label={c.aria}>
    <figcaption class="st-panel__bar home-board__bar">
      <span class="st-h4">{c.name}</span>
      <span class="st-tag">{c.meta}</span>
    </figcaption>

    <div class="home-board__main">
      <div class="home-board__tools" aria-hidden="true">
        <ul>
          {c.tools.map((t, i) => (
            <li class:list={[i === 2 && 'is-on']}>
              <span>{t}</span>
              <kbd>{KEYS[i]}</kbd>
            </li>
          ))}
        </ul>
        <p class="st-label">{c.arrowsLabel}</p>
        <ul class="home-board__arrows">
          {c.arrows.map((a, i) => (
            <li>
              <svg viewBox="0 0 40 8" aria-hidden="true">
                {i === 0 && <path class="ln ln--pass" d="M2 4 H33" />}
                {i === 1 && <path class="ln" d="M2 4 H33" />}
                {i === 2 && <path class="ln" d="M2 4 q2.5 -3.5 5 0 t5 0 t5 0 t5 0 t5 0 t6 0" />}
                <path class="hd" d="M32 1 L38 4 L32 7 Z" />
              </svg>
              <span>{a}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="home-board__pitch">
        <svg viewBox="0 0 100 62" aria-hidden="true">
          <defs>
            <marker id="hb-head" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="3" markerHeight="3" orient="auto">
              <path d="M0 0 L6 3 L0 6 Z" class="hb-head" />
            </marker>
          </defs>

          <g class="hb-lines">
            <rect x="0.5" y="0.5" width="99" height="61" />
            <path d="M0.5 21 A10 10 0 0 1 0.5 41" />
            <rect x="84" y="13" width="15.5" height="36" />
            <rect x="94.5" y="23" width="5" height="16" />
            <path d="M84 24 A8 8 0 0 0 84 38" />
            <circle cx="89" cy="31" r="0.5" class="hb-spot" />
          </g>

          <g class="hb-zone">
            <rect x="62" y="1.5" width="30" height="25" rx="1" />
            <text x="62.8" y="24.6">{c.zone}</text>
          </g>

          <g class="hb-arrows">
            <path class="ln--pass" d="M86.5 18.5 L77 7.5" marker-end="url(#hb-head)" />
            <path d="M60 11 L68.5 9.6" marker-end="url(#hb-head)" />
            <path d="M69.5 38 Q78.5 34.5 80.3 23.4" marker-end="url(#hb-head)" />
            <path d="M58 27 L63.4 27.4" marker-end="url(#hb-head)" />
            <path d="M59.5 49 L65.8 45" marker-end="url(#hb-head)" />
          </g>

          {CONES.map(([x, y]) => (
            <path class="hb-cone" d={`M${x - 1.2} ${y + 1} L${x} ${y - 1.2} L${x + 1.2} ${y + 1} Z`} />
          ))}

          {TEAM_B.map(([x, y]) => (
            <circle class="hb-b" cx={x} cy={y} r="2.1" />
          ))}

          {TEAM_A.map((p) => (
            <g class="hb-move" style={moves(p.f)}>
              <circle class="hb-a" cx={p.f[0][0]} cy={p.f[0][1]} r="2.3" />
              <text class="hb-n" x={p.f[0][0]} y={p.f[0][1] + 0.8}>{p.n}</text>
            </g>
          ))}

          <g class="hb-move hb-move--ball" style={moves(BALL)}>
            <circle class="hb-ball" cx={BALL[0][0]} cy={BALL[0][1]} r="1.1" />
          </g>
        </svg>
      </div>
    </div>

    <div class="home-board__foot">
      <ol class="home-board__frames" aria-hidden="true">
        <li class="home-board__play">▶</li>
        {[1, 2, 3].map((n) => (
          <li class={`f f${n}`}>
            {c.frame} {n}
          </li>
        ))}
      </ol>
      <span class="st-label home-board__attached">{c.attached}</span>
      <div class="home-actions" aria-hidden="true">
        <span class="home-mini home-mini--primary">{c.actions[0]}</span>
        <span class="home-mini">{c.actions[1]}</span>
        <span class="home-mini">{c.actions[2]}</span>
        <span class="home-mini">{c.actions[3]}</span>
      </div>
    </div>
  </figure>
</HomeWeek>

<style>
  .home-board {
    margin: 0;
  }
  .home-board__bar {
    justify-content: space-between;
  }
  .home-board__main {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
  }

  /* Tool rail: the arrow tool is the one in hand. */
  .home-board__tools {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 16px;
    border-right: 1px solid var(--color-line);
  }
  .home-board__tools ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .home-board__tools li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--color-ink-2);
  }
  .home-board__tools li.is-on {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-electric) 12%, transparent);
    box-shadow: inset 2px 0 0 var(--color-electric);
  }
  .home-board__tools kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-4);
  }
  .home-board__tools .st-label {
    margin: 8px 0 0;
    padding-inline: 10px;
  }
  .home-board__arrows li {
    justify-content: flex-start;
    gap: 10px;
  }
  .home-board__arrows svg {
    width: 34px;
    height: 8px;
    flex: none;
  }
  .home-board__arrows .ln {
    fill: none;
    stroke: var(--color-ink-2);
    stroke-width: 1.4;
  }
  .home-board__arrows .ln--pass {
    stroke-dasharray: 3 2.5;
  }
  .home-board__arrows .hd {
    fill: var(--color-ink-2);
  }

  /* The pitch: markings only, as on every drawn panel of the site. */
  .home-board__pitch {
    padding: 20px;
    background: var(--color-navy-900);
  }
  .home-board__pitch svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .hb-lines rect,
  .hb-lines path {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 0.35;
  }
  .hb-spot {
    fill: var(--color-line-strong);
  }
  .hb-zone rect {
    fill: color-mix(in srgb, var(--color-electric) 8%, transparent);
    stroke: var(--color-electric-500);
    stroke-width: 0.3;
    stroke-dasharray: 1.2 1;
  }
  .hb-zone text {
    font-family: var(--font-mono);
    font-size: 1.9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-electric-500);
  }
  .hb-arrows path {
    fill: none;
    stroke: var(--color-ink-2);
    stroke-width: 0.45;
    stroke-linecap: round;
  }
  .hb-arrows .ln--pass {
    stroke-dasharray: 1.4 1.1;
  }
  .hb-head {
    fill: var(--color-ink-2);
  }
  .hb-cone {
    fill: var(--color-ink-3);
  }
  .hb-a {
    fill: var(--color-electric);
    stroke: var(--color-navy-900);
    stroke-width: 0.5;
  }
  .hb-n {
    font-family: var(--font-mono);
    font-size: 2.2px;
    font-weight: 600;
    text-anchor: middle;
    fill: #fff;
  }
  .hb-b {
    fill: var(--color-navy-900);
    stroke: var(--color-ink-2);
    stroke-width: 0.5;
  }
  .hb-ball {
    fill: #fff;
    stroke: var(--color-navy-900);
    stroke-width: 0.3;
  }

  /* Timeline and actions. */
  .home-board__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 20px;
  }
  .home-board__frames {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
  }
  .home-board__frames li {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-3);
    white-space: nowrap;
  }
  .home-board__frames .f1 {
    color: var(--color-ink);
    border-color: var(--color-electric);
  }
  .home-board__play {
    color: var(--color-ink) !important;
  }
  .home-board__attached {
    flex: 1 1 200px;
    color: var(--color-ink-4);
  }

  /* Playback: frame 1 held, move to 2, hold, move to 3, hold, loop. The
     frame chips light in step. Offsets are pitch units (px = user units). */
  @media (prefers-reduced-motion: no-preference) {
    .hb-move {
      animation: hb-play 7s ease-in-out infinite;
    }
    .home-board__frames .f {
      animation: hb-chip 7s step-end infinite;
    }
    .home-board__frames .f1 {
      color: var(--color-ink-3);
      border-color: var(--color-line-strong);
    }
    .home-board__frames .f1 { animation-name: hb-chip1; }
    .home-board__frames .f2 { animation-name: hb-chip2; }
    .home-board__frames .f3 { animation-name: hb-chip3; }
  }
  @keyframes hb-play {
    0%, 18% { transform: translate(0, 0); }
    36%, 50% { transform: translate(var(--x2), var(--y2)); }
    68%, 92% { transform: translate(var(--x3), var(--y3)); }
    100% { transform: translate(0, 0); }
  }
  @keyframes hb-chip1 {
    0% { color: var(--color-ink); border-color: var(--color-electric); }
    27% { color: var(--color-ink-3); border-color: var(--color-line-strong); }
    96% { color: var(--color-ink); border-color: var(--color-electric); }
  }
  @keyframes hb-chip2 {
    0% { color: var(--color-ink-3); border-color: var(--color-line-strong); }
    27% { color: var(--color-ink); border-color: var(--color-electric); }
    59% { color: var(--color-ink-3); border-color: var(--color-line-strong); }
  }
  @keyframes hb-chip3 {
    0% { color: var(--color-ink-3); border-color: var(--color-line-strong); }
    59% { color: var(--color-ink); border-color: var(--color-electric); }
    96% { color: var(--color-ink-3); border-color: var(--color-line-strong); }
  }

  @media (max-width: 820px) {
    .home-board__main {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-board__tools {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
      grid-template-columns: minmax(0, 1fr);
    }
    .home-board__tools ul {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }
    .home-board__tools kbd,
    .home-board__tools .st-label {
      display: none;
    }
    .home-board__arrows {
      display: none !important;
    }
  }
  @media (max-width: 560px) {
    .home-board__pitch {
      padding: 12px;
    }
    .home-board__foot {
      padding-inline: 16px;
    }
  }
</style>
