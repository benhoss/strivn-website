---
import HomeWeek from './HomeWeek.astro';
import type { HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['board'];
}

/**
 * The tactical board as the staff draws it before the session: the tool
 * rail, a half-pitch with one pressing pattern, and the frame timeline. The
 * players replay the three frames along their arrows, as the board's own
 * playback does; with reduced motion the drawing stays on frame 1, where the
 * arrows already tell the move.
 *
 * Team A is filled, team B open: colour stays reserved for player states on
 * this page, so the two sides differ by shape, as the live runner's bibs do.
 */
const { c } = Astro.props;

/** Keyboard shortcuts of the board's tools, same order as `c.tools`. */
const KEYS = ['P', '⇧P', 'A', 'Z', 'C', 'T'];

/**
 * Pitch units: a 100 × 62 half-pitch, attacking right. Every run is the
 * arrow drawn on the board, and the player plays it back along that very
 * path, so the drawing and the movement can never disagree.
 */
type Pos = [number, number];
const RUNS: Array<{ n: number; from: Pos; d: string }> = [
  { n: 11, from: [58, 11], d: 'M58 11 L69.6 9.4' },
  { n: 9, from: [68, 40], d: 'M68 40 Q79 36.5 80.6 20.3' },
  { n: 8, from: [56, 27], d: 'M56 27 L65.6 27.4' },
  { n: 7, from: [58, 50], d: 'M58 50 L67.6 44.2' },
];
/** The back line steps up behind the press, without an arrow. */
const BACK: Array<{ n: number; at: Pos }> = [
  { n: 6, at: [42, 31] },
  { n: 4, at: [28, 22] },
  { n: 5, at: [28, 40] },
];
const BACK_SHIFT: Pos = [4, 0];
const TEAM_B: Pos[] = [
  [96, 31],
  [86, 20],
  [86, 42],
  [74, 5.5],
  [71, 27],
];
/** The sideways pass that triggers the press, from centre-back to full-back. */
const PASS = { from: [87.6, 21.6] as Pos, d: 'M87.6 21.6 L76.3 7.3' };
const CONES: Pos[] = [
  [52, 3],
  [52, 59],
];
---

<HomeWeek id="board" stamp={c.stamp} links={c.links} labelledby="board-title">
  <div class="st-head">
    <h2 id="board-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <figure class="st-panel home-board" aria-label={c.aria} data-board>
    <figcaption class="st-panel__bar home-board__bar">
      <span class="st-h4">{c.name}</span>
      <span class="st-tag">{c.meta}</span>
    </figcaption>

    <div class="home-board__main">
      <div class="home-board__tools" aria-hidden="true">
        <ul>
          {c.tools.map((t, i) => (
            <li class:list={[i === 2 && 'is-on']}>
              <span>{t}</span>
              <kbd>{KEYS[i]}</kbd>
            </li>
          ))}
        </ul>
        <p class="st-label">{c.arrowsLabel}</p>
        <ul class="home-board__arrows">
          {c.arrows.map((a, i) => (
            <li>
              <svg viewBox="0 0 40 8" aria-hidden="true">
                {i === 0 && <path class="ln ln--pass" d="M2 4 H33" />}
                {i === 1 && <path class="ln" d="M2 4 H33" />}
                {i === 2 && <path class="ln" d="M2 4 q2.5 -3.5 5 0 t5 0 t5 0 t5 0 t5 0 t6 0" />}
                <path class="hd" d="M32 1 L38 4 L32 7 Z" />
              </svg>
              <span>{a}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="home-board__pitch">
        <svg viewBox="0 0 100 62" aria-hidden="true">
          <defs>
            <marker id="hb-head" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="3" markerHeight="3" orient="auto">
              <path d="M0 0 L6 3 L0 6 Z" class="hb-head" />
            </marker>
          </defs>

          <g class="hb-lines">
            <rect x="0.5" y="0.5" width="99" height="61" />
            <path d="M0.5 21 A10 10 0 0 1 0.5 41" />
            <rect x="84" y="13" width="15.5" height="36" />
            <rect x="94.5" y="23" width="5" height="16" />
            <path d="M84 24 A8 8 0 0 0 84 38" />
            <circle cx="89" cy="31" r="0.5" class="hb-spot" />
          </g>

          <g class="hb-zone">
            <rect x="62" y="1.5" width="30" height="25" rx="1" />
            <text x="62.8" y="24.6">{c.zone}</text>
          </g>

          <g class="hb-arrows">
            <path id="hb-pass" class="ln--pass" d={PASS.d} marker-end="url(#hb-head)" />
            {RUNS.map((r) => <path id={`hb-run-${r.n}`} d={r.d} marker-end="url(#hb-head)" />)}
          </g>

          {CONES.map(([x, y]) => (
            <path class="hb-cone" d={`M${x - 1.2} ${y + 1} L${x} ${y - 1.2} L${x + 1.2} ${y + 1} Z`} />
          ))}

          {TEAM_B.map(([x, y]) => (
            <circle class="hb-b" cx={x} cy={y} r="2.1" />
          ))}

          <g data-board-layer>
            {BACK.map((p) => (
              <g transform={`translate(${p.at[0]} ${p.at[1]})`} data-at={p.at.join(' ')} data-shift={BACK_SHIFT.join(' ')}>
                <circle class="hb-a" r="2.3" />
                <text class="hb-n" y="0.8">{p.n}</text>
              </g>
            ))}
            {RUNS.map((r) => (
              <g transform={`translate(${r.from[0]} ${r.from[1]})`} data-run={`hb-run-${r.n}`}>
                <circle class="hb-a" r="2.3" />
                <text class="hb-n" y="0.8">{r.n}</text>
              </g>
            ))}
            <g transform={`translate(${PASS.from[0]} ${PASS.from[1]})`} data-ball="hb-pass">
              <circle class="hb-ball" r="1.1" />
            </g>
          </g>
        </svg>
      </div>
    </div>

    <div class="home-board__foot">
      <ol class="home-board__frames" aria-hidden="true">
        <li class="home-board__play">▶</li>
        {[1, 2, 3].map((n) => (
          <li class:list={['f', n === 1 && 'is-on']} data-frame>
            {c.frame} {n}
          </li>
        ))}
      </ol>
      <span class="st-label home-board__attached">{c.attached}</span>
      <div class="home-actions" aria-hidden="true">
        <span class="home-mini home-mini--primary">{c.actions[0]}</span>
        <span class="home-mini">{c.actions[1]}</span>
        <span class="home-mini">{c.actions[2]}</span>
        <span class="home-mini">{c.actions[3]}</span>
      </div>
    </div>
  </figure>
</HomeWeek>

<style>
  .home-board {
    margin: 0;
  }
  .home-board__bar {
    justify-content: space-between;
  }
  .home-board__main {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
  }

  /* Tool rail: the arrow tool is the one in hand. */
  .home-board__tools {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 16px;
    border-right: 1px solid var(--color-line);
  }
  .home-board__tools ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .home-board__tools li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--color-ink-2);
  }
  .home-board__tools li.is-on {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-electric) 12%, transparent);
    box-shadow: inset 2px 0 0 var(--color-electric);
  }
  .home-board__tools kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-4);
  }
  .home-board__tools .st-label {
    margin: 8px 0 0;
    padding-inline: 10px;
  }
  .home-board__arrows li {
    justify-content: flex-start;
    gap: 10px;
  }
  .home-board__arrows svg {
    width: 34px;
    height: 8px;
    flex: none;
  }
  .home-board__arrows .ln {
    fill: none;
    stroke: var(--color-ink-2);
    stroke-width: 1.4;
  }
  .home-board__arrows .ln--pass {
    stroke-dasharray: 3 2.5;
  }
  .home-board__arrows .hd {
    fill: var(--color-ink-2);
  }

  /* The pitch: markings only, as on every drawn panel of the site. */
  .home-board__pitch {
    padding: 20px;
    background: var(--color-navy-900);
  }
  .home-board__pitch svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .hb-lines rect,
  .hb-lines path {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 0.35;
  }
  .hb-spot {
    fill: var(--color-line-strong);
  }
  .hb-zone rect {
    fill: color-mix(in srgb, var(--color-electric) 8%, transparent);
    stroke: var(--color-electric-500);
    stroke-width: 0.3;
    stroke-dasharray: 1.2 1;
  }
  .hb-zone text {
    font-family: var(--font-mono);
    font-size: 1.9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-electric-500);
  }
  .hb-arrows path {
    fill: none;
    stroke: var(--color-ink-2);
    stroke-width: 0.45;
    stroke-linecap: round;
  }
  .hb-arrows .ln--pass {
    stroke-dasharray: 1.4 1.1;
  }
  .hb-head {
    fill: var(--color-ink-2);
  }
  .hb-cone {
    fill: var(--color-ink-3);
  }
  .hb-a {
    fill: var(--color-electric);
    stroke: var(--color-navy-900);
    stroke-width: 0.5;
  }
  .hb-n {
    font-family: var(--font-mono);
    font-size: 2.2px;
    font-weight: 600;
    text-anchor: middle;
    fill: #fff;
  }
  .hb-b {
    fill: var(--color-navy-900);
    stroke: var(--color-ink-2);
    stroke-width: 0.5;
  }
  .hb-ball {
    fill: #fff;
    stroke: var(--color-navy-900);
    stroke-width: 0.3;
  }

  /* Timeline and actions. */
  .home-board__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 20px;
  }
  .home-board__frames {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
  }
  .home-board__frames li {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-3);
    white-space: nowrap;
  }
  .home-board__frames .is-on {
    color: var(--color-ink);
    border-color: var(--color-electric);
  }
  .home-board__play {
    color: var(--color-ink) !important;
  }
  .home-board__attached {
    flex: 1 1 200px;
    color: var(--color-ink-4);
  }

  @media (max-width: 820px) {
    .home-board__main {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-board__tools {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
      grid-template-columns: minmax(0, 1fr);
    }
    .home-board__tools ul {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }
    .home-board__tools kbd,
    .home-board__tools .st-label {
      display: none;
    }
    .home-board__arrows {
      display: none !important;
    }
  }
  @media (max-width: 560px) {
    .home-board__pitch {
      padding: 12px;
    }
    .home-board__foot {
      padding-inline: 16px;
    }
  }
</style>

<script>
  /**
   * Playback of the board, frame by frame, as the app plays it:
   *   image 1  the set-up, held;
   *   image 2  the sideways pass, the trigger: the ball travels its arrow
   *            and the four pressers start on theirs;
   *   image 3  the press closes, the back line steps up, held;
   * then the pressers fade out and come back on image 1. Every player moves
   * along its own drawn arrow. Runs only while the board is on screen; with
   * reduced motion the board stays on image 1, where the arrows tell it all.
   */
  const FADE = 400;
  const PASS_AT = FADE + 900; // image 2 starts: the pass leaves
  const PASS_MS = 900;
  const PRESS_AT = PASS_AT + PASS_MS + 250; // image 3 starts
  const PRESS_MS = 1300;
  const END = PRESS_AT + PRESS_MS + 2200; // fade out, then loop
  const TOTAL = END + FADE;
  /** Share of each run covered by the end of image 2: they react on the pass. */
  const REACT = 0.3;

  const ease = (t: number) => {
    const x = Math.min(1, Math.max(0, t));
    return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
  };
  const place = (g: SVGGElement, x: number, y: number) =>
    g.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-board]').forEach((root) => {
    const along = (g: SVGGElement, id: string) => {
      const path = root.querySelector<SVGPathElement>(`#${id}`)!;
      return { g, path, len: path.getTotalLength() };
    };
    const runs = [...root.querySelectorAll<SVGGElement>('[data-run]')].map((g) => along(g, g.dataset.run!));
    const balls = [...root.querySelectorAll<SVGGElement>('[data-ball]')].map((g) => along(g, g.dataset.ball!));
    const back = [...root.querySelectorAll<SVGGElement>('[data-shift]')].map((g) => {
      const [x, y] = g.dataset.at!.split(' ').map(Number);
      const [dx, dy] = g.dataset.shift!.split(' ').map(Number);
      return { g, x, y, dx, dy };
    });
    const layer = root.querySelector<SVGGElement>('[data-board-layer]')!;
    const chips = [...root.querySelectorAll<HTMLElement>('[data-frame]')];

    let frame = -1;
    const draw = (t: number) => {
      const pass = ease((t - PASS_AT) / PASS_MS);
      const press = ease((t - PRESS_AT) / PRESS_MS);
      const run = REACT * ease((t - PASS_AT - 150) / (PASS_MS - 150)) + (1 - REACT) * press;

      balls.forEach(({ g, path, len }) => {
        const p = path.getPointAtLength(pass * len);
        place(g, p.x, p.y);
      });
      runs.forEach(({ g, path, len }) => {
        const p = path.getPointAtLength(run * len);
        place(g, p.x, p.y);
      });
      back.forEach(({ g, x, y, dx, dy }) => place(g, x + dx * press, y + dy * press));

      const fade = t < FADE ? t / FADE : t > END ? 1 - (t - END) / FADE : 1;
      layer.style.opacity = fade.toFixed(3);

      const f = t < PASS_AT ? 0 : t < PRESS_AT ? 1 : 2;
      if (f !== frame) {
        frame = f;
        chips.forEach((c, i) => c.classList.toggle('is-on', i === f));
      }
    };

    let raf = 0;
    let start = 0;
    const tick = (now: number) => {
      if (!start) start = now;
      draw((now - start) % TOTAL);
      raf = requestAnimationFrame(tick);
    };
    const play = () => {
      if (raf || reduced.matches) return;
      start = 0;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      draw(FADE); // back on image 1, fully drawn
    };

    new IntersectionObserver(([e]) => (e.isIntersecting ? play() : stop()), { threshold: 0.35 }).observe(root);
    reduced.addEventListener('change', () => (reduced.matches ? stop() : undefined));
  });
</script>
