---
import { CONTACT_EMAIL, type HomeContent, type Locale } from '../../data/homeContent';
import { appStartUrl } from '../../lib/appUrl';

interface Props {
  locale: Locale;
  finalCta: HomeContent['finalCta'];
}

/* Closes the homepage and the other landing pages (features, S&C,
   solutions, sub-pages), so it carries its own styles and no page state.
   The pair is the voice's CTA pair: self-serve, then a person. */
const { locale, finalCta: c } = Astro.props;
---

<section class="home-final st-grid-bg" aria-labelledby="final-title">
  <div class="st-wrap home-final__in">
    <h2 id="final-title" class="st-display home-final__title">{c.title}</h2>
    <div class="home-final__side">
      <p class="st-lede">{c.body}</p>
      <div class="st-ctas">
        <a class="st-btn st-btn--primary" href={appStartUrl(locale)} target="_blank" rel="noopener">
          {c.primaryCta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="st-btn st-btn--ghost" href={`mailto:${CONTACT_EMAIL}`}>{c.secondaryCta}</a>
      </div>
      <p class="st-fine">{c.fine.map((f) => <span>{f}</span>)}</p>
    </div>
  </div>
</section>

<style>
  .home-final {
    overflow: hidden;
    padding-block: clamp(80px, 11vw, 144px);
    border-top: 1px solid var(--color-line);
    background: var(--color-void);
  }
  .home-final__in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
    align-items: end;
  }
  .home-final__title {
    font-size: clamp(40px, 6.4vw, 84px);
  }
  .home-final__side {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .home-final__side .st-fine {
    margin: 0;
  }
  @media (max-width: 1080px) {
    .home-final__in {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
