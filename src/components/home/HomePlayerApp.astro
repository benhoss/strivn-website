---
import type { HomeContent } from '../../data/homeContent';
import HomeIcon from './HomeIcon.astro';

interface Props {
  playerApp: HomeContent['playerApp'];
}

const { playerApp: c } = Astro.props;

/** RPE scale: 10 steps, the reported value is the last filled step. */
const rpeValue = Number(c.phone.rpe.value);
---

<section class="bg-[#05070F] py-20 md:py-28" aria-labelledby="player-title">
  <div class="hl-wrap grid items-center gap-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
    <!-- ── Copy ── -->
    <div class="hl-reveal">
      <p class="hl-index text-[#7AB8FF]">
        {c.index}
        <span class="hl-index__rule"></span>
        <span class="text-[#68779A]">{c.kicker}</span>
      </p>
      <h2 id="player-title" class="hl-display mt-5 max-w-[16ch] text-[clamp(2rem,4.4vw,3.1rem)]">{c.title}</h2>
      <p class="mt-5 max-w-[34rem] text-[1rem] leading-[1.65] text-[#AAB8D4]">{c.body}</p>

      <ul class="mt-7 flex flex-col gap-3.5" data-stagger>
        {c.points.map((point) => (
          <li class="flex items-start gap-3 text-[0.95rem] leading-[1.5] text-[#C6D2E8]">
            <HomeIcon name={point.icon} size={16} class="mt-0.5 shrink-0 text-[#7AB8FF]" />
            {point.label}
          </li>
        ))}
      </ul>

      <p class="mt-7 flex items-start gap-3 rounded-[12px] bg-[#FFFFFF04] px-4 py-3.5 text-[0.88rem] leading-[1.55] text-[#AAB8D4] outline-1 outline-[#FFFFFF0F] -outline-offset-[0.5px]">
        <HomeIcon name="link" size={15} class="mt-0.5 shrink-0 text-[#68779A]" />
        {c.note}
      </p>

      <p class="mt-8 flex flex-wrap items-center gap-5">
        <a
          href={c.href}
          class="hl-btn inline-flex items-center gap-2 rounded-full bg-[#FFFFFF08] px-5 py-3 text-[0.92rem] font-semibold text-[#F8FAFC] outline-1 outline-[#FFFFFF1F] -outline-offset-[0.5px] hover:bg-[#FFFFFF12]"
        >
          {c.cta}
          <HomeIcon name="arrow-right" size={15} />
        </a>
        <span class="font-mono text-[0.62rem] tracking-[0.14em] text-[#68779A]">{c.stores}</span>
      </p>
    </div>

    <!-- ── Player app screen ── -->
    <div class="hl-reveal hl-reveal--right relative flex justify-center" style="--d: 180ms;">
      <div
        class="pointer-events-none absolute inset-0 [background:radial-gradient(ellipse_58%_46%_at_50%_50%,rgba(45,127,249,0.2),transparent_70%)]"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative w-full max-w-[286px] rounded-[40px] bg-[#0B1020] p-2.5 outline-1 outline-[#FFFFFF1A] -outline-offset-[0.5px] [box-shadow:0_44px_100px_-34px_rgba(2,6,18,0.98)]"
      >
        <div class="overflow-hidden rounded-[32px] bg-[#0A0E1A] px-4 pt-3.5 pb-5">
          <!-- Status bar -->
          <div class="flex items-center justify-between px-1">
            <span class="text-[0.7rem] font-semibold text-[#E2E8F0]">{c.phone.time}</span>
            <span class="flex items-end gap-[2px]" aria-hidden="true">
              <span class="h-1 w-[2px] rounded-[1px] bg-[#3D4A66]"></span>
              <span class="h-1.5 w-[2px] rounded-[1px] bg-[#68779A]"></span>
              <span class="h-2 w-[2px] rounded-[1px] bg-[#8CA3C7]"></span>
              <span class="h-2.5 w-[2px] rounded-[1px] bg-[#E2E8F0]"></span>
            </span>
          </div>

          <!-- Greeting -->
          <p class="mt-4 px-1 text-[1.05rem] leading-tight font-bold text-[#F8FAFC]">{c.phone.greeting}</p>
          <p class="mt-1 px-1 text-[0.72rem] text-[#68779A]">{c.phone.team}</p>

          <!-- Wellness check-in -->
          <div class="mt-4 rounded-[14px] bg-[#FFFFFF06] p-3.5 outline-1 outline-[#FFFFFF0C] -outline-offset-[0.5px]">
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-[0.78rem] font-semibold text-[#F8FAFC]">{c.phone.wellness.title}</p>
              <span class="font-mono text-[0.6rem] whitespace-nowrap text-[#68779A]">{c.phone.wellness.badge}</span>
            </div>
            <ul class="mt-3 flex flex-col gap-2" data-stagger>
              {c.phone.wellness.rows.map((row) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="text-[0.72rem] text-[#AAB8D4]">{row.label}</span>
                  <span class="flex gap-1" aria-hidden="true">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <span
                        class={`h-[15px] w-[17px] rounded-[4px] ${i + 1 === row.value ? 'bg-[#2D7FF9]' : 'bg-[#FFFFFF0F]'}`}
                      ></span>
                    ))}
                  </span>
                </li>
              ))}
            </ul>
            <p class="mt-3.5 rounded-[10px] bg-[#2D7FF9] py-2.5 text-center text-[0.78rem] font-semibold text-white">
              {c.phone.wellness.submit}
            </p>
          </div>

          <!-- RPE -->
          <div class="mt-2.5 rounded-[14px] bg-[#FFFFFF06] p-3.5 outline-1 outline-[#FFFFFF0C] -outline-offset-[0.5px]">
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-[0.78rem] font-semibold text-[#F8FAFC]">{c.phone.rpe.title}</p>
              <span class="text-[0.92rem] leading-none font-bold text-[#7AB8FF]">{c.phone.rpe.value}</span>
            </div>
            <span class="mt-3 flex gap-1" aria-hidden="true">
              {Array.from({ length: 10 }).map((_, i) => (
                <span
                  class={`h-[13px] flex-1 rounded-[3px] ${
                    i + 1 === rpeValue ? 'bg-[#2D7FF9]' : i + 1 < rpeValue ? 'bg-[#2D7FF959]' : 'bg-[#FFFFFF0F]'
                  }`}
                ></span>
              ))}
            </span>
          </div>

          <!-- Workout of the day -->
          <div class="mt-2.5 flex items-center gap-3 rounded-[14px] bg-[#FFFFFF06] p-3.5 outline-1 outline-[#FFFFFF0C] -outline-offset-[0.5px]">
            <HomeIcon name="dumbbell" size={15} class="shrink-0 text-[#7AB8FF]" />
            <span class="min-w-0 flex-1">
              <span class="block text-[0.76rem] leading-snug font-semibold text-[#F8FAFC]">{c.phone.workout.title}</span>
              <span class="block text-[0.68rem] text-[#68779A]">{c.phone.workout.meta}</span>
            </span>
            <HomeIcon name="arrow-right" size={14} class="shrink-0 text-[#3D4A66]" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
