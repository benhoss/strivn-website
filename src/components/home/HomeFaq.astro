---
import type { HomeContent } from '../../data/homeContent';

interface Props {
  faq: HomeContent['faq'];
}

const { faq: c } = Astro.props;
---

<section id="faq" class="scroll-mt-24 bg-[#070A14] py-20 md:py-28" aria-labelledby="faq-title">
  <div class="hl-wrap grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-20">
    <div class="hl-reveal">
      <p class="hl-index text-[#7AB8FF]">
        {c.index}
        <span class="hl-index__rule"></span>
        <span class="text-[#68779A]">{c.kicker}</span>
      </p>
      <h2 id="faq-title" class="hl-display mt-5 max-w-[14ch] text-[clamp(2rem,4.2vw,3rem)]">{c.title}</h2>
      <p class="mt-4 max-w-[26rem] text-[0.98rem] leading-[1.6] text-[#AAB8D4]">{c.body}</p>

      <div class="mt-10 rounded-[16px] bg-[#0B1020] p-5 outline-1 outline-[#FFFFFF0F] -outline-offset-[0.5px]">
        <p class="text-[0.98rem] font-bold text-[#F8FAFC]">{c.contactTitle}</p>
        <p class="mt-1 text-[0.88rem] leading-[1.55] text-[#AAB8D4]">{c.contactBody}</p>
        <a href={`mailto:${c.email}`} class="mt-3 inline-block font-mono text-[0.82rem] text-[#7AB8FF] hover:underline">{c.email}</a>
      </div>
    </div>

    <div class="hl-reveal hl-faq" style="--d: 120ms;" data-stagger>
      {c.items.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
