---
import type { HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['faq'];
}

const { c } = Astro.props;

/**
 * The answers are rendered verbatim (they also feed the FAQPage JSON-LD);
 * the contact address inside an answer becomes a link, nothing else changes.
 */
const parts = (a: string) => a.split(c.email);
const half = Math.ceil(c.items.length / 2);
const columns = [c.items.slice(0, half), c.items.slice(half)];
---

<section class="st-sec home-faq" id="faq" aria-labelledby="faq-title">
  <div class="st-wrap">
    <div class="st-head">
      <span class="st-label">{c.label}</span>
      <h2 id="faq-title" class="st-h2">{c.title}</h2>
    </div>
    <div class="home-faq__cols">
      {columns.map((items, col) => (
        <div class="st-faq">
          {items.map((item, i) => (
            <details open={col === 0 && i === 0 ? true : undefined}>
              <summary>{item.q}</summary>
              <p>
                {parts(item.a).map((chunk, j) => (
                  <>
                    {j > 0 && <a href={`mailto:${c.email}`}>{c.email}</a>}
                    {chunk}
                  </>
                ))}
              </p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .home-faq__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 48px;
    align-items: start;
  }
  .home-faq__cols > .st-faq {
    align-content: start;
  }
  .home-faq__cols a {
    color: var(--color-electric-500);
    text-decoration: none;
  }
  .home-faq__cols a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 820px) {
    .home-faq__cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-faq__cols > .st-faq + .st-faq {
      border-top: 0;
    }
  }
</style>
