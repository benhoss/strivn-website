---
import HomeSection from './HomeSection.astro';
import { PLAN_ADJUSTMENTS, PLAN_DAYS, PLAN_TODAY, type HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['plan'];
  status: HomeContent['status'];
  pct: string;
}

const { c, status, pct } = Astro.props;

/**
 * Drawn to scale from `PLAN_DAYS`: 0–700 AU over 200px, so
 * y = BASE − AU × 200 / 700. Seven 80px slots from x = 38; target bars are
 * 44px wide (dashed), actual bars 28px, centred in the same slot.
 */
const MAX = 700;
const H = 200;
const BASE = 220;
const SLOT = 80;
const X0 = 38;
const y = (au: number) => +(BASE - (au * H) / MAX).toFixed(1);
const cx = (i: number) => X0 + SLOT * i + SLOT / 2;
const GRID = [0, 200, 400, 600];
const labels = [...c.days, c.match];

const bars = PLAN_DAYS.map((d, i) => {
  const over = d.actual !== null && d.actual > d.target ? Math.round(((d.actual - d.target) / d.target) * 100) : null;
  return { ...d, i, x: cx(i), over, top: y(Math.max(d.target, d.actual ?? 0)) };
});
---

<HomeSection id="plan" label={c.label} links={c.links} labelledby="plan-title">
  <div class="st-head">
    <h2 id="plan-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="home-plan">
    <figure class="st-panel home-chart">
      <div class="home-chart__head">
        <span class="st-label">{c.chartLabel}</span>
        <div class="home-chart__legend" aria-hidden="true">
          <span><i class="is-target"></i>{c.legendTarget}</span>
          <span><i class="is-actual"></i>{c.legendActual}</span>
        </div>
      </div>
      <div class="home-chart__scroll">
        <svg viewBox="0 0 620 262" role="img" aria-label={c.chartAria}>
          <g class="grid">
            {GRID.map((v) => <line x1="34" x2="612" y1={y(v)} y2={y(v)} />)}
          </g>
          <g class="axis" text-anchor="end">
            {GRID.map((v) => <text x="28" y={y(v) + 4}>{v}</text>)}
          </g>
          <g class="target" data-st-bars>
            {bars.map((b) => (
              <rect x={b.x - 22} y={y(b.target)} width="44" height={+(BASE - y(b.target)).toFixed(1)} rx="3" />
            ))}
          </g>
          <g class="actual" data-st-bars>
            {bars
              .filter((b) => b.actual !== null)
              .map((b) => (
                <rect x={b.x - 14} y={y(b.actual!)} width="28" height={+(BASE - y(b.actual!)).toFixed(1)} rx="2" />
              ))}
          </g>
          {bars
            .filter((b) => b.over !== null)
            .map((b) => (
              <text class="over" x={b.x} y={b.top - 8} text-anchor="middle">+{b.over}{pct}</text>
            ))}
          <line class="today" x1={cx(PLAN_TODAY)} x2={cx(PLAN_TODAY)} y1="30" y2={BASE} />
          <text class="today-label" x={cx(PLAN_TODAY)} y="22" text-anchor="middle">{c.today}</text>
          <g class="axis" text-anchor="middle">
            {bars.map((b) => (
              <text x={b.x} y="242" class:list={[b.i === 6 && 'is-match']}>{labels[b.i]}</text>
            ))}
            {bars.map((b) => (
              <text x={b.x} y="258">{b.actual ?? b.target}</text>
            ))}
          </g>
        </svg>
      </div>
    </figure>

    <div class="home-adjust">
      <span class="st-label">{c.adjustLabel}</span>
      <ul>
        {PLAN_ADJUSTMENTS.map((a, i) => (
          <li>
            <div class="who"><b>{a.name}</b><span class={`st-chip st-chip--${a.state}`}>{status[a.state]}</span></div>
            <p>{c.adjustments[i]}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</HomeSection>

<style>
  .home-plan {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .home-chart {
    margin: 0;
    padding: 20px 20px 12px;
  }
  .home-chart__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .home-chart__legend {
    display: flex;
    gap: 16px;
    font-size: 12.5px;
    color: var(--color-ink-3);
  }
  .home-chart__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .home-chart__legend i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  .home-chart__legend i.is-target {
    background: color-mix(in srgb, var(--color-navy-700) 55%, transparent);
    border: 1px dashed var(--color-navy-300);
  }
  .home-chart__legend i.is-actual {
    background: var(--color-electric);
  }
  .home-chart__scroll {
    overflow-x: auto;
  }
  .home-chart svg {
    display: block;
    width: 100%;
    min-width: 480px;
    height: auto;
  }
  .home-chart text {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--color-navy-300);
  }
  .home-chart .grid line {
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .home-chart .target rect {
    fill: color-mix(in srgb, var(--color-navy-700) 55%, transparent);
    stroke: var(--color-navy-300);
    stroke-dasharray: 3 3;
    stroke-width: 1;
  }
  .home-chart .actual rect {
    fill: var(--color-electric);
  }
  .home-chart text.over {
    fill: var(--color-watch);
  }
  .home-chart .today {
    stroke: var(--color-electric-500);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }
  .home-chart text.today-label {
    fill: var(--color-electric-500);
  }
  .home-chart text.is-match {
    fill: var(--color-ink);
  }

  .home-adjust {
    display: grid;
    border-top: 1px solid var(--color-line-strong);
  }
  .home-adjust > .st-label {
    padding-top: 14px;
  }
  .home-adjust ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .home-adjust li {
    display: grid;
    gap: 6px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .home-adjust .who {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .home-adjust .who b {
    font-weight: 600;
    color: var(--color-ink);
  }
  .home-adjust p {
    margin: 0;
    font-size: 14.5px;
    color: var(--color-ink-2);
  }
  @media (max-width: 1080px) {
    .home-plan {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .home-chart {
      padding: 16px 12px 8px;
    }
  }
</style>
