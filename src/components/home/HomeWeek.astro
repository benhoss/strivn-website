---
import type { MoreLink, Stamp } from '../../data/homeContent';

/**
 * One moment of the session cycle the homepage follows: the mono stamp in the
 * left rail (when · what), the section's own content, then the "Voir …" links
 * to the feature pages that tell the rest.
 */
interface Props {
  id: string;
  stamp: Stamp;
  links?: MoreLink[];
  labelledby?: string;
}

const { id, stamp, links = [], labelledby } = Astro.props;
---

<section class="st-sec home-week" id={id} aria-labelledby={labelledby}>
  <div class="st-wrap st-frame">
    <div class="st-stamp" aria-hidden="true">
      <span class="st-stamp__a">{stamp.day}</span>
      <span class="st-stamp__c">{stamp.what}</span>
    </div>
    <div class="home-week__body">
      <slot />
      {links.length > 0 && (
        <p class="home-week__more">
          {links.map((l) => <a class="st-link" href={l.href}>{l.label}</a>)}
        </p>
      )}
    </div>
  </div>
</section>

<style>
  /* The header carries the session rail on this page: 64px bar + 30px rail. */
  .home-week {
    scroll-margin-top: 126px;
  }
  .home-week :global([id]) {
    scroll-margin-top: 126px;
  }
  .st-stamp {
    top: 126px;
  }
  .home-week__body {
    min-width: 0;
  }
  .home-week__more {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: clamp(28px, 4vw, 40px) 0 0;
    font-size: 15px;
  }
  @media (max-width: 820px) {
    .home-week,
    .home-week :global([id]) {
      scroll-margin-top: 96px;
    }
  }
</style>
