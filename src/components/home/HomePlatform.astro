---
import type { HomeContent } from '../../data/homeContent';
import HomeIcon from './HomeIcon.astro';

interface Props {
  platform: HomeContent['platform'];
  /**
   * Position in the host page's numbered sequence. The homepage runs one and
   * passes nothing; the overview page has no such sequence, so it passes null
   * and the chip drops the number rather than borrowing the homepage's "04".
   */
  index?: string | null;
  /** Heading and lede, when the host page needs its own. */
  title?: string;
  body?: string;
}

const { platform: c } = Astro.props;
const index = Astro.props.index === undefined ? c.index : Astro.props.index;
const title = Astro.props.title ?? c.title;
const body = Astro.props.body ?? c.body;
---

<section id="plateforme" class="scroll-mt-24 bg-[#05070F] py-20 md:py-28" aria-labelledby="platform-title">
  <div class="hl-wrap">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:items-end">
      <div class="hl-reveal">
        <p class="hl-index text-[#7AB8FF]">
          {index}
          {index && <span class="hl-index__rule"></span>}
          <span class="text-[#68779A]">{c.kicker}</span>
        </p>
        <h2 id="platform-title" class="hl-display mt-5 max-w-[18ch] text-[clamp(2.1rem,4.6vw,3.4rem)]">{title}</h2>
      </div>
      <p class="hl-reveal text-[1rem] leading-[1.65] text-[#AAB8D4] lg:pb-2" style="--d: 100ms;">{body}</p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {c.featured.map((card, i) => (
        <article
          class={`hl-reveal hl-reveal--card hl-lift rounded-[18px] p-6 outline-1 -outline-offset-[0.5px] sm:p-7 ${
            i === 0
              ? 'bg-gradient-to-br from-[#12203E] to-[#0B1020] outline-[#2D7FF938]'
              : 'bg-[#0B1020] outline-[#FFFFFF0F]'
          }`}
          style={`--d: ${i * 90}ms;`}
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="flex items-center gap-3 text-[1.35rem] font-bold tracking-[-0.01em] text-[#F8FAFC]">
              <HomeIcon name={card.icon} size={20} class={card.badgeTone === 'green' ? 'text-[#8CE99A]' : 'text-[#7AB8FF]'} />
              {card.title}
            </h3>
            <span
              class={`rounded-full px-3 py-1 font-mono text-[0.56rem] tracking-[0.12em] outline-1 -outline-offset-[0.5px] ${
                card.badgeTone === 'green' ? 'text-[#8CE99A] outline-[#8CE99A38] bg-[#8CE99A0A]' : 'text-[#7AB8FF] outline-[#2D7FF945] bg-[#2D7FF90F]'
              }`}
            >
              {card.badge}
            </span>
          </div>
          <p class="mt-3 text-[0.95rem] leading-[1.6] text-[#AAB8D4]">{card.body}</p>
          <p class="mt-4">
            <a href={card.href} class={`hl-more text-[0.9rem] ${card.badgeTone === 'green' ? 'text-[#8CE99A]' : 'text-[#7AB8FF]'}`}>
              {card.cta}
              <HomeIcon name="arrow-right" size={14} />
            </a>
          </p>
        </article>
      ))}
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {c.cards.map((card, i) => (
        <article class="hl-reveal hl-reveal--card hl-lift flex flex-col rounded-[18px] bg-[#0B1020] p-6 outline-1 outline-[#FFFFFF0F] -outline-offset-[0.5px]" style={`--d: ${(i % 3) * 80}ms;`}>
          <span class="grid size-11 place-items-center rounded-[12px] bg-[#FFFFFF06] text-[#7AB8FF] outline-1 outline-[#FFFFFF10] -outline-offset-[0.5px]">
            <HomeIcon name={card.icon} size={19} />
          </span>
          <h3 class="mt-5 text-[1.08rem] font-bold text-[#F8FAFC]">{card.title}</h3>
          <p class="mt-2 flex-1 text-[0.9rem] leading-[1.6] text-[#AAB8D4]">{card.body}</p>
          <p class="mt-4">
            <a href={card.href} class="hl-more text-[0.85rem] text-[#7AB8FF]">
              {card.cta}
              <HomeIcon name="arrow-right" size={13} />
            </a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
