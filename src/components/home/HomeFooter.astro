---
import type { HomeContent, Locale } from '../../data/homeContent';

interface Props {
  locale: Locale;
  footer: HomeContent['footer'];
}

const { locale, footer: c } = Astro.props;

const langs: Array<{ code: Locale; label: string; href: string }> = [
  { code: 'fr', label: 'FR', href: '/fr/' },
  { code: 'en', label: 'EN', href: '/en/' },
  { code: 'nl', label: 'NL', href: '/nl/' },
  { code: 'de', label: 'DE', href: '/de/' },
  { code: 'pt', label: 'PT', href: '/pt/' },
  { code: 'es', label: 'ES', href: '/es/' },
];
---

<footer class="st-foot">
  <div class="st-wrap">
    <div class="st-foot__grid">
      <div class="st-foot__brand">
        <img src="/strivn-logo-full-white-web.png" alt="STRIVN" width="1130" height="369" />
        <p class="st-foot__tag">{c.tagline}</p>
        <p class="st-small">{c.body}</p>
        <p class="st-num st-foot__mail">{c.email}</p>
      </div>
      <nav class="st-foot__cols" aria-label="Footer">
        {c.columns.map((col) => (
          <div>
            <p class="st-label">{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li><a href={link.href} hreflang={link.hreflang}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="st-foot__bottom">
      <span>{c.copyright}</span>
      <span class="st-foot__langs">
        {langs.map((l) => (
          <a href={l.href} aria-current={locale === l.code ? 'page' : undefined}>{l.label}</a>
        ))}
      </span>
    </div>
  </div>
</footer>
