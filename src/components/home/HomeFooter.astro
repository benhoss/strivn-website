---
import type { HomeContent, Locale } from '../../data/homeContent';

interface Props {
  locale: Locale;
  footer: HomeContent['footer'];
}

const { locale, footer: c } = Astro.props;

const langs: Array<{ code: Locale; label: string; href: string }> = [
  { code: 'fr', label: 'FR', href: '/fr/' },
  { code: 'en', label: 'EN', href: '/en/' },
  { code: 'nl', label: 'NL', href: '/nl/' },
  { code: 'de', label: 'DE', href: '/de/' },
  { code: 'pt', label: 'PT', href: '/pt/' },
  { code: 'es', label: 'ES', href: '/es/' },
];
---

<footer class="border-t border-[#FFFFFF0A] bg-[#060911]">
  <div class="hl-wrap grid gap-12 py-16 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,2fr)] lg:gap-20">
    <div>
      <p class="font-mono text-[1rem] font-bold tracking-[0.22em] text-[#F8FAFC]">STRIVN</p>
      <p class="mt-4 max-w-[24rem] text-[1rem] font-bold text-[#C6D2E8]">{c.tagline}</p>
      <p class="mt-3 max-w-[26rem] text-[0.9rem] leading-[1.6] text-[#8CA3C7]">{c.body}</p>
      <a href={`mailto:${c.email}`} class="mt-5 inline-block font-mono text-[0.82rem] text-[#7AB8FF] hover:underline">{c.email}</a>
    </div>

    <nav class="grid grid-cols-2 gap-10 sm:grid-cols-3" aria-label="Footer">
      {c.columns.map((col) => (
        <div>
          <p class="font-mono text-[0.6rem] tracking-[0.14em] text-[#68779A]">{col.title}</p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} hreflang={link.hreflang} class="text-[0.92rem] text-[#C6D2E8] transition-colors hover:text-[#F8FAFC]">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="border-t border-[#FFFFFF08]">
    <div class="hl-wrap flex flex-col items-start justify-between gap-4 py-6 sm:flex-row sm:items-center">
      <p class="text-[0.82rem] text-[#68779A]">{c.copyright}</p>
      <p class="flex items-center gap-3 font-mono text-[0.68rem] tracking-[0.08em]">
        {langs.map((l) => (
          <a
            href={l.href}
            aria-current={locale === l.code ? 'page' : undefined}
            class={locale === l.code ? 'font-bold text-[#F8FAFC]' : 'text-[#68779A] transition-colors hover:text-[#C6D2E8]'}
          >
            {l.label}
          </a>
        ))}
      </p>
    </div>
  </div>
</footer>
