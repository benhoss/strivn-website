---
import HomeWeek from './HomeWeek.astro';
import { LIVE_CLOCK, LIVE_SCORE, type HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['live'];
}

/**
 * The live runner as the coach holds it pitch-side: the running block with
 * its clock, the small-sided game's score, the block controls. It pilots the
 * session; load is computed after it ends, so no load is drawn here.
 */
const { c } = Astro.props;
/** Block 1 is done, block 2 is running, 3 and 4 are next. */
const blockState = ['done', 'now', 'next', 'next'] as const;
---

<HomeWeek id="live" stamp={c.stamp} links={c.links} labelledby="live-title">
  <div class="st-head">
    <h2 id="live-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-panel home-live">
    <div class="home-live__bar">
      <span class="st-live">{c.badge}</span>
      <span class="st-h4">{c.session}</span>
      <span class="st-label home-live__meta">{c.meta}</span>
    </div>
    <ol class="home-live__blocks">
      {c.blocks.map((b, i) => (
        <li class={`is-${blockState[i]}`} aria-current={blockState[i] === 'now' ? 'step' : undefined}>
          <span class="t">{b.t}</span>
          {b.label}
        </li>
      ))}
    </ol>
    <div class="home-live__stage">
      <div class="home-live__clock">
        <span class="st-label">{c.current}</span>
        <p class="home-live__time">
          {LIVE_CLOCK.elapsed}<small>/ {LIVE_CLOCK.planned}</small>
        </p>
        <span class="st-meter" aria-hidden="true"><i style={`width:${LIVE_CLOCK.pct}%`}></i></span>
      </div>
      <div class="home-live__score" role="group" aria-label={c.scoreAria}>
        {c.teams.map((t, i) => (
          <div class:list={['home-live__team', i === 1 && 'is-b']}>
            <span class="st-label">{t}</span>
            <b>{LIVE_SCORE[i]}</b>
            <span class="home-mini" aria-hidden="true">+1</span>
          </div>
        ))}
        <p class="st-label home-live__note">{c.teamsNote}</p>
      </div>
    </div>
    <div class="home-actions home-live__foot" aria-hidden="true">
      <span class="home-mini home-mini--primary">{c.actions[0]}</span>
      <span class="home-mini">{c.actions[1]}</span>
      <span class="home-mini">{c.actions[2]}</span>
    </div>
  </div>
</HomeWeek>

<style>
  .home-live__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .home-live__meta {
    margin-left: auto;
  }
  .home-live__blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-line);
  }
  .home-live__blocks li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 20px;
    font-size: 13.5px;
    color: var(--color-ink);
  }
  .home-live__blocks li + li {
    border-left: 1px solid var(--color-line);
  }
  .home-live__blocks .t {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ink-4);
  }
  .home-live__blocks .is-done {
    color: var(--color-ink-3);
  }
  .home-live__blocks .is-now {
    background: color-mix(in srgb, var(--color-electric) 7%, transparent);
    box-shadow: inset 0 -2px 0 var(--color-electric);
  }
  .home-live__blocks .is-now .t {
    color: var(--color-electric-500);
  }
  .home-live__blocks .is-next {
    color: var(--color-ink-4);
  }

  /* The running block: its clock is the largest thing on the screen, as in
     the runner, readable at arm's length. */
  .home-live__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
  }
  .home-live__clock {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px;
    border-right: 1px solid var(--color-line);
  }
  .home-live__time {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(44px, 6vw, 64px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .home-live__time small {
    margin-left: 10px;
    font-size: 0.34em;
    letter-spacing: 0;
    color: var(--color-ink-4);
  }
  .home-live__score {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-content: start;
    padding: 24px;
  }
  .home-live__team {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: 14px 16px;
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
  }
  /* Bibs: a filled and an open marker. Colour stays reserved for player
     states, so the two teams differ by shape, not hue. */
  .home-live__team .st-label::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 2px;
    background: var(--color-ink-2);
    vertical-align: 0;
  }
  .home-live__team.is-b .st-label::before {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-ink-2);
  }
  .home-live__team b {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .home-live__note {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-ink-4);
  }
  .home-live__foot {
    padding: 16px 24px;
  }
  @media (max-width: 820px) {
    .home-live__stage {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-live__clock {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .home-live__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-live__blocks li:nth-child(3) {
      border-left: 0;
    }
    .home-live__blocks li:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
  }
  @media (max-width: 560px) {
    .home-live__bar {
      padding-inline: 16px;
    }
    .home-live__meta {
      margin-left: 0;
    }
    .home-live__blocks li {
      padding: 14px 16px;
    }
    .home-live__clock,
    .home-live__score {
      padding: 20px 16px;
    }
    .home-live__foot {
      padding-inline: 16px;
    }
  }
</style>
