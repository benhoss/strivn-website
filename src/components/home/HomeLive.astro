---
import HomeWeek from './HomeWeek.astro';
import { FOCUS_PLAYER, LIVE_PLAN_MARK, LIVE_ROWS, type HomeContent } from '../../data/homeContent';

interface Props {
  c: HomeContent['live'];
  pct: string;
}

const { c, pct } = Astro.props;
/** Block 1 is done, block 2 is running, 3 and 4 are next. */
const blockState = ['done', 'now', 'next', 'next'] as const;
---

<HomeWeek id="live" stamp={c.stamp} links={c.links} labelledby="live-title">
  <div class="st-head">
    <h2 id="live-title" class="st-h2">{c.title}</h2>
    <p class="st-body">{c.body}</p>
  </div>

  <div class="st-panel home-live">
    <div class="home-live__bar">
      <span class="st-live">{c.badge}</span>
      <span class="st-h4">{c.session}</span>
      <span class="st-label home-live__meta">{c.meta}</span>
    </div>
    <ol class="home-live__blocks">
      {c.blocks.map((b, i) => (
        <li class={`is-${blockState[i]}`} aria-current={blockState[i] === 'now' ? 'step' : undefined}>
          <span class="t">{b.t}</span>
          {b.label}
        </li>
      ))}
    </ol>
    <ul class="home-live__rows" aria-label={c.rowsAria}>
      {LIVE_ROWS.map((r) => (
        <li>
          <span>{r.name}</span>
          <span class="track" aria-hidden="true">
            <i class:list={[r.over && 'is-over']} style={`width:${r.pct}%`}></i>
            <span class="plan" style={`left:${LIVE_PLAN_MARK}%`}></span>
          </span>
          <span class:list={['pct', r.over && 'is-over']}>{r.pct}{pct}</span>
        </li>
      ))}
    </ul>
    <div class="home-live__alert">
      <p><b>{FOCUS_PLAYER}</b>{c.alert}</p>
      <div class="home-actions" aria-hidden="true">
        <span class="home-mini home-mini--primary">{c.primary}</span>
        <span class="home-mini">{c.secondary}</span>
      </div>
    </div>
  </div>
</HomeWeek>

<style>
  .home-live__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-navy-900);
  }
  .home-live__meta {
    margin-left: auto;
  }
  .home-live__blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-line);
  }
  .home-live__blocks li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 20px;
    font-size: 13.5px;
    color: var(--color-ink);
  }
  .home-live__blocks li + li {
    border-left: 1px solid var(--color-line);
  }
  .home-live__blocks .t {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ink-4);
  }
  .home-live__blocks .is-done {
    color: var(--color-ink-3);
  }
  .home-live__blocks .is-now {
    background: color-mix(in srgb, var(--color-electric) 7%, transparent);
    box-shadow: inset 0 -2px 0 var(--color-electric);
  }
  .home-live__blocks .is-now .t {
    color: var(--color-electric-500);
  }
  .home-live__blocks .is-next {
    color: var(--color-ink-4);
  }
  .home-live__rows {
    list-style: none;
    margin: 0;
    padding: 12px 24px 4px;
    display: grid;
  }
  .home-live__rows li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 52px;
    gap: 16px;
    align-items: center;
    padding: 10px 0;
    font-size: 14px;
    color: var(--color-ink);
  }
  .home-live__rows .pct {
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-2);
  }
  .home-live__rows .pct.is-over {
    color: var(--color-risk);
  }
  .track {
    position: relative;
    height: 10px;
    background: var(--color-navy-800);
    border-radius: 3px;
  }
  .track i {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 3px;
    background: var(--color-electric);
  }
  .track i.is-over {
    background: var(--color-risk);
  }
  .track .plan {
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 1px;
    background: var(--color-navy-200);
  }
  .home-live__alert {
    margin: 12px 24px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--color-risk) 35%, transparent);
    background: color-mix(in srgb, var(--color-risk) 6%, transparent);
    border-radius: 8px;
  }
  .home-live__alert p {
    margin: 0;
    flex: 1 1 280px;
    font-size: 14.5px;
    color: var(--color-ink);
  }
  .home-live__alert b {
    font-weight: 600;
  }
  .home-live__alert .home-actions {
    margin-left: auto;
  }
  @media (max-width: 820px) {
    .home-live__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-live__blocks li:nth-child(3) {
      border-left: 0;
    }
    .home-live__blocks li:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
  }
  @media (max-width: 560px) {
    .home-live__bar {
      padding-inline: 16px;
    }
    .home-live__meta {
      margin-left: 0;
    }
    .home-live__blocks li {
      padding: 14px 16px;
    }
    .home-live__rows {
      padding-inline: 16px;
    }
    .home-live__rows li {
      grid-template-columns: 90px minmax(0, 1fr) 44px;
      gap: 10px;
    }
    .home-live__alert {
      margin-inline: 16px;
    }
    .home-live__alert .home-actions {
      margin-left: 0;
    }
  }
</style>
