---
import '../styles/blog.css';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../data/landingContent';
import { landingContent } from '../data/landingContent';
import { blogAlternates, blogSwitchHrefs } from '../lib/blog';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  /** JSON-LD extra nodes (BlogPosting, BreadcrumbList). */
  jsonLdExtra?: Record<string, unknown>[];
  /** Public body class to apply on <main>. */
  bodyClass?: string;
  /**
   * Override the language-switcher targets. Defaults to this page for its own
   * locale and each other locale's homepage — the blog is French-only, so a
   * translated blog URL would 404.
   */
  switchHrefs?: { en: string; fr: string; nl?: string; de?: string; pt?: string; es?: string };
  /** Override the hreflang set. Defaults to this page only (no translations exist). */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Open Graph image for the post (defaults to the site card in BaseLayout). */
  ogImage?: string;
  /** Alt text describing the Open Graph image. */
  ogImageAlt?: string;
  /** Brand href override (locale root). */
  brandHref?: string;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  jsonLdExtra = [],
  bodyClass,
  switchHrefs,
  alternates,
  ogImage,
  ogImageAlt,
  brandHref,
} = Astro.props;

const c = landingContent[locale];
const isFrench = locale === 'fr';
const skipLabel = isFrench ? 'Aller au contenu' : 'Skip to content';
const homeHref = `/${locale}/`;
// The blog is published in French only — every locale's nav points at it,
// same as the "Blog" entry in every locale's footer.
const blogHref = '/fr/blog/';

// Augment nav with a Blog link (kept lightweight — does not modify landingContent).
const navLinks = [
  ...c.nav.links,
  { label: 'Blog', href: blogHref },
];
const finalSwitchHrefs = switchHrefs ?? blogSwitchHrefs(locale, canonicalPath);
const finalAlternates = alternates ?? blogAlternates(locale, canonicalPath);
---

<BaseLayout
  lang={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  alternates={finalAlternates}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  jsonLdExtra={jsonLdExtra}
>
  <a href="#b-main" class="s-skip">{skipLabel}</a>

  <SiteHeader
    locale={locale}
    links={navLinks}
    cta={c.nav.cta}
    brandHref={brandHref ?? homeHref}
    switchHrefs={finalSwitchHrefs}
  />

  <main id="b-main" class={bodyClass}>
    <slot />
  </main>

  <SiteFooter locale={locale} footer={c.footer} />
</BaseLayout>
