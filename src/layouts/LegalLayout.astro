---
/* Legal and support shell (v2): one narrow reading column, the st-h1 title,
   the update date in mono, and the prose styles the blog uses (blog.css). */
import BaseLayout from './BaseLayout.astro';
import '../styles/blog.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { landingContent, type Locale } from '../data/landingContent';
import { NAV } from '../data/nav';
import { SKIP_LABEL } from '../lib/skipLabel';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Display heading (defaults to title) */
  heading?: string;
  /** Localized "last updated" line, already formatted */
  updated?: string;
  /** Short mono label above the heading (e.g. the app the page covers). */
  eyebrow?: string;
}

const { title, description, lang = 'en', canonicalPath, alternates = [], heading, updated, eyebrow } =
  Astro.props;

/* `lang` is a free string on these pages; narrow it before indexing content. */
const locale: Locale = lang in landingContent ? (lang as Locale) : 'en';
const c = landingContent[locale];

/* The language switcher lands on this same document in the chosen language.
   Every legal page already declares that mapping as hreflang alternates. */
const switchHrefs: Partial<Record<Locale, string>> = Object.fromEntries(
  alternates
    .filter((a) => a.hreflang in landingContent)
    .map((a) => [a.hreflang, a.href.endsWith('/') ? a.href : `${a.href}/`])
);
---
<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  alternates={alternates}
>
  <a href="#s-main" class="s-skip">{SKIP_LABEL[locale]}</a>

  <SiteHeader locale={locale} links={NAV[locale].links} cta={NAV[locale].cta} switchHrefs={switchHrefs} />

  <main id="s-main" class="b-main">
    <article class="st-narrow b-doc">
      <header class="b-doc__head">
        {eyebrow && <p class="st-label st-eyebrow">{eyebrow}</p>}
        <h1 class="st-h1 b-doc__title">{heading ?? title}</h1>
        {updated && <p class="b-doc__updated">{updated}</p>}
      </header>
      <div class="b-prose">
        <slot />
      </div>
    </article>
  </main>

  <SiteFooter locale={locale} footer={c.footer} />
</BaseLayout>
