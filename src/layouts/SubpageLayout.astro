---
/* Sub-page shell (v2): shared header, main, shared footer. The header is
   sticky in the normal flow, so pages need no top padding for it, and
   nothing is hidden waiting for a scroll observer. */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { landingContent, type Locale } from '../data/landingContent';
import { NAV } from '../data/nav';
import { SKIP_LABEL } from '../lib/skipLabel';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Extra JSON-LD nodes forwarded to BaseLayout (FAQPage, BreadcrumbList…) */
  jsonLdExtra?: Record<string, unknown>[];
  /** Counterpart paths for the language switcher (defaults to the homepages). */
  switchHrefs?: { en: string; fr: string; nl?: string; de?: string; pt?: string; es?: string };
  /** Open Graph image path, when the page has its own. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternates = [],
  jsonLdExtra = [],
  switchHrefs,
  ogImage,
  ogImageAlt,
} = Astro.props;

const c = landingContent[locale];
const skipLabel = SKIP_LABEL[locale];
---

<BaseLayout
  lang={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLdExtra={jsonLdExtra}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <a href="#s-main" class="s-skip">{skipLabel}</a>

  <SiteHeader locale={locale} links={NAV[locale].links} cta={NAV[locale].cta} switchHrefs={switchHrefs} />

  <main id="s-main">
    <slot />
  </main>

  <SiteFooter locale={locale} footer={c.footer} />
</BaseLayout>
