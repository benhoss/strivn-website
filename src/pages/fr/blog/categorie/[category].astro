---
import BlogLayout from '../../../../layouts/BlogLayout.astro';
import BlogCard from '../../../../components/BlogCard.astro';
import {
  BLOG_CATEGORIES,
  BLOG_CATEGORY_DESCRIPTIONS,
  BLOG_CATEGORY_LABELS,
} from '../../../../lib/blog';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return BLOG_CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = category as (typeof BLOG_CATEGORIES)[number];
const label = BLOG_CATEGORY_LABELS[cat];
const desc = BLOG_CATEGORY_DESCRIPTIONS[cat];

const published = await getCollection('blog', ({ data }) => !data.draft);
const counts: Record<string, number> = Object.fromEntries(BLOG_CATEGORIES.map((c) => [c, 0]));
for (const entry of published) counts[entry.data.category] = (counts[entry.data.category] ?? 0) + 1;

const all = published
  .filter((e) => e.data.category === cat)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = `${label} — articles pour coachs foot amateur | strivn blog`;
const description = `${desc} Conseils concrets, vocabulaire terrain, sources autoritatives. Pour coachs de foot amateur et semi-pro.`;
const canonicalPath = `/fr/blog/categorie/${cat}/`;

const jsonLdExtra = [
  {
    '@type': 'CollectionPage',
    '@id': `https://strivn.net${canonicalPath}#collection`,
    name: `${label} — strivn blog`,
    description,
    url: `https://strivn.net${canonicalPath}`,
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://strivn.net/fr/blog/#blog' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://strivn.net/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://strivn.net/fr/blog/' },
      { '@type': 'ListItem', position: 3, name: label, item: `https://strivn.net${canonicalPath}` },
    ],
  },
];
---

<BlogLayout
  locale="fr"
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLdExtra={jsonLdExtra}
  switchHrefs={{ fr: canonicalPath }}
>
  <div class="st-wrap b-index">
    <header class="b-index__head">
      <nav class="st-crumbs" aria-label="Fil d’Ariane">
        <a href="/fr/">Accueil</a>
        <a href="/fr/blog/">Blog</a>
        <span aria-current="page">{label}</span>
      </nav>
      <h1 class="st-h1">{label}</h1>
      <p class="st-lede">{desc}</p>
    </header>

    <nav class="b-filter" aria-label="Filtrer par catégorie">
      <a class="b-filter__tag" href="/fr/blog/">
        Tous <span class="b-filter__n">{published.length}</span>
      </a>
      {BLOG_CATEGORIES.map((c) => (
        <a
          class="b-filter__tag"
          href={`/fr/blog/categorie/${c}/`}
          aria-current={c === cat ? 'page' : undefined}
        >
          {BLOG_CATEGORY_LABELS[c]} <span class="b-filter__n">{counts[c]}</span>
        </a>
      ))}
    </nav>

    {all.length === 0 ? (
      <p class="b-empty">Aucun article dans cette catégorie pour l’instant.</p>
    ) : (
      <ul class="b-list">
        {all.map((entry) => <BlogCard entry={entry} />)}
      </ul>
    )}
  </div>
</BlogLayout>
