---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import {
  BLOG_CATEGORY_LABELS,
  BLOG_CATEGORY_DESCRIPTIONS,
  BLOG_CATEGORIES,
} from '../../../lib/blog';
import { getCollection } from 'astro:content';

const title = 'Blog coach foot amateur — prépa physique, séances, charge | strivn';
const description =
  'Articles terrain pour coachs de foot amateur : prépa physique, gestion d\'équipe, séances, blessures, charge. Concrets, chiffrés, sans jargon.';

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Count per category.
const counts: Record<string, number> = Object.fromEntries(BLOG_CATEGORIES.map((c) => [c, 0]));
for (const entry of all) counts[entry.data.category] = (counts[entry.data.category] ?? 0) + 1;

const canonicalPath = '/fr/blog/';

const jsonLdExtra = [
  {
    '@type': 'Blog',
    '@id': 'https://strivn.net/fr/blog/#blog',
    name: 'Blog strivn — prépa physique et gestion d\'équipe foot amateur',
    description,
    url: 'https://strivn.net/fr/blog/',
    inLanguage: 'fr',
    publisher: { '@id': 'https://strivn.net/#organization' },
  },
];
---

<BlogLayout
  locale="fr"
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLdExtra={jsonLdExtra}
  switchHrefs={{ fr: '/fr/blog/' }}
>
  <div class="st-wrap b-index">
    <header class="b-index__head">
      <p class="st-label st-eyebrow">Blog · {all.length} articles</p>
      <h1 class="st-h1">Dosez la charge, construisez la séance, suivez le groupe.</h1>
      <p class="st-lede">
        Des articles pour les coachs de foot amateur et semi-pro : prépa physique, séances,
        charge, blessures et gestion d’équipe. Chaque article donne une méthode, des seuils
        chiffrés et ses sources.
      </p>
    </header>

    <nav class="b-filter" aria-label="Filtrer par catégorie">
      <a class="b-filter__tag" href="/fr/blog/" aria-current="page">
        Tous <span class="b-filter__n">{all.length}</span>
      </a>
      {BLOG_CATEGORIES.map((c) => (
        <a class="b-filter__tag" href={`/fr/blog/categorie/${c}/`} title={BLOG_CATEGORY_DESCRIPTIONS[c]}>
          {BLOG_CATEGORY_LABELS[c]} <span class="b-filter__n">{counts[c]}</span>
        </a>
      ))}
    </nav>

    {all.length === 0 ? (
      <p class="b-empty">Aucun article publié pour l’instant.</p>
    ) : (
      <ul class="b-list">
        {all.map((entry) => <BlogCard entry={entry} />)}
      </ul>
    )}
  </div>
</BlogLayout>
