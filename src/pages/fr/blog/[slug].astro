---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import {
  BLOG_CATEGORY_LABELS,
  buildTocFromHeadings,
  findRelated,
  formatDateFr,
  frenchSpacing,
  frenchSpacingHtml,
  slugFromEntry,
} from '../../../lib/blog';
import { getCollection, render } from 'astro:content';
import { appStartUrl } from '../../../lib/appUrl';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: slugFromEntry(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = slugFromEntry(entry);
const { Content, headings } = await render(entry);

/* Wide Markdown tables scroll inside their own box on a phone instead of
   widening the page: wrap each <table> of the rendered HTML once. */
const renderedHtml = entry.rendered?.html;
const proseHtml = renderedHtml
  ? frenchSpacingHtml(renderedHtml).replace(/<table>/g, '<div class="b-table"><table>').replace(/<\/table>/g, '</table></div>')
  : undefined;

const { data } = entry;
const toc = buildTocFromHeadings(headings).filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

const canonicalPath = `/fr/blog/${slug}/`;
const categoryHref = `/fr/blog/categorie/${data.category}/`;

const all = await getCollection('blog', ({ data }) => !data.draft);
const related = findRelated(all, entry, 3);

const site = Astro.site ?? new URL('https://strivn.net');
const ogImageUrl = new URL(`/og-blog-${slug}.png`, site).toString();

const jsonLdExtra = [
  {
    '@type': 'BlogPosting',
    '@id': `https://strivn.net/fr/blog/${slug}/#article`,
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
    inLanguage: 'fr',
    keywords: data.keywords.join(', '),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://strivn.net/fr/blog/${slug}/`,
    },
    author: {
      '@type': 'Person',
      name: data.author,
    },
    publisher: {
      '@id': 'https://strivn.net/#organization',
    },
    image: ogImageUrl,
    articleSection: BLOG_CATEGORY_LABELS[data.category],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://strivn.net/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://strivn.net/fr/blog/' },
      { '@type': 'ListItem', position: 3, name: BLOG_CATEGORY_LABELS[data.category], item: `https://strivn.net/fr/blog/categorie/${data.category}/` },
      { '@type': 'ListItem', position: 4, name: data.title, item: `https://strivn.net/fr/blog/${slug}/` },
    ],
  },
];

const showUpdated =
  data.updatedDate && data.updatedDate.toDateString() !== data.pubDate.toDateString();
---

<BlogLayout
  locale="fr"
  title={`${data.title} | strivn blog`}
  description={data.description}
  canonicalPath={canonicalPath}
  jsonLdExtra={jsonLdExtra}
  ogImage={`/og-blog-${slug}.png`}
  ogImageAlt={data.title}
  switchHrefs={{ fr: `/fr/blog/${slug}/` }}
>
  <article class="st-narrow b-article">
    <header class="b-article__head">
      <nav class="st-crumbs" aria-label="Fil d’Ariane">
        <a href="/fr/">Accueil</a>
        <a href="/fr/blog/">Blog</a>
      </nav>

      <p class="b-article__meta">
        <a href={categoryHref} class="b-article__cat">{BLOG_CATEGORY_LABELS[data.category]}</a>
        <time datetime={data.pubDate.toISOString()}>{formatDateFr(data.pubDate)}</time>
        <span>{data.readingTime} min de lecture</span>
        <span>Par {data.author}</span>
        {showUpdated && data.updatedDate && (
          <span>Mis à jour le {formatDateFr(data.updatedDate)}</span>
        )}
      </p>

      <h1 class="st-h1 b-article__title">{frenchSpacing(data.title)}</h1>
      <p class="st-lede b-article__lede">{frenchSpacing(data.description)}</p>
    </header>

    {showToc && (
      <nav class="b-toc" aria-label="Sommaire de l’article">
        <p class="st-label">Sommaire</p>
        <ol class="b-toc__list">
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    {proseHtml ? (
      <div class="b-prose" set:html={proseHtml} />
    ) : (
      <div class="b-prose"><Content /></div>
    )}

    <aside class="b-cta" aria-label="Mise en pratique">
      <p class="b-cta__title">Rassemblez convocations, présences, charge et séances sur une page.</p>
      <p class="b-cta__text">
        Le staff lit la même semaine, au même endroit. Chaque compte démarre sur 30 jours
        de Semi-Pro, sans carte.
      </p>
      <div class="st-ctas">
        <a href={appStartUrl('fr')} target="_blank" rel="noopener" class="st-btn st-btn--primary">
          Commencer gratuitement
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>

    {related.length > 0 && (
      <section class="b-related" aria-labelledby="b-related-title">
        <h2 id="b-related-title" class="st-label">Sur le même sujet</h2>
        <ul class="b-list">
          {related.map((r) => <BlogCard entry={r} compact level={3} />)}
        </ul>
      </section>
    )}
  </article>
</BlogLayout>
